#!/bin/sh
# tt.app runs tt through this launcher: Ghostty starts every command under
# login(1), which always exits 0, so the app learns how tt ended from the
# status this writes. Usage: tt-launch STATUS_FILE TT [ARG...]
status_file=$1
shift
"$@"
status=$?
printf '%s\n' "$status" > "$status_file"
exit "$status"
