#!/bin/sh
# Docket.app runs docket through this launcher: Ghostty starts every command under
# login(1), which always exits 0, so the app learns how docket ended from the
# status this writes. Usage: docket-launch STATUS_FILE DOCKET [ARG...]
status_file=$1
shift
"$@"
status=$?
printf '%s\n' "$status" > "$status_file"
exit "$status"
