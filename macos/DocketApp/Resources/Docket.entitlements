<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Cmd+K in quick capture asks the browser, Mail or Finder in front what it
	     shows; the hardened runtime refuses Apple Events without this. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Shared with the widget, which reads the agenda Docket.app writes there. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>MH33GYKDAW.io.github.sglavoie.docket</string>
	</array>
</dict>
</plist>
