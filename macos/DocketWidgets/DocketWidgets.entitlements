<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WidgetKit requires the sandbox. The widget runs nothing: it reads the
	     snapshot Docket.app writes to the App Group container. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>MH33GYKDAW.io.github.sglavoie.docket</string>
	</array>
</dict>
</plist>
