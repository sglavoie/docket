{
  "name": "filter-tag-rename-lens-report",
  "fixture": "rich",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "save a lens naming the tag in full", "key": "/" },
    { "type": "text", "text": "#" },
    { "type": "key", "key": "down" },
    { "type": "key", "key": "tab" },
    { "type": "assert", "assert": "contains", "value": "Search: > #security" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "Q" },
    { "type": "key", "key": "s" },
    { "type": "text", "text": "Security Sweep" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Lens: Security Sweep" },

    { "type": "key", "label": "leave the lens and the query it was saved from", "key": "Q" },
    { "type": "key", "key": "1" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Build login form" },

    { "type": "key", "label": "save a second lens naming the tag by prefix", "key": "/" },
    { "type": "text", "text": "#sec" },
    { "type": "key", "label": "close the suggestions, keeping the query", "key": "esc" },
    { "type": "text", "text": "*" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "Q" },
    { "type": "key", "key": "s" },
    { "type": "text", "text": "Security Family" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Lens: Security Family" },
    { "type": "key", "key": "Q" },
    { "type": "key", "key": "1" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Build login form" },

    { "type": "key", "label": "rename the tag both lenses name", "key": "f" },
    { "type": "key", "key": "#" },
    { "type": "key", "key": "down" },
    { "type": "key", "key": "e" },
    { "type": "key", "key": "ctrl+u" },
    { "type": "text", "text": "platform-api" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "#security → #platform-api" },
    { "type": "assert", "label": "both predicates are reported, and neither is rewritten", "assert": "contains", "value": "2 saved lenses may select differently, and they are left unchanged:" },
    { "type": "assert", "label": "a full name is answerable", "assert": "contains", "value": "Security Sweep · #security" },
    { "type": "assert", "label": "and so is a prefix", "assert": "contains", "value": "Security Family · #sec*" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the report repeats what the confirmation promised", "key": "y" },
    { "type": "assert", "assert": "contains", "value": "Rename Tag · done" },
    { "type": "assert", "assert": "contains", "value": "2 saved lenses may select differently, and they are left unchanged:" },
    { "type": "assert", "assert": "contains", "value": "Security Sweep · #security" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },

    { "type": "key", "label": "the saved query is a durable string the rename did not touch", "key": "\\" },
    { "type": "key", "key": "/" },
    { "type": "text", "text": "Security Sweep" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "1" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Lens: Security Sweep" },
    { "type": "assert", "label": "so it now selects nothing", "assert": "contains", "value": "No tasks match this lens." },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
