{
  "name": "filter-tag-merge-undo",
  "fixture": "rich",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "open the tag facet", "key": "f" },
    { "type": "key", "key": "#" },
    { "type": "assert", "assert": "contains", "value": "Filter by Tags" },

    { "type": "key", "label": "pend two values before renaming anything", "key": "down" },
    { "type": "key", "key": "space" },
    { "type": "key", "key": "down" },
    { "type": "key", "key": "space" },
    { "type": "assert", "assert": "contains", "value": "[x] security" },
    { "type": "assert", "assert": "contains", "value": "[x] urgent" },

    { "type": "key", "label": "put the cursor back on the value to merge", "key": "up" },
    { "type": "key", "key": "e" },
    { "type": "assert", "assert": "contains", "value": "Rename Tag" },
    { "type": "key", "label": "retype the name, which is what a merge is", "key": "ctrl+u" },
    { "type": "text", "text": "backend" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Merge Tags" },
    { "type": "assert", "assert": "contains", "value": "#security → #backend" },
    { "type": "assert", "label": "the merge is named rather than implied", "assert": "contains", "value": "#backend is already in use, so the two become one." },
    { "type": "assert", "assert": "contains", "value": "1 task in 1 project" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "walk the confirmation back", "key": "n" },
    { "type": "assert", "label": "declining returns to the name, not out of the workflow", "assert": "contains", "value": "Rename Tag" },
    { "type": "assert", "assert": "not_contains", "value": "so the two become one" },

    { "type": "key", "label": "review it again and accept", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "#security → #backend" },
    { "type": "key", "key": "y" },
    { "type": "assert", "assert": "contains", "value": "Merge Tags · done" },
    { "type": "assert", "assert": "contains", "value": "1 task rewritten in 1 project" },
    { "type": "assert", "assert": "status_contains", "value": "Merge Tags: security → backend" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "dismiss the report onto the rebuilt list", "key": "esc" },
    { "type": "assert", "label": "the merged source is gone from the vocabulary", "assert": "not_contains", "value": "] security" },
    { "type": "assert", "label": "the pending source moved onto the destination", "assert": "contains", "value": "[x] backend" },
    { "type": "assert", "label": "and an unrelated pending value survived", "assert": "contains", "value": "[x] urgent" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "abandoning the picker abandons the filter, not the rename", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "label": "the row carries no chip at any width, so the rewrite is read where tags live", "assert": "not_contains", "value": "#backend" },
    { "type": "key", "key": "/" },
    { "type": "text", "text": "Add password validation" },
    { "type": "key", "key": "enter" },
    { "type": "key", "label": "the search keeps the ancestry, so the deepest row is the result", "key": "end" },
    { "type": "key", "key": "b" },
    { "type": "assert", "label": "the one rewritten task wears the destination alone", "assert": "contains", "value": "Tags: #backend" },
    { "type": "assert", "assert": "not_contains", "value": "#security" },
    { "type": "key", "label": "close Peek", "key": "b" },

    { "type": "key", "label": "one ledger entry takes the whole merge back", "key": "u" },
    { "type": "wait" },
    { "type": "key", "key": "end" },
    { "type": "key", "key": "b" },
    { "type": "assert", "assert": "contains", "value": "#security" },
    { "type": "key", "label": "close Peek", "key": "b" },
    { "type": "key", "label": "leave the search", "key": "esc" },
    { "type": "key", "key": "f" },
    { "type": "key", "key": "#" },
    { "type": "assert", "assert": "contains", "value": "[ ] security" },
    { "type": "assert", "assert": "contains", "value": "[ ] backend" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
