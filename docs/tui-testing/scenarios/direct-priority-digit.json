{
  "name": "direct-priority-digit",
  "fixture": "rich",
  "size": "99x35",
  "actions": [
    { "type": "key", "key": "j" },
    { "type": "key", "label": "move the cursor onto the In Progress task", "key": "j" },

    { "type": "key", "label": "hold the priority prefix", "key": "p" },
    { "type": "assert", "assert": "contains", "value": "0 clear" },
    { "type": "assert", "assert": "contains", "value": "1 critical" },
    { "type": "assert", "assert": "contains", "value": "5 lowest" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "make the cursored task critical", "key": "1" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "status_contains", "value": "Set Priority" },
    { "type": "assert", "assert": "contains", "value": "▶ ◉ Build login form" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "drop it to the default priority", "key": "p" },
    { "type": "key", "key": "3" },
    { "type": "wait" },
    { "type": "assert", "label": "an explicit P3 reloads without a high-priority badge", "assert": "not_contains", "value": "▶ ◉ Build login form" },
    { "type": "assert", "assert": "contains", "value": "Build login form" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "clear the priority", "key": "p" },
    { "type": "key", "key": "0" },
    { "type": "wait" },
    { "type": "assert", "label": "an unset priority borrows no badge", "assert": "not_contains", "value": "▶ ◉ Build login form" },
    { "type": "assert", "assert": "contains", "value": "Build login form" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },

    { "type": "key", "label": "select the In Progress task and enter multi-select", "key": "v" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "label": "move to an Inbox task", "key": "j" },
    { "type": "key", "label": "select the Inbox task", "key": "v" },
    { "type": "assert", "assert": "contains", "value": "MULTI-SELECT: 2 selected" },

    { "type": "key", "label": "prioritize the whole selection", "key": "p" },
    { "type": "key", "key": "1" },
    { "type": "wait" },
    { "type": "assert", "assert": "status_contains", "value": "Set priority on 2 task(s)" },
    { "type": "assert", "assert": "contains", "value": "▶ ◉ Build login form" },
    { "type": "assert", "assert": "contains", "value": "□ ◉ Triage support inbox" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
