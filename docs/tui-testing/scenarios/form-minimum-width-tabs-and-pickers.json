{
  "name": "form-minimum-width-tabs-and-pickers",
  "fixture": "fresh",
  "size": "60x20",
  "actions": [
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "key", "label": "capture into Unfiled", "key": "a" },
    { "type": "assert", "assert": "view", "value": "TaskComposer" },
    { "type": "text", "text": "Wire the narrow form" },
    { "type": "key", "label": "expand into the full task form at the app's own floor", "key": "ctrl+f" },
    { "type": "assert", "label": "the form resizes from the available width rather than refusing it", "assert": "not_contains", "value": "Terminal too small" },
    { "type": "assert", "assert": "contains", "value": "Task Composer · Expanded" },
    { "type": "assert", "label": "the commit route stays spelled at the floor", "assert": "not_clipped", "value": "Ctrl+S save" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "key": "tab" },
    { "type": "key", "label": "onto the Priority row", "key": "tab" },
    { "type": "assert", "assert": "not_clipped", "value": "Priority:" },
    { "type": "assert", "label": "an unset priority is the placeholder every empty row shows", "assert": "not_contains", "value": "Unset" },
    { "type": "key", "label": "open the nested priority picker", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Set Priority" },
    { "type": "assert", "label": "the picker spells the unset row the same way, with no icon column left blank", "assert": "contains", "value": "● (none) [0]" },
    { "type": "assert", "label": "every priority is reachable in the narrow overlay", "assert": "contains", "value": "High" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },
    { "type": "assert", "assert": "contains", "value": "Task Composer · Expanded" },

    { "type": "key", "label": "onto the Parent row", "key": "tab" },
    { "type": "assert", "assert": "not_clipped", "value": "Parent:" },
    { "type": "key", "label": "the parent selector is a surface of its own, and it too has to fit", "key": "enter" },
    { "type": "assert", "assert": "view", "value": "ParentSelector" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },
    { "type": "assert", "assert": "contains", "value": "Task Composer · Expanded" },
    { "type": "key", "key": "tab" },
    { "type": "assert", "assert": "not_clipped", "value": "Status:" },
    { "type": "assert", "label": "the status row spells its value as Peek and the capture route do", "assert": "not_clipped", "value": "Inbox" },
    { "type": "key", "label": "open the nested state picker", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Set State" },
    { "type": "assert", "label": "the narrow overlay still lists every lifecycle state", "assert": "contains", "value": "someday" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },

    { "type": "key", "key": "tab" },
    { "type": "assert", "assert": "not_clipped", "value": "Flags:" },
    { "type": "key", "label": "open the nested flags picker", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Set Flags" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },

    { "type": "key", "label": "onto the Tags row", "key": "tab" },
    { "type": "assert", "assert": "not_clipped", "value": "Tags:" },
    { "type": "key", "label": "the tag selector is the other surface the form hands off to", "key": "enter" },
    { "type": "assert", "assert": "view", "value": "TagSelector" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },
    { "type": "assert", "assert": "contains", "value": "Task Composer · Expanded" },
    { "type": "key", "label": "onto the Context row, the last Basics field", "key": "tab" },
    { "type": "assert", "label": "the windowed body reaches the last field at the floor", "assert": "not_clipped", "value": "Context:" },
    { "type": "text", "text": "client-acme" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "forward onto the Schedule tab", "key": "shift+right" },
    { "type": "assert", "assert": "not_clipped", "value": "Due:" },
    { "type": "assert", "assert": "not_clipped", "value": "Next check-in:" },
    { "type": "assert", "assert": "not_clipped", "value": "Repeat:" },
    { "type": "key", "label": "open the nested due-date picker from the Due row", "key": "ctrl+d" },
    { "type": "assert", "assert": "contains", "value": "Set Due Date" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },

    { "type": "key", "key": "tab" },
    { "type": "key", "label": "open the shared check-in editor", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Set Check-In" },
    { "type": "assert", "label": "both fields of the schedule survive the narrow frame", "assert": "contains", "value": "Next check-in:" },
    { "type": "assert", "assert": "contains", "value": "Repeat:" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },

    { "type": "key", "label": "forward onto the Children tab", "key": "shift+right" },
    { "type": "assert", "assert": "not_clipped", "value": "Subtasks (0)" },
    { "type": "assert", "assert": "not_clipped", "value": "Checklist (0)" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "add a checklist item through its nested editor", "key": "ctrl+a" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "text", "text": "Measure the narrow body" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "not_clipped", "value": "Checklist (1)" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "widen past the preferred body width", "width": 100, "height": 40 },
    { "type": "assert", "assert": "contains", "value": "Checklist (1)" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "and back to the floor", "width": 60, "height": 20 },
    { "type": "assert", "assert": "not_clipped", "value": "Checklist (1)" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "explicit discard must ask first", "key": "ctrl+x" },
    { "type": "assert", "assert": "contains", "value": "Discard" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "keep editing instead", "key": "n" },
    { "type": "assert", "assert": "contains", "value": "Task Composer · Expanded" },
    { "type": "assert", "assert": "not_clipped", "value": "Checklist (1)" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "commit everything the narrow form collected", "key": "ctrl+s" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "status_contains", "value": "Wire the narrow form" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
