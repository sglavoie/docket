{
  "name": "combined-promote-deadline-step-move",
  "fixture": "multi-project",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "l opens Backlog, which launch folds", "key": "l" },
    { "type": "key", "label": "j twice steps past the lane and project headers onto the first task", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },

    { "type": "key", "label": "c answers from the owner row, since an empty checklist has no item row", "key": "c" },
    { "type": "assert", "assert": "contains", "value": "Add Checklist Item" },
    { "type": "text", "text": "Confirm the cutover window" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "label": "a new item is unticked, which is the shape S converts", "assert": "contains", "value": "[ ] Confirm the cutover window" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "S promotes the item the append revealed", "key": "S" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "label": "the item is consumed", "assert": "not_contains", "value": "[ ] Confirm the cutover window" },
    { "type": "assert", "label": "the committed child is revealed under its owner", "assert": "contains", "value": "Confirm the cutover window" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the reveal left the cursor on the child, so e edits it in place", "key": "e" },
    { "type": "assert", "assert": "contains", "value": "EDIT TASK" },
    { "type": "assert", "assert": "contains", "value": "Confirm the cutover window" },
    { "type": "text", "label": "a wall clock is the one thing the due presets cannot express, and tomorrow is a step above the unset stop", "text": " @tomorrow 14:30" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "label": "the sigil left the title and became the deadline", "assert": "contains", "value": "14:30" },
    { "type": "assert", "assert": "not_contains", "value": "@tomorrow" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "one day earlier, which is today, and the clock rides along", "key": "-" },
    { "type": "wait" },
    { "type": "assert", "assert": "status_contains", "value": "Step Due Date: Due " },
    { "type": "assert", "assert": "contains", "value": "14:30" },
    { "type": "key", "label": "landing on today took the row to the planning lane, so the cursor kept sweeping Backlog", "key": "home" },
    { "type": "key", "label": "past the Today lane's header onto its project", "key": "j" },
    { "type": "key", "label": "back onto the row the step moved", "key": "j" },
    { "type": "key", "label": "no deadline at all is the stop below today", "key": "-" },
    { "type": "wait" },
    { "type": "assert", "assert": "status_contains", "value": "Step Due Date: Due date cleared" },
    { "type": "assert", "label": "an unset deadline has no clock to draw", "assert": "not_contains", "value": "14:30" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "forward off that stop is today, with the clock the clear remembered", "key": "+" },
    { "type": "wait" },
    { "type": "assert", "assert": "status_contains", "value": "Step Due Date: Due " },
    { "type": "assert", "label": "the remembered time comes back rather than midnight", "assert": "contains", "value": "⊡ Today 14:30" },
    { "type": "assert", "label": "landing on today is a planning move, so the row leaves Backlog", "assert": "contains", "value": "@ Today  (1)" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "a further step moves the deadline off today and leaves the membership it wrote", "key": "+" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "⊡ Tomorrow 14:30" },
    { "type": "assert", "label": "Today is a planning collection, not a reading of the due date", "assert": "contains", "value": "@ Today  (1)" },
    { "type": "assert", "label": "and the promotion's parent link is still what holds the child", "assert": "contains", "value": "›1" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "each press is its own entry, so one u is one day", "key": "u" },
    { "type": "assert", "assert": "status_contains", "value": "Undid: Step Due Date" },
    { "type": "wait" },
    { "type": "assert", "assert": "not_contains", "value": "⊡ Tomorrow 14:30" },
    { "type": "assert", "label": "one entry back is the today stop, clock included", "assert": "contains", "value": "⊡ Today 14:30" },
    { "type": "key", "key": "ctrl+r" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "⊡ Tomorrow 14:30" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "% moves the promoted child out of the project it was minted in", "key": "%" },
    { "type": "assert", "assert": "contains", "value": "Move to Project: Confirm the cutover window" },
    { "type": "assert", "label": "its own project is not a destination", "assert": "not_contains", "value": "Client Alpha  [client-alpha]" },
    { "type": "key", "label": "choose the first destination, Client Beta", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "status_contains", "value": "Move to Project: #2 Confirm the cutover window → client-beta" },
    { "type": "assert", "label": "children are project-local, so leaving the project leaves the parent", "assert": "not_contains", "value": "›1" },
    { "type": "assert", "assert": "contains", "value": "[client-beta]" },
    { "type": "assert", "label": "a move carries the deadline it was stepped to", "assert": "contains", "value": "⊡ Tomorrow 14:30" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the move is one undo entry", "key": "u" },
    { "type": "assert", "assert": "status_contains", "value": "Undid: Move to Project: #2 Confirm the cutover window → client-beta" },
    { "type": "wait" },
    { "type": "assert", "label": "undoing a move restores the parentage it dropped", "assert": "contains", "value": "›1" },
    { "type": "assert", "label": "and it took the task back without touching the deadline", "assert": "contains", "value": "⊡ Tomorrow 14:30" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "redo puts the move back", "key": "ctrl+r" },
    { "type": "wait" },
    { "type": "assert", "assert": "not_contains", "value": "›1" },
    { "type": "assert", "assert": "contains", "value": "⊡ Tomorrow 14:30" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "restart", "label": "every one of those presses committed" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "not_contains", "value": "›1" },
    { "type": "assert", "assert": "contains", "value": "Confirm the cutover window" },
    { "type": "assert", "label": "a remembered clock is session memory, but a committed one is not", "assert": "contains", "value": "⊡ Tomorrow 14:30" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "the 60x20 minimum still draws the combined state", "width": 60, "height": 20 },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
