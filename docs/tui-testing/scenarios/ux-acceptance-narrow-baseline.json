{
  "name": "ux-acceptance-narrow-baseline",
  "fixture": "ux-acceptance",
  "size": "60x20",
  "actions": [
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "assert", "label": "the smallest supported terminal keeps the navigation ranks", "assert": "contains", "value": "Enter zoom · h/Left collapse · s sections · Tab next mode" },
    { "type": "assert", "label": "and drops the lowest-ranked ones whole", "assert": "not_contains", "value": "P projects" },
    { "type": "assert", "assert": "not_contains", "value": "? help" },
    { "type": "assert", "label": "grouping survives the width the titles do not", "assert": "contains", "value": "▾  @ Pinned  (1)" },
    { "type": "assert", "label": "and the compact label keeps its reserved width rather than degrading", "assert": "contains", "value": "[ux-platform…]" },

    { "type": "resize", "width": 80, "height": 24 },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "assert", "assert": "contains", "value": "P projects" },
    { "type": "assert", "assert": "not_contains", "value": "? help" },

    { "type": "resize", "width": 100, "height": 35 },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "assert", "assert": "contains", "value": "/ search · ? help" },

    { "type": "resize", "width": 120, "height": 40 },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "back to the narrow end for the Peek window", "width": 60, "height": 20 },
    { "type": "key", "key": "/" },
    { "type": "text", "text": "Restore the overdue" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "G" },
    { "type": "key", "key": "b" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "assert", "label": "the narrow row still clips, and the label it now carries is what costs it the third word", "assert": "contains", "value": "Restore the over…" },
    { "type": "assert", "label": "Peek wraps the whole title rather than eliding it", "assert": "contains", "value": "Restore the overdue billing reconciliation export" },
    { "type": "assert", "assert": "contains", "value": "the audit closes" },
    { "type": "assert", "label": "wrapping costs rows, so the same document has further to go", "assert": "contains", "value": "0 above · 10 below" },

    { "type": "key", "label": "the resume note is a page turn away rather than gone", "key": "ctrl+f" },
    { "type": "assert", "assert": "contains", "value": "Resume: Stopped after the ledger export; the" },
    { "type": "assert", "assert": "contains", "value": "4 above · 6 below" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
