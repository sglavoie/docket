{
  "name": "project-hub-preview-split",
  "fixture": "project-mix",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "open Select Project", "key": "P" },
    { "type": "assert", "assert": "view", "value": "ProjectHub" },
    { "type": "assert", "label": "the default split wraps the meta line between whole segments", "assert": "contains", "value": "Active · 1 open · 1 task" },
    { "type": "assert", "label": "so the slug never splits from its value", "assert": "contains", "value": "slug mix-active-delivery · pinned" },

    { "type": "key", "label": "move the split right, narrowing the preview", "key": ">" },
    { "type": "key", "key": ">" },
    { "type": "key", "key": ">" },
    { "type": "key", "key": ">" },
    { "type": "key", "key": ">" },
    { "type": "key", "key": ">" },
    { "type": "assert", "label": "a preview at its minimum width wraps the meta line onto more rows", "assert": "not_contains", "value": "slug mix-active-delivery · pinned" },
    { "type": "assert", "label": "and still keeps the slug segment whole", "assert": "contains", "value": "slug mix-active-delivery" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "move the split left, widening the preview past the default", "key": "<" },
    { "type": "key", "key": "<" },
    { "type": "key", "key": "<" },
    { "type": "key", "key": "<" },
    { "type": "key", "key": "<" },
    { "type": "key", "key": "<" },
    { "type": "key", "key": "<" },
    { "type": "key", "key": "<" },
    { "type": "key", "key": "<" },
    { "type": "key", "key": "<" },
    { "type": "key", "key": "<" },
    { "type": "key", "key": "<" },
    { "type": "assert", "label": "a preview wider than the default holds the whole meta line on one row", "assert": "contains", "value": "Active · 1 open · 1 task · slug mix-active-delivery · pinned" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "narrow the preview again before leaving", "key": ">" },
    { "type": "key", "key": ">" },
    { "type": "key", "key": ">" },
    { "type": "key", "key": ">" },
    { "type": "key", "key": ">" },
    { "type": "key", "key": ">" },
    { "type": "key", "key": ">" },
    { "type": "key", "key": ">" },
    { "type": "key", "key": ">" },
    { "type": "key", "key": ">" },
    { "type": "key", "label": "close Select Project", "key": "esc" },
    { "type": "key", "label": "reopen it", "key": "P" },
    { "type": "assert", "assert": "view", "value": "ProjectHub" },
    { "type": "assert", "label": "the split held across the reopen", "assert": "not_contains", "value": "slug mix-active-delivery · pinned" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "open project search", "key": "/" },
    { "type": "text", "label": "< and > are literal characters in the query", "text": "<>" },
    { "type": "assert", "assert": "contains", "value": "> <>" },
    { "type": "assert", "label": "the split hint is quiet while typing", "assert": "not_contains", "value": "</> split" },
    { "type": "key", "key": "esc" },

    { "type": "resize", "label": "below the two-pane minimum", "width": 60, "height": 20 },
    { "type": "key", "label": "a split key with no preview pane does nothing", "key": "<" },
    { "type": "assert", "assert": "view", "value": "ProjectHub" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
