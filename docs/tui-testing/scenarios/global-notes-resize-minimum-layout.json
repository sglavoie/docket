{
  "name": "global-notes-resize-minimum-layout",
  "fixture": "rich",
  "size": "100x40",
  "actions": [
    { "type": "key", "label": "open All Notes", "key": "ctrl+n" },
    { "type": "assert", "assert": "view", "value": "GlobalNotes" },
    { "type": "assert", "assert": "contains", "value": "2 notes across 3 owners" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "shrink to the minimum supported height", "width": 60, "height": 20 },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "open search at minimum size", "key": "/" },
    { "type": "text", "label": "search body at minimum size", "text": "authentication" },
    { "type": "assert", "assert": "contains", "value": "Search:" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "cancel search draft", "key": "esc" },
    { "type": "key", "label": "open scope picker at minimum size", "key": "p" },
    { "type": "assert", "assert": "contains", "value": "Select scope" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "cancel scope picker", "key": "esc" },
    { "type": "key", "label": "open creation picker at minimum size", "key": "a" },
    { "type": "assert", "assert": "contains", "value": "Create note in" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "cancel creation picker", "key": "esc" },
    { "type": "key", "label": "open move picker at minimum size", "key": "%" },
    { "type": "assert", "assert": "contains", "value": "Move note to" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "cancel move picker", "key": "esc" },
    { "type": "key", "label": "open the note sheet at minimum size", "key": "space" },
    { "type": "assert", "assert": "contains", "value": "Note Actions" },
    { "type": "assert", "assert": "contains", "value": "Delete note" },
    { "type": "assert", "label": "the direct keys never repeat as menu rows", "assert": "not_contains", "value": "Rename note" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "close the note sheet", "key": "esc" },
    { "type": "assert", "assert": "contains", "value": "All Notes" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
