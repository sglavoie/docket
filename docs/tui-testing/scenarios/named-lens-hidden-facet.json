{
  "name": "named-lens-hidden-facet",
  "fixture": "fresh",
  "size": "80x24",
  "actions": [
    { "type": "key", "label": "capture two tasks", "key": "a" },
    { "type": "text", "text": "Visible delta" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "key", "key": "a" },
    { "type": "text", "text": "Stashed echo" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "key", "key": "home" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "w" },
    { "type": "key", "label": "hide the newest task", "key": "h" },
    { "type": "wait" },
    { "type": "assert", "assert": "not_contains", "value": "Stashed echo" },
    { "type": "key", "label": "narrow to hidden tasks", "key": "f" },
    { "type": "key", "key": "H" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Stashed echo" },
    { "type": "assert", "assert": "not_contains", "value": "Visible delta" },

    { "type": "key", "label": "save the hidden view as a lens", "key": "\\" },
    { "type": "key", "key": "enter" },
    { "type": "text", "text": "Stash" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Lens: Stash" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "restart", "label": "relaunch against durable state alone" },
    { "type": "wait" },
    { "type": "assert", "label": "the saved lens reapplies the hidden facet", "assert": "contains", "value": "Lens: Stash" },
    { "type": "assert", "assert": "contains", "value": "Stashed echo" },
    { "type": "assert", "assert": "not_contains", "value": "Visible delta" },
    { "type": "key", "label": "the readout spells the clause the lens saved", "key": "Q" },
    { "type": "assert", "assert": "contains", "value": "+hidden:only" },
    { "type": "key", "key": "esc" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the first Esc after a restored lens lands on the clean view", "key": "esc" },
    { "type": "wait" },
    { "type": "assert", "assert": "not_contains", "value": "Lens: Stash" },
    { "type": "assert", "assert": "contains", "value": "Visible delta" },
    { "type": "assert", "label": "and hidden work leaves with the lens", "assert": "not_contains", "value": "Stashed echo" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
