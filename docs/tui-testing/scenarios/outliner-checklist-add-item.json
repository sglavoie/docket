{
  "name": "outliner-checklist-add-item",
  "fixture": "checklist",
  "size": "100x35",
  "actions": [
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "key", "label": "move onto the task that also has a child", "key": "j" },
    { "type": "key", "label": "move onto that child", "key": "j" },
    { "type": "key", "label": "move onto the task with no checklist", "key": "j" },

    { "type": "key", "label": "c offers the first item from a task row", "key": "c" },
    { "type": "assert", "assert": "contains", "value": "Add Checklist Item" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "Esc abandons the prompt", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "key", "label": "the count lives in Peek, so that is where a cancelled prompt is proved to have written nothing", "key": "b" },
    { "type": "assert", "assert": "not_contains", "value": "Checklist:" },
    { "type": "key", "label": "close Peek", "key": "b" },

    { "type": "key", "label": "c again, this time committed", "key": "c" },
    { "type": "assert", "assert": "contains", "value": "Add Checklist Item" },
    { "type": "text", "text": "Confirm the archive location" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "label": "the first item lands expanded beneath its owner, which is the row's own evidence", "assert": "contains", "value": "[ ] Confirm the archive location" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the cursor is on the new item, so c appends the next one from there", "key": "c" },
    { "type": "assert", "assert": "contains", "value": "Add Checklist Item" },
    { "type": "text", "text": "Record the retirement date" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "[ ] Record the retirement date" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "x proves the cursor followed the committed item", "key": "x" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "[x] Record the retirement date" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "back to the top of the outline", "key": "g" },
    { "type": "key", "key": "g" },
    { "type": "key", "label": "onto the task whose checklist is populated and still collapsed", "key": "j" },
    { "type": "assert", "label": "the collapsed owner row keeps its columns for the title", "assert": "not_contains", "value": "1/3" },
    { "type": "key", "label": "x names no item from an owner row and is silently unbound", "key": "x" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "not_contains", "value": "Start Checklist" },
    { "type": "key", "label": "Peek says the unbound key ticked nothing", "key": "b" },
    { "type": "assert", "assert": "contains", "value": "Checklist: 1/3 done" },
    { "type": "key", "label": "close Peek", "key": "b" },

    { "type": "key", "label": "c appends to a populated checklist and reveals it", "key": "c" },
    { "type": "text", "text": "Rehearse the rollback" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "[ ] Rehearse the rollback" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "an appended item is an ordinary ledger entry", "key": "u" },
    { "type": "wait" },
    { "type": "assert", "assert": "not_contains", "value": "Rehearse the rollback" },
    { "type": "key", "label": "back to the top", "key": "home" },
    { "type": "key", "label": "onto the owner the append and the undo both named", "key": "j" },
    { "type": "key", "label": "and the count Peek carries goes back with it", "key": "b" },
    { "type": "assert", "assert": "contains", "value": "Checklist: 1/3 done" },
    { "type": "key", "label": "close Peek", "key": "b" },
    { "type": "key", "label": "and redo puts it back", "key": "ctrl+r" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "[ ] Rehearse the rollback" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
