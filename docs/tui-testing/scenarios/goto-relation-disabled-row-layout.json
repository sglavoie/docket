{
  "name": "goto-relation-disabled-row-layout",
  "fixture": "multi-project",
  "size": "160x55",
  "actions": [
    { "type": "key", "key": "e" },
    { "type": "text", "label": "reference a task in a project this view can still read", "text": " ~client-beta:1" },
    { "type": "key", "key": "tab" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "~0/1" },

    { "type": "key", "label": "an expanded group spends no row on a heading, so fold them to reach one", "key": "p" },
    { "type": "key", "label": "step onto the referenced project's header", "key": "j" },
    { "type": "key", "key": "space" },
    { "type": "assert", "assert": "contains", "value": "Project Actions: Client Beta" },
    { "type": "text", "text": "Archive" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Are you sure you want to archive this project?" },
    { "type": "key", "key": "y" },
    { "type": "wait" },
    { "type": "assert", "label": "the target left the population the picker reads", "assert": "not_contains", "value": "Beta rollout checklist" },

    { "type": "key", "label": "unfold the groups again", "key": "p" },
    { "type": "key", "key": "home" },
    { "type": "key", "label": "back onto the referring task", "key": "j" },
    { "type": "assert", "assert": "contains", "value": "Alpha migration kickoff             [client-alpha] ~0/1?" },

    { "type": "key", "label": "open the relationship picker over a locator nobody can read", "key": "g" },
    { "type": "key", "key": "~" },
    { "type": "assert", "assert": "contains", "value": "Relationships · Alpha migration kickoff" },
    { "type": "assert", "assert": "contains", "value": "DEPENDENCIES" },
    { "type": "assert", "label": "the stored locator is retained rather than dropped", "assert": "contains", "value": "unavailable" },
    { "type": "assert", "label": "the footer explains why the row under the cursor cannot be taken", "assert": "contains", "value": "This view has not loaded that project" },
    { "type": "assert", "label": "which is all it can honestly say about the target", "assert": "not_contains", "value": "missing" },
    { "type": "assert", "label": "the computed half is omitted when nobody loaded points back", "assert": "not_contains", "value": "DEPENDENTS" },
    { "type": "assert", "label": "the overlay fits the widest committed size", "assert": "no_layout_issues" },

    { "type": "key", "label": "Enter on a disabled row moves nothing and says so in place", "key": "enter" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "contains", "value": "Relationships · Alpha migration kickoff" },
    { "type": "assert", "assert": "contains", "value": "This view has not loaded that project" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "the same refusal at the app's own minimum", "width": 60, "height": 20 },
    { "type": "assert", "assert": "contains", "value": "Relationships" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "width": 160, "height": 55 },

    { "type": "key", "label": "dismissal is the picker's alone; the row keeps its count", "key": "esc" },
    { "type": "assert", "assert": "not_contains", "value": "Relationships ·" },
    { "type": "assert", "assert": "contains", "value": "Alpha migration kickoff             [client-alpha] ~0/1?" },

    { "type": "key", "label": "the theme is not the picker's to toggle, so switch beneath it", "key": "T" },
    { "type": "assert", "assert": "status_contains", "value": "Theme: light" },
    { "type": "key", "key": "g" },
    { "type": "key", "key": "~" },
    { "type": "assert", "assert": "contains", "value": "Relationships · Alpha migration kickoff" },
    { "type": "assert", "assert": "contains", "value": "unavailable" },
    { "type": "assert", "assert": "contains", "value": "This view has not loaded that project" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "width": 60, "height": 20 },
    { "type": "assert", "assert": "contains", "value": "Relationships" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },
    { "type": "resize", "width": 160, "height": 55 },
    { "type": "key", "key": "T" },
    { "type": "assert", "assert": "status_contains", "value": "Theme: dark" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
