{
  "name": "notes-help",
  "fixture": "rich",
  "size": "160x55",
  "actions": [
    { "type": "key", "label": "open workspace-wide Notes", "key": "ctrl+n" },
    { "type": "assert", "assert": "view", "value": "GlobalNotes" },
    { "type": "assert", "label": "the wide footer promises both copies", "assert": "contains", "value": "copy title" },
    { "type": "assert", "assert": "contains", "value": "copy path" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "open the manager's own help", "key": "?" },
    { "type": "assert", "assert": "view", "value": "Help" },
    { "type": "assert", "assert": "contains", "value": "Copy note title" },
    { "type": "assert", "assert": "contains", "value": "Copy note path" },
    { "type": "assert", "label": "the copies sit beside the rest of the Notes grammar", "assert": "contains", "value": "Move note" },
    { "type": "assert", "label": "Delete reaches the user through the Space sheet alone", "assert": "not_contains", "value": "Delete note" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "close help back onto the manager", "key": "?" },
    { "type": "assert", "assert": "view", "value": "GlobalNotes" },
    { "type": "assert", "assert": "contains", "value": "Workspace launch brief" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "close Notes", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" }
  ]
}
