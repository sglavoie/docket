{
  "name": "stale-lane-and-filter",
  "fixture": "stale",
  "size": "100x35",
  "actions": [
    { "type": "command", "label": "open Backlog, which launch folds, so the scenario reads the whole workspace", "command": "Clear All Folds" },
    { "type": "assert", "label": "All leaves untouched work in its lifecycle lane", "assert": "not_contains", "value": "Stale  (2)" },
    { "type": "assert", "assert": "contains", "value": "Revisit dormant launch checklist" },
    { "type": "assert", "assert": "contains", "value": "Renew untouched vendor briefing" },
    { "type": "assert", "assert": "contains", "value": "Draft current launch note" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "go to Backlog outside All", "key": "g" },
    { "type": "key", "key": "b" },
    { "type": "assert", "assert": "contains", "value": "Draft current launch note" },
    { "type": "key", "label": "activate the Stale row refinement", "key": "f" },
    { "type": "key", "key": "s" },
    { "type": "assert", "assert": "status_contains", "value": "Filtering Stale" },
    { "type": "assert", "label": "the filter badge names the active facet", "assert": "contains", "value": "stale" },
    { "type": "assert", "assert": "contains", "value": "Revisit dormant launch checklist" },
    { "type": "assert", "assert": "contains", "value": "Renew untouched vendor briefing" },
    { "type": "assert", "assert": "not_contains", "value": "Draft current launch note" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "keep the applied Stale facet healthy at minimum width", "width": 60, "height": 20 },
    { "type": "assert", "assert": "contains", "value": "Revisit dormant" },
    { "type": "assert", "assert": "not_contains", "value": "Draft current launch note" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "width": 100, "height": 35 },
    { "type": "key", "label": "clear every facet before leaving Backlog", "key": "f" },
    { "type": "key", "key": "x" },
    { "type": "key", "label": "go to Recent, where Stale has no key", "key": "g" },
    { "type": "key", "key": "r" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · Recent" },
    { "type": "key", "label": "search out of Recent", "key": "/" },
    { "type": "text", "text": "launch" },
    { "type": "key", "label": "accept the query, which slash opened as the flat ranked list: the one presentation that leaves the mode's membership", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Search: \"launch\"" },
    { "type": "assert", "assert": "contains", "value": "Revisit dormant launch checklist" },
    { "type": "key", "label": "but fs stays unavailable: the mode underneath is still Recent", "key": "f" },
    { "type": "key", "key": "s" },
    { "type": "assert", "assert": "status_contains", "value": "fs is not a filter action" },
    { "type": "assert", "assert": "not_contains", "value": "Filtering Stale" },
    { "type": "assert", "assert": "contains", "value": "Search: \"launch\"" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "restore Recent exactly", "key": "esc" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · Recent" },
    { "type": "assert", "assert": "not_contains", "value": "Search:" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
