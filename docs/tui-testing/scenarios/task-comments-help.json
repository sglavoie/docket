{
  "name": "task-comments-help",
  "fixture": "rich",
  "size": "160x55",
  "actions": [

    { "type": "key", "label": "open the Comments panel with its sigil key", "key": ";" },
    { "type": "assert", "assert": "view", "value": "TaskComments" },
    { "type": "assert", "label": "the panel promises the key it now answers", "assert": "contains", "value": "? help" },

    { "type": "key", "label": "add a comment so the acting keys are live", "key": "a" },
    { "type": "text", "text": "checked the redirect handler" },
    { "type": "key", "key": "ctrl+s" },
    { "type": "wait" },

    { "type": "key", "label": "open the panel's own help", "key": "?" },
    { "type": "assert", "assert": "view", "value": "Help" },
    { "type": "assert", "assert": "contains", "value": "Help  Comments" },
    { "type": "assert", "assert": "contains", "value": "Expand Comment" },
    { "type": "assert", "assert": "contains", "value": "Comment Actions" },
    { "type": "assert", "assert": "contains", "value": "Copy All as Markdown" },
    { "type": "assert", "label": "both ends are spelled as the whole paths the panel answers", "assert": "contains", "value": "gg/Home" },
    { "type": "assert", "assert": "contains", "value": "G/End" },
    { "type": "assert", "label": "the help lists the key that raised it", "assert": "contains", "value": "Help" },
    { "type": "assert", "label": "Esc names the panel it closes", "assert": "contains", "value": "Close comments" },
    { "type": "assert", "assert": "not_contains", "value": "Close panel" },
    { "type": "assert", "label": "the panel help claims no reorder", "assert": "not_contains", "value": "Reorder" },
    { "type": "assert", "label": "the panel grammar names itself rather than the Outliner's", "assert": "not_contains", "value": "Capture" },
    { "type": "assert", "assert": "not_contains", "value": "Move to Backlog" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "close help back onto the panel", "key": "?" },
    { "type": "assert", "assert": "view", "value": "TaskComments" },
    { "type": "assert", "assert": "contains", "value": "checked the redirect handler" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the add buffer owns the whole key stream", "key": "a" },
    { "type": "text", "text": "?" },
    { "type": "assert", "assert": "view", "value": "TaskComments" },
    { "type": "assert", "assert": "not_contains", "value": "Help  Comments" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "discard the typed character", "key": "esc" },
    { "type": "key", "key": "y" },

    { "type": "key", "label": "the expanded comment owns it too", "key": "enter" },
    { "type": "key", "key": "?" },
    { "type": "assert", "assert": "view", "value": "TaskComments" },
    { "type": "assert", "assert": "not_contains", "value": "Help  Comments" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "TaskComments" }
  ]
}
