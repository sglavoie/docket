{
  "name": "capture-due-time",
  "fixture": "signals",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "open capture", "key": "a" },
    { "type": "assert", "assert": "view", "value": "TaskComposer" },
    { "type": "text", "label": "an hh:mm suffix on the due sigil sets an explicit time-of-day", "text": "Deploy the release @2026-08-25 15:30 " },
    { "type": "assert", "assert": "contains", "value": "Schedule" },
    { "type": "assert", "label": "the composer echoes the timed due date", "assert": "contains", "value": "15:30" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "commit the capture", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "label": "the committed row shows the clock time on its due badge", "assert": "contains", "value": "15:30" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "undo the capture", "key": "u" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "not_contains", "value": "Deploy the release" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
