{
  "name": "defer-picker-direct",
  "fixture": "rich",
  "size": "100x35",
  "actions": [

    { "type": "key", "label": "open the one date picker with its direct key", "key": "@" },
    { "type": "assert", "assert": "contains", "value": "Set Due, Defer, or Check-In: Build login form" },
    { "type": "assert", "label": "one picker carries both fields as sections", "assert": "contains", "value": "DUE" },
    { "type": "assert", "assert": "contains", "value": "DEFER" },
    { "type": "assert", "assert": "contains", "value": "Clear defer" },
    { "type": "assert", "label": "a deferral is an instant, so the defer section offers hour offsets", "assert": "contains", "value": "In 1 hour" },
    { "type": "assert", "assert": "contains", "value": "In 4 hours" },
    { "type": "assert", "assert": "contains", "value": "In 8 hours" },
    { "type": "assert", "assert": "contains", "value": "Tomorrow morning" },
    { "type": "assert", "assert": "contains", "value": "Esc back" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "cancel back to the Outliner", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "not_contains", "value": "Set Due, Defer, or Check-In" },

    { "type": "key", "label": "reopen the picker", "key": "@" },
    { "type": "key", "label": "cross into the defer section onto In 1 hour, past a Clear defer with nothing to clear", "key": "tab" },
    { "type": "key", "label": "commit the one-hour deferral", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "label": "the picker chrome is gone; only its status remains", "assert": "not_contains", "value": "Esc back" },
    { "type": "assert", "assert": "status_contains", "value": "Defer" },
    { "type": "assert", "label": "an hour-granular deferral hides the row today, not tomorrow", "assert": "not_contains", "value": "Build login form" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
