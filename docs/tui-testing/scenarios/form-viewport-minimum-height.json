{
  "name": "form-viewport-minimum-height",
  "fixture": "fresh",
  "size": "72x20",
  "actions": [
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "key", "label": "capture into Unfiled", "key": "a" },
    { "type": "assert", "assert": "view", "value": "TaskComposer" },
    { "type": "text", "text": "Wire the Extras viewport" },
    { "type": "key", "label": "expand into the full task form", "key": "ctrl+f" },
    { "type": "assert", "assert": "contains", "value": "Task Composer · Expanded" },
    { "type": "key", "label": "wrap backward onto Extras", "key": "shift+left" },
    { "type": "assert", "assert": "contains", "value": "Attachments (0)" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "key": "ctrl+l" },
    { "type": "text", "text": "https://ex.co/s01" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "ctrl+l" },
    { "type": "text", "text": "https://ex.co/s02" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "ctrl+l" },
    { "type": "text", "text": "https://ex.co/s03" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "ctrl+l" },
    { "type": "text", "text": "https://ex.co/s04" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "ctrl+l" },
    { "type": "text", "text": "https://ex.co/s05" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "ctrl+l" },
    { "type": "text", "text": "https://ex.co/s06" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "ctrl+l" },
    { "type": "text", "text": "https://ex.co/s07" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "ctrl+l" },
    { "type": "text", "text": "https://ex.co/s08" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "ctrl+l" },
    { "type": "text", "text": "https://ex.co/s09" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "ctrl+l" },
    { "type": "text", "text": "https://ex.co/s10" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "label": "the aligned relation fields each occupy one row below these drafts", "assert": "contains", "value": "0 above · 2 below" },
    { "type": "assert", "label": "whose hints are the form's keys", "assert": "contains", "value": "Ctrl+S save · Esc keep draft" },
    { "type": "assert", "label": "in place of the breadcrumb row", "assert": "not_contains", "value": "Outliner >" },
    { "type": "key", "key": "ctrl+l" },
    { "type": "text", "text": "https://ex.co/s11" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "ctrl+l" },
    { "type": "text", "text": "https://ex.co/s12" },
    { "type": "key", "key": "enter" },
    { "type": "key", "label": "a thirteenth draft, more than this height can show at once", "key": "ctrl+l" },
    { "type": "text", "text": "https://ex.co/s13" },
    { "type": "key", "key": "enter" },

    { "type": "assert", "assert": "contains", "value": "Attachments (13)" },
    { "type": "assert", "label": "the body scrolls now instead of telling a reader to resize", "assert": "not_contains", "value": "resize terminal to view all" },
    { "type": "assert", "label": "the position row accounts for the compact window and its current offset", "assert": "contains", "value": "0 above · 5 below" },
    { "type": "assert", "label": "the tail is genuinely below the fold at this height", "assert": "not_contains", "value": "https://ex.co/s13" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "tab onto the first draft", "key": "tab" },
    { "type": "key", "key": "tab" },
    { "type": "key", "key": "tab" },
    { "type": "key", "key": "tab" },
    { "type": "key", "key": "tab" },
    { "type": "key", "key": "tab" },
    { "type": "key", "key": "tab" },
    { "type": "key", "key": "tab" },
    { "type": "key", "key": "tab" },
    { "type": "key", "key": "tab" },
    { "type": "key", "key": "tab" },
    { "type": "key", "key": "tab" },
    { "type": "key", "label": "and on to the thirteenth, which the window has to follow", "key": "tab" },
    { "type": "assert", "assert": "contains", "value": "https://ex.co/s13" },
    { "type": "assert", "assert": "contains", "value": "2 above · 3 below", "label": "the position row accounts for the compact window and its current offset" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "open the nested item editor on the focused draft", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Edit Attachment" },
    { "type": "assert", "label": "an overlay carries no position row of its own", "assert": "not_contains", "value": "above ·" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "return from it", "key": "esc" },
    { "type": "assert", "label": "the window is still where the focus is", "assert": "contains", "value": "https://ex.co/s13" },
    { "type": "assert", "assert": "contains", "value": "2 above · 3 below", "label": "the position row accounts for the compact window and its current offset" },

    { "type": "key", "label": "one field further reaches the Comments header", "key": "tab" },
    { "type": "assert", "assert": "contains", "value": "Comments (0)" },
    { "type": "assert", "assert": "contains", "value": "3 above · 2 below", "label": "the position row accounts for the compact window and its current offset" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "a taller terminal gives the whole body back", "width": 100, "height": 40 },
    { "type": "assert", "assert": "not_contains", "value": "above ·" },
    { "type": "assert", "assert": "contains", "value": "https://ex.co/s01" },
    { "type": "assert", "assert": "contains", "value": "https://ex.co/s13" },
    { "type": "assert", "assert": "contains", "value": "Comments (0)" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "and shrinking restores the window around the same focus", "width": 72, "height": 20 },
    { "type": "assert", "assert": "contains", "value": "Comments (0)" },
    { "type": "assert", "assert": "contains", "value": "3 above · 2 below", "label": "the position row accounts for the compact window and its current offset" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "the same window semantics at the app's own minimum width", "width": 60, "height": 20 },
    { "type": "assert", "label": "the body resizes from the available width instead of refusing it", "assert": "not_contains", "value": "Terminal too small" },
    { "type": "assert", "label": "the focused field is still the one on screen", "assert": "not_clipped", "value": "Comments (0)" },
    { "type": "assert", "label": "the position row accounts for the compact window and its current offset", "assert": "contains", "value": "3 above · 2 below" },
    { "type": "assert", "assert": "not_contains", "value": "resize terminal to view all" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "back to the starting width, window intact", "width": 72, "height": 20 },
    { "type": "assert", "assert": "contains", "value": "3 above · 2 below", "label": "the position row accounts for the compact window and its current offset" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "a fourteenth draft the application layer will refuse", "key": "ctrl+l" },
    { "type": "text", "text": "nope.pdf" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "label": "the window followed the focus onto the new draft, so its section header is above the fold", "assert": "contains", "value": "nope.pdf" },
    { "type": "assert", "assert": "not_contains", "value": "Attachments (14)" },
    { "type": "key", "key": "ctrl+s" },
    { "type": "assert", "label": "a refused save keeps the form open", "assert": "contains", "value": "Task Composer · Expanded" },
    { "type": "assert", "label": "the banner is chrome, so it costs the window a row rather than hiding", "assert": "contains", "value": "invalid attachment" },
    { "type": "assert", "label": "and the shortened window still reaches the refused draft", "assert": "contains", "value": "nope.pdf" },
    { "type": "assert", "assert": "contains", "value": "above ·" },

    { "type": "key", "label": "delete the refused draft the window is sitting on", "key": "ctrl+d" },
    { "type": "assert", "label": "the position row accounts for the compact window and its current offset", "assert": "contains", "value": "6 above · 2 below" },
    { "type": "assert", "label": "which is the shell's line, above the form's keys and under the one divider", "assert": "contains", "value": "invalid attachment" },
    { "type": "assert", "assert": "contains", "value": "https://ex.co/s13" },
    { "type": "assert", "assert": "contains", "value": "Comments (0)" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "every draft entered through the window commits", "key": "ctrl+s" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "status_contains", "value": "Add Task: #1 Wire the Extras viewport" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
