    { "type": "key", "label": "send the cursored task to Waiting", "key": "w" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "status_contains", "value": "Change State" },
    { "type": "assert", "assert": "contains", "value": "@ Waiting  (2)" },
