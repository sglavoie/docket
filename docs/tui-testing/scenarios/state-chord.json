{
  "name": "state-chord",
  "fixture": "rich",
  "size": "100x35",
  "actions": [
    { "type": "key", "key": "j" },
    { "type": "key", "label": "move the cursor onto the Doing task", "key": "j" },

    { "type": "key", "label": "hold the state/planning prefix", "key": "s" },
    { "type": "assert", "assert": "contains", "value": "i inbox" },
    { "type": "assert", "assert": "contains", "value": "b backlog" },
    { "type": "assert", "assert": "contains", "value": "n next" },
    { "type": "assert", "assert": "contains", "value": "g doing" },
    { "type": "assert", "assert": "contains", "value": "w waiting" },
    { "type": "assert", "assert": "contains", "value": "p paused" },
    { "type": "assert", "assert": "contains", "value": "m someday" },
    { "type": "assert", "assert": "contains", "value": "d done" },
    { "type": "assert", "assert": "contains", "value": "c canceled" },
    { "type": "assert", "assert": "contains", "value": "t today" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "send the cursored task to Waiting", "key": "w" },
    { "type": "wait" },
    { "type": "assert", "label": "waiting chains straight into the check-back date", "assert": "contains", "value": "Set Due Date" },
    { "type": "key", "label": "decline the check-back", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "status_contains", "value": "Change State" },
    { "type": "assert", "assert": "contains", "value": "@ Waiting  (2)" },
    { "type": "assert", "assert": "contains", "value": "⊘   Build login form" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "abandon a half-typed chord", "key": "s" },
    { "type": "key", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "not_contains", "value": "w waiting" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "select the cursored task and enter multi-select", "key": "v" },
    { "type": "assert", "assert": "contains", "value": "MULTI-SELECT: 1 selected" },
    { "type": "key", "label": "open state and planning actions", "key": "s" },
    { "type": "key", "label": "park the selection in Someday", "key": "m" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "@ Someday  (2)" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
