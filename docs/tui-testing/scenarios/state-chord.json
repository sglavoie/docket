    { "type": "resize", "label": "at the floor the line is wider than its row", "width": 60, "height": 20 },
    { "type": "assert", "label": "the head is elided and the recovery key survives whole", "assert": "contains", "value": "… · u undo" },
    { "type": "assert", "label": "the start of the sentence still says what happened", "assert": "contains", "value": "Build login form → Waiting" },
