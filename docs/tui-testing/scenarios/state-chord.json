    { "type": "assert", "assert": "status_contains", "value": "Change Status" },
    { "type": "assert", "assert": "contains", "value": "Waiting  (2)" },
    { "type": "assert", "assert": "contains", "value": "⊘   Build login form" },
    { "type": "assert", "assert": "no_layout_issues" },
