{
  "name": "outliner-dependency-unavailable-fallback",
  "fixture": "multi-project",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "launch folds Backlog and seats the cursor on its header, so open the lane", "key": "l" },
    { "type": "key", "label": "onto the Client Alpha group header", "key": "j" },
    { "type": "key", "label": "onto Client Alpha's task", "key": "j" },
    { "type": "key", "key": "e" },
    { "type": "text", "label": "reference a task in a project this view can still read", "text": " ~client-beta:1" },
    { "type": "key", "key": "tab" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "~0/1" },
    { "type": "key", "key": "b" },
    { "type": "assert", "assert": "contains", "value": "Dependencies 0/1: Client Beta #1 Beta rollout checklist (backlog)" },
    { "type": "key", "key": "b" },

    { "type": "key", "label": "step onto the referenced project's header", "key": "j" },
    { "type": "key", "key": "space" },
    { "type": "assert", "assert": "contains", "value": "Project Actions: Client Beta" },
    { "type": "text", "text": "Archive" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Are you sure you want to archive this project?" },
    { "type": "key", "key": "y" },
    { "type": "wait" },
    { "type": "assert", "label": "the target left the population the Outliner reads", "assert": "not_contains", "value": "Beta rollout checklist" },

    { "type": "key", "key": "home" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "assert", "label": "the denominator is over stored locators, not over reachable ones, and the trailing ? says one cannot be read", "assert": "contains", "value": "~0/1?" },
    { "type": "resize", "label": "wide enough for a locator no name shortens", "width": 140, "height": 35 },
    { "type": "key", "key": "b" },
    { "type": "assert", "label": "the entry keeps its durable locator and says only that it is unavailable", "assert": "contains", "value": "(unavailable)" },
    { "type": "assert", "label": "which is all this view can honestly say: it cannot tell missing from unloaded", "assert": "not_contains", "value": "missing" },
    { "type": "assert", "assert": "not_contains", "value": "deleted" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "close Peek", "key": "b" },
    { "type": "resize", "label": "and the count is the last thing narrowing costs", "width": 60, "height": 20 },
    { "type": "assert", "assert": "contains", "value": "~0/1?" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "width": 100, "height": 35 },

    { "type": "key", "label": "nothing pruned the reference, so restoring the project restores the label", "key": "u" },
    { "type": "wait" },
    { "type": "key", "key": "home" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "b" },
    { "type": "assert", "assert": "contains", "value": "Dependencies 0/1: Client Beta #1 Beta rollout checklist (backlog)" },
    { "type": "assert", "assert": "not_contains", "value": "(unavailable)" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
