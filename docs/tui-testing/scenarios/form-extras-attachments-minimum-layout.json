{
  "name": "form-extras-attachments-minimum-layout",
  "fixture": "fresh",
  "size": "60x20",
  "actions": [
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "key", "label": "capture into Unfiled", "key": "a" },
    { "type": "assert", "assert": "view", "value": "TaskComposer" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "text", "text": "Wire the Extras tab" },
    { "type": "key", "label": "expand into the full task form", "key": "ctrl+f" },
    { "type": "assert", "label": "the form resizes from the available width instead of refusing the app's own minimum", "assert": "not_contains", "value": "Terminal too small" },
    { "type": "assert", "assert": "contains", "value": "Task Composer · Expanded" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "wrap backward onto Extras", "key": "shift+left" },
    { "type": "assert", "label": "the Extras sections are readable at 60 columns", "assert": "not_clipped", "value": "Attachments (0)" },
    { "type": "assert", "assert": "not_clipped", "value": "Comments (0)" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "add an attachment draft", "key": "ctrl+l" },
    { "type": "assert", "label": "the nested editor keeps its whole frame at the minimum width", "assert": "contains", "value": "Edit Attachment" },
    { "type": "assert", "assert": "contains", "value": "Enter save" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "text", "text": "https://example.com/spec.pdf" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "not_clipped", "value": "Attachments (1)" },
    { "type": "assert", "assert": "not_clipped", "value": "https://example.com/spec.pdf" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "focus the draft row itself", "key": "tab" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "reopen the draft in the nested editor", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Edit Attachment" },
    { "type": "assert", "assert": "contains", "value": "https://example.com/spec.pdf" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "leave the editor without changing the draft", "key": "esc" },
    { "type": "assert", "assert": "not_clipped", "value": "Attachments (1)" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "widen well past the preferred body width", "width": 100, "height": 40 },
    { "type": "assert", "assert": "contains", "value": "Attachments (1)" },
    { "type": "assert", "assert": "contains", "value": "https://example.com/spec.pdf" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "and back to the floor: the draft survives repeated resizing", "width": 60, "height": 20 },
    { "type": "assert", "assert": "not_clipped", "value": "Attachments (1)" },
    { "type": "assert", "assert": "not_clipped", "value": "https://example.com/spec.pdf" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "a draft the application layer will refuse", "key": "ctrl+l" },
    { "type": "text", "text": "nope.pdf" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "ctrl+s" },
    { "type": "assert", "label": "a refused save keeps the form open at the floor", "assert": "contains", "value": "Task Composer · Expanded" },
    { "type": "assert", "label": "the banner wraps to the terminal rather than being shortened", "assert": "contains", "value": "invalid attachment" },
    { "type": "assert", "label": "both drafts stay readable beside it, so the reader can tell which one was refused", "assert": "not_clipped", "value": "nope.pdf" },
    { "type": "assert", "assert": "not_clipped", "value": "https://example.com/spec.pdf" },
    { "type": "assert", "label": "the footer names the retry", "assert": "not_clipped", "value": "Ctrl+S retry" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "onto the refused draft", "key": "tab" },
    { "type": "key", "label": "drop it", "key": "ctrl+d" },
    { "type": "assert", "label": "the retry route leaves the surviving draft alone", "assert": "not_clipped", "value": "Attachments (1)" },
    { "type": "assert", "assert": "not_clipped", "value": "https://example.com/spec.pdf" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "commit the task with its attachment from the floor", "key": "ctrl+s" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "contains", "value": "Wire the Extras tab" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
