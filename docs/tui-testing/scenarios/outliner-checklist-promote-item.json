{
  "name": "outliner-checklist-promote-item",
  "fixture": "checklist",
  "size": "100x35",
  "actions": [
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "key", "label": "move onto the project header", "key": "j" },
    { "type": "key", "label": "move onto the checklist-only task", "key": "j" },
    { "type": "key", "label": "expand its checklist", "key": "l" },
    { "type": "key", "label": "move onto the first checklist item", "key": "j" },
    { "type": "key", "label": "move onto the open item this scenario promotes", "key": "j" },
    { "type": "assert", "assert": "contains", "value": "[ ] Name the on-call owner" },
    { "type": "assert", "assert": "contains", "value": "1/3" },

    { "type": "key", "label": "the item menu still routes Delete Item alone", "key": "space" },
    { "type": "assert", "assert": "contains", "value": "Checklist Item" },
    { "type": "assert", "assert": "contains", "value": "Edit Item" },
    { "type": "assert", "assert": "contains", "value": "Delete Item" },
    { "type": "assert", "label": "promotion is direct-only, so the sheet never names it", "assert": "not_contains", "value": "Make Subtask" },
    { "type": "key", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },

    { "type": "key", "label": "S converts the item under the cursor", "key": "S" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "label": "the item is consumed", "assert": "not_contains", "value": "[ ] Name the on-call owner" },
    { "type": "assert", "label": "the child is revealed under its owner", "assert": "contains", "value": "Name the on-call owner" },
    { "type": "assert", "label": "the owner badge follows the shortened checklist", "assert": "contains", "value": "1/2" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the promotion is one undo entry", "key": "u" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "contains", "value": "[ ] Name the on-call owner" },
    { "type": "assert", "assert": "contains", "value": "1/3" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
