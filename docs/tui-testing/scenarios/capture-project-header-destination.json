{
  "name": "capture-project-header-destination",
  "fixture": "multi-project",
  "size": "100x30",
  "actions": [
    { "type": "command", "label": "open Backlog, which launch folds, so the scenario reads the whole workspace", "command": "Clear All Folds" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "key", "label": "capture from a task row", "key": "a" },
    { "type": "assert", "assert": "view", "value": "TaskComposer" },
    { "type": "assert", "label": "a task cursor never lends capture its project", "assert": "contains", "value": "Project: Unfiled" },
    { "type": "assert", "label": "the divider names the act alone, so the destination is stated once", "assert": "not_contains", "value": "Capture →" },
    { "type": "key", "label": "leave the composer without capturing", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "key", "label": "step up onto a project header", "key": "k" },
    { "type": "key", "label": "return to the top row", "key": "home" },
    { "type": "key", "label": "step onto the first project header", "key": "j" },
    { "type": "key", "label": "capture from a project header row", "key": "a" },
    { "type": "assert", "assert": "view", "value": "TaskComposer" },
    { "type": "assert", "label": "the route row names the destination it resolved", "assert": "contains", "value": "Project: Client Alpha" },
    { "type": "assert", "assert": "not_contains", "value": "Project: Unfiled" },
    { "type": "assert", "label": "the divider still names the act and nothing else", "assert": "contains", "value": "── Capture ─" },
    { "type": "key", "label": "leave the composer without capturing", "key": "esc" },
    { "type": "key", "label": "a project has no task to parent a child under", "key": "A" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "contains", "value": "move the cursor to a task to use this action" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
