{
  "name": "project-hub-metadata-search",
  "fixture": "project-mix",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "open Select Project", "key": "P" },
    { "type": "assert", "assert": "view", "value": "ProjectHub" },

    { "type": "key", "label": "search an active project by a word only its description holds", "key": "/" },
    { "type": "text", "text": "storefront" },
    { "type": "assert", "assert": "contains", "value": "Mix Active Delivery" },
    { "type": "assert", "assert": "not_contains", "value": "Mix Quiet Planning" },
    { "type": "assert", "assert": "not_contains", "value": "Mix Retired Pilot" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "leave the search input", "key": "esc" },
    { "type": "key", "label": "clear the query the browse kept", "key": "esc" },
    { "type": "key", "label": "leave the Hub", "key": "esc" },

    { "type": "key", "key": "P" },
    { "type": "key", "label": "the archived tail answers its description too", "key": "/" },
    { "type": "text", "text": "kiosk trial" },
    { "type": "assert", "assert": "contains", "value": "ARCHIVED PROJECTS" },
    { "type": "assert", "assert": "contains", "value": "Mix Retired Pilot" },
    { "type": "assert", "assert": "not_contains", "value": "Mix Active Delivery" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },

    { "type": "key", "key": "P" },
    { "type": "key", "label": "a bare project tag", "key": "/" },
    { "type": "text", "text": "housekeeping" },
    { "type": "assert", "assert": "contains", "value": "Mix Finished Cleanup" },
    { "type": "assert", "assert": "not_contains", "value": "Mix Active Delivery" },
    { "type": "assert", "assert": "not_contains", "value": "Mix Retired Pilot" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },

    { "type": "key", "key": "P" },
    { "type": "key", "label": "the same tag spelled the way the row's own chip writes it", "key": "/" },
    { "type": "text", "text": "#charter" },
    { "type": "assert", "assert": "contains", "value": "Mix Quiet Planning" },
    { "type": "assert", "assert": "not_contains", "value": "Mix Finished Cleanup" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },

    { "type": "key", "key": "P" },
    { "type": "key", "label": "a parked project keeps its descriptive tag reachable", "key": "/" },
    { "type": "text", "text": "#vendor" },
    { "type": "assert", "assert": "contains", "value": "Mix Parked Migration" },
    { "type": "assert", "assert": "not_contains", "value": "Mix Quiet Planning" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },

    { "type": "key", "label": "the pinned population reads the same aliases", "key": "ctrl+p" },
    { "type": "assert", "assert": "contains", "value": "Select Pinned Project" },
    { "type": "key", "key": "/" },
    { "type": "text", "text": "#commerce" },
    { "type": "assert", "assert": "contains", "value": "Mix Active Delivery" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },

    { "type": "key", "key": "ctrl+p" },
    { "type": "key", "label": "an unpinned project's metadata cannot widen the pinned population", "key": "/" },
    { "type": "text", "text": "charter" },
    { "type": "assert", "assert": "contains", "value": "No pinned projects match this search." },
    { "type": "assert", "assert": "not_contains", "value": "Mix Quiet Planning" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },

    { "type": "key", "key": "P" },
    { "type": "key", "label": "a task title the Hub's own project holds is not Hub content", "key": "/" },
    { "type": "text", "text": "rollout plan" },
    { "type": "assert", "assert": "contains", "value": "No projects match this search." },
    { "type": "assert", "assert": "not_contains", "value": "Mix Active Delivery" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },

    { "type": "key", "key": "P" },
    { "type": "key", "key": "/" },
    { "type": "text", "text": "cleanup sweep" },
    { "type": "assert", "assert": "contains", "value": "No projects match this search." },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },

    { "type": "key", "key": "P" },
    { "type": "key", "key": "/" },
    { "type": "text", "text": "migration audit" },
    { "type": "assert", "assert": "contains", "value": "No projects match this search." },
    { "type": "assert", "assert": "not_contains", "value": "Mix Parked Migration" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },

    { "type": "key", "key": "P" },
    { "type": "key", "key": "/" },
    { "type": "text", "text": "storefront" },
    { "type": "resize", "label": "the two-pane boundary the preview needs exactly", "width": 72, "height": 35 },
    { "type": "assert", "assert": "contains", "value": "Mix Active Delivery" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "one column below it, where the pane falls back to the list", "width": 71, "height": 35 },
    { "type": "assert", "assert": "contains", "value": "Mix Active Delivery" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "narrow", "width": 60, "height": 20 },
    { "type": "assert", "assert": "contains", "value": "Mix Active Delivery" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "the app's own minimum, where the pane and the matched row share the floor", "width": 72, "height": 20 },
    { "type": "assert", "assert": "contains", "value": "Mix Active Delivery" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
