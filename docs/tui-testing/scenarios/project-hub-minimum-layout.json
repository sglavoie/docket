{
  "name": "project-hub-minimum-layout",
  "fixture": "multi-project",
  "size": "60x20",
  "actions": [
    { "type": "key", "label": "open Select Project at the minimum supported size", "key": "P" },
    { "type": "assert", "assert": "view", "value": "ProjectHub" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the single-project sheet fits the same terminal", "key": "space" },
    { "type": "assert", "assert": "contains", "value": "Actions" },
    { "type": "assert", "assert": "contains", "value": "Archive project" },
    { "type": "assert", "label": "the direct keys never repeat as menu rows", "assert": "not_contains", "value": "Open project" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "close the sheet", "key": "esc" },

    { "type": "key", "label": "select the project under the cursor", "key": "v" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "v" },
    { "type": "assert", "assert": "contains", "value": "2 selected" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the bulk sheet fits it too", "key": "space" },
    { "type": "assert", "assert": "contains", "value": "Add tag" },
    { "type": "assert", "assert": "contains", "value": "Park projects" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "close the bulk sheet", "key": "esc" },

    { "type": "key", "label": "search narrows the same footer", "key": "/" },
    { "type": "text", "text": "a" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "ProjectHub" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
