{
  "name": "capture-dependency-cross-project",
  "fixture": "multi-project",
  "size": "100x35",
  "actions": [
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "key", "label": "capture from the outliner", "key": "a" },
    { "type": "assert", "assert": "view", "value": "TaskComposer" },
    { "type": "text", "label": "name the project first, since it decides how an alias is spelled", "text": "Wire the importer %client-alpha ~" },
    { "type": "assert", "assert": "contains", "value": "Client Alpha" },
    { "type": "assert", "label": "every loaded project's open work is addressable", "assert": "contains", "value": "Beta rollout checklist" },
    { "type": "assert", "assert": "contains", "value": "Renew passport" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "text", "label": "a title prefix inside the effective project", "text": "alpha" },
    { "type": "assert", "label": "a local target inserts the bare short ID", "assert": "contains", "value": "~1 □ Client Alpha #1 Alpha migration kickoff" },
    { "type": "assert", "assert": "not_contains", "value": "Renew passport" },
    { "type": "key", "label": "accept the highlighted candidate", "key": "tab" },
    { "type": "assert", "assert": "contains", "value": "Wire the importer %client-alpha ~1" },

    { "type": "text", "label": "and a title prefix that only another project carries", "text": "~checklist" },
    { "type": "assert", "label": "a cross-project target inserts a slug-qualified alias", "assert": "contains", "value": "~client-beta:1 □ Client Beta #1 Beta rollout checklist" },
    { "type": "key", "key": "tab" },
    { "type": "assert", "assert": "contains", "value": "~client-beta:1" },
    { "type": "assert", "label": "the preview names the references rather than the aliases alone", "assert": "contains", "value": "Depends" },
    { "type": "assert", "assert": "contains", "value": "Client Alpha #1 Alpha migration kickoff" },
    { "type": "assert", "assert": "contains", "value": "Client Beta #1 Beta rollout checklist" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "commit the capture", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "label": "the sigils left the title", "assert": "contains", "value": "Wire the importer" },
    { "type": "assert", "assert": "not_contains", "value": "~client-beta:1" },

    { "type": "key", "key": "home" },
    { "type": "key", "label": "past the Inbox section header", "key": "j" },
    { "type": "key", "label": "past the project header onto the new row", "key": "j" },
    { "type": "assert", "label": "the row states how many of the references it stores are settled", "assert": "contains", "value": "~0/2" },
    { "type": "key", "label": "Peek is the only surface that names them", "key": "ctrl+enter" },
    { "type": "assert", "label": "one line, in stored order, each entry stating the target's state", "assert": "contains", "value": "Dependencies 0/2: Client Alpha #1 Alpha migration kickoff (backlog) · Client Beta #1 Beta r" },
    { "type": "assert", "label": "the reference is one-directional: the referring task has no dependents", "assert": "not_contains", "value": "Dependents " },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "the reference count survives the app's own minimum", "width": 60, "height": 20 },
    { "type": "assert", "assert": "contains", "value": "~0/2" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "width": 100, "height": 35 },
    { "type": "key", "key": "ctrl+enter" },

    { "type": "key", "label": "reach the referenced task across the project boundary", "key": "/" },
    { "type": "text", "text": "Beta rollout" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "ctrl+enter" },
    { "type": "assert", "label": "the other direction is computed, never stored", "assert": "contains", "value": "Dependents 1: Client Alpha #2 Wire the importer (inbox)" },
    { "type": "assert", "assert": "not_contains", "value": "Dependencies " },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
