{
  "name": "date-picker-section-switch",
  "fixture": "rich",
  "size": "100x35",
  "actions": [
    { "type": "assert", "label": "Tab is the Outliner's next-mode key before the picker borrows it", "assert": "contains", "value": "Active Projects · All" },

    { "type": "key", "label": "open the one date picker", "key": "@" },
    { "type": "assert", "assert": "contains", "value": "Set Due, Defer, or Check-In: Build login form" },
    { "type": "assert", "label": "the picker opens in Due whatever the task defers to", "assert": "contains", "value": "a set due date" },
    { "type": "assert", "assert": "contains", "value": "Tab switch field" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "cross into the defer section", "key": "tab" },
    { "type": "assert", "label": "the one typed-date key now writes the other field", "assert": "contains", "value": "a set defer date" },
    { "type": "assert", "label": "switching is not choosing: the picker is still up", "assert": "contains", "value": "Set Due, Defer, or Check-In: Build login form" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "and back again", "key": "shift+tab" },
    { "type": "assert", "assert": "contains", "value": "a set due date" },

    { "type": "key", "label": "narrow both sections at once", "key": "/" },
    { "type": "key", "key": "m" },
    { "type": "key", "key": "o" },
    { "type": "key", "key": "n" },
    { "type": "key", "key": "t" },
    { "type": "key", "key": "h" },
    { "type": "key", "label": "apply the search", "key": "enter" },
    { "type": "key", "label": "start from the first surviving row", "key": "home" },
    { "type": "assert", "assert": "contains", "value": "In 30 days" },
    { "type": "assert", "assert": "contains", "value": "For 30 days" },
    { "type": "assert", "assert": "contains", "value": "a set due date" },
    { "type": "key", "label": "the switch lands on a row the search left on screen", "key": "tab" },
    { "type": "assert", "assert": "contains", "value": "a set defer date" },
    { "type": "assert", "label": "the query is the picker's, not the switch's, to clear", "assert": "contains", "value": "month" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "skip the Check-in section with no month matches", "key": "tab" },
    { "type": "assert", "assert": "contains", "value": "a set due date" },
    { "type": "key", "label": "skip the empty section backward too", "key": "shift+tab" },
    { "type": "assert", "assert": "contains", "value": "a set defer date" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "clear the search back to both whole sections", "key": "/" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },
    { "type": "key", "label": "narrow to a word only the due section carries", "key": "/" },
    { "type": "key", "key": "t" },
    { "type": "key", "key": "h" },
    { "type": "key", "key": "i" },
    { "type": "key", "key": "s" },
    { "type": "key", "key": "enter" },
    { "type": "key", "label": "start from the first surviving row", "key": "home" },
    { "type": "key", "label": "only one section matches, so Tab stays put", "key": "tab" },
    { "type": "assert", "label": "a single matching section keeps the cursor", "assert": "contains", "value": "a set due date" },
    { "type": "assert", "assert": "contains", "value": "Set Due, Defer, or Check-In: Build login form" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "leave the picker without writing a date", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "not_contains", "value": "Set Due, Defer, or Check-In" },
    { "type": "assert", "label": "Tab never reached the Outliner, so the mode is untouched", "assert": "contains", "value": "Active Projects · All" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
