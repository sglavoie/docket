{
  "name": "named-lens-machine-switch",
  "fixture": "multi-project",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "narrow the view before saving it", "key": "g" },
    { "type": "key", "key": "b" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · Backlog" },

    { "type": "key", "label": "save that projection as a lens", "key": "\\" },
    { "type": "key", "label": "Enter on the Save row asks for a name", "key": "enter" },
    { "type": "text", "text": "Desk Backlog" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Lens: Desk Backlog" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "leave the lens so the pointer is the only thing dropped", "key": "esc" },
    { "type": "wait" },
    { "type": "assert", "assert": "not_contains", "value": "Lens:" },

    { "type": "switch_machine", "label": "open the same workspace on a second machine" },
    { "type": "wait" },
    { "type": "assert", "label": "the clean launch root is what a second machine starts on", "assert": "contains", "value": "Active Projects · All" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the saved definition travelled with the workspace", "key": "\\" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Named Lenses" },
    { "type": "assert", "assert": "contains", "value": "Desk Backlog" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "and it still installs its whole projection here", "key": "1" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Lens: Desk Backlog" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · Backlog" },
    { "type": "assert", "label": "a lens applied on a new machine is not a modified one", "assert": "not_contains", "value": "Lens: Desk Backlog*" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "switch_machine", "label": "a third machine joins the same workspace" },
    { "type": "wait" },
    { "type": "assert", "label": "the active-lens pointer stayed on the machine that set it", "assert": "not_contains", "value": "Lens:" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · All" },

    { "type": "key", "key": "\\" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Desk Backlog" },
    { "type": "assert", "label": "no machine reseeded a starter over the workspace set", "assert": "count_contains", "value": "Waiting", "count": 1 },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
