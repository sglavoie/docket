{
  "name": "action-sheet-picker-cancel",
  "fixture": "rich",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "open the contextual action sheet", "key": "space" },
    { "type": "assert", "assert": "contains", "value": "Task Actions: Build login form" },
    { "type": "key", "label": "search the sheet", "key": "/" },
    { "type": "text", "label": "search for the removed structural action", "text": "move project" },
    { "type": "assert", "assert": "contains", "value": "No matching actions." },
    { "type": "assert", "assert": "contains", "value": "Clear or change the search." },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "clear the action filter", "key": "esc" },
    { "type": "assert", "assert": "contains", "value": "Task Actions: Build login form" },
    { "type": "assert", "label": "Delete is the whole task menu now", "assert": "contains", "value": "Delete" },
    { "type": "assert", "assert": "not_contains", "value": "Comments" },
    { "type": "assert", "label": "the search box is still open, so the next Esc leaves it", "assert": "contains", "value": "Esc cancel search" },
    { "type": "key", "label": "leave the search", "key": "esc" },
    { "type": "assert", "label": "browsing again: j/k move", "assert": "contains", "value": "Enter run · Esc close · j/k navigate" },
    { "type": "assert", "label": "and a sheet short enough to read whole does not advertise searching it", "assert": "not_contains", "value": "/ search" },
    { "type": "assert", "assert": "not_contains", "value": "Search:" },
    { "type": "key", "label": "j steps onto Delete without writing a query", "key": "j" },
    { "type": "assert", "assert": "contains", "value": "› Delete  confirmation required" },
    { "type": "assert", "assert": "not_contains", "value": "Search:" },
    { "type": "key", "label": "and k steps back", "key": "k" },
    { "type": "assert", "assert": "contains", "value": "› Set Check-In" },
    { "type": "key", "label": "cancel the sheet", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "not_contains", "value": "Task Actions" },
    { "type": "assert", "assert": "contains", "value": "◐   [rich-project] Build login form" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the attachment sigil opens the panel directly", "key": "&" },
    { "type": "assert", "assert": "view", "value": "TaskAttachments" },
    { "type": "assert", "assert": "contains", "value": "Attachments" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "add a URL attachment", "key": "a" },
    { "type": "text", "text": "https://example.com/spec.pdf" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Space actions" },

    { "type": "resize", "label": "the regrown footer degrades rather than clipping", "width": 60, "height": 24 },
    { "type": "assert", "assert": "view", "value": "TaskAttachments" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "the sheet still opens on a minimum terminal", "key": "space" },
    { "type": "assert", "assert": "contains", "value": "Attachment Actions" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
