{
  "name": "filter-chord-hierarchy",
  "fixture": "rich",
  "size": "99x35",
  "actions": [
    { "type": "command", "label": "open Backlog, which launch folds, so the scenario reads the whole workspace", "command": "Clear All Folds" },
    { "type": "key", "label": "open the filter chord", "key": "f" },
    { "type": "assert", "label": "the which-key row offers the hierarchy facet", "assert": "contains", "value": "h hierarchy" },

    { "type": "key", "label": "open the hierarchy picker", "key": "h" },
    { "type": "assert", "assert": "contains", "value": "Filter by Hierarchy" },
    { "type": "assert", "assert": "contains", "value": "Parent" },
    { "type": "assert", "assert": "contains", "value": "has open children" },
    { "type": "assert", "assert": "contains", "value": "Child" },
    { "type": "assert", "assert": "contains", "value": "Root" },
    { "type": "assert", "assert": "contains", "value": "Leaf" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "keep only tasks with open children", "key": "enter" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "status_contains", "value": "Filtering hierarchy: parent" },
    { "type": "assert", "label": "the hierarchy badge joins the title row", "assert": "contains", "value": "?parent" },
    { "type": "assert", "label": "a task with open children stays", "assert": "contains", "value": "User authentication" },
    { "type": "assert", "label": "a childless task drops", "assert": "not_contains", "value": "Fix redirect loop after logout" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "reopen the picker seeded on the active value", "key": "f" },
    { "type": "key", "key": "h" },
    { "type": "key", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "contains", "value": "?parent" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "clear every facet with fx", "key": "f" },
    { "type": "key", "key": "x" },
    { "type": "assert", "assert": "status_contains", "value": "Filters cleared" },
    { "type": "assert", "assert": "not_contains", "value": "?parent" },
    { "type": "assert", "assert": "contains", "value": "Fix redirect loop after logout" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
