{
  "name": "capture-review",
  "fixture": "fresh",
  "size": "80x24",
  "actions": [
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "key", "label": "capture into Unfiled", "key": "a" },
    { "type": "assert", "assert": "view", "value": "TaskComposer" },
    { "type": "text", "label": "flag the task as it is created", "text": "Flagged task =review " },
    { "type": "assert", "label": "the content-sized panel grew to the grouped preview", "assert": "contains", "value": "Task     Flagged task" },
    { "type": "assert", "label": "the route row names the default destination", "assert": "contains", "value": "Status: Inbox" },
    { "type": "assert", "label": "the preview does not repeat it", "assert": "not_contains", "value": "(default)" },
    { "type": "assert", "assert": "not_contains", "value": "Route    " },
    { "type": "assert", "label": "the preview still names every recognized attribute", "assert": "contains", "value": "Review   =review" },
    { "type": "resize", "width": 60, "height": 20 },
    { "type": "assert", "label": "the floor keeps the route row and still repeats nothing", "assert": "contains", "value": "Status: Inbox" },
    { "type": "assert", "assert": "not_contains", "value": "(default)" },
    { "type": "assert", "assert": "contains", "value": "Review   =review" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "width": 80, "height": 24 },
    { "type": "key", "label": "commit the capture", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "status_contains", "value": "Add Task: #1 Flagged task" },
    { "type": "assert", "label": "the new task renders in the All-mode Review lane", "assert": "contains", "value": "Review  (1)" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "key": "home" },
    { "type": "key", "label": "past the Review section header", "key": "j" },
    { "type": "key", "label": "past the project header onto the flagged row", "key": "j" },
    { "type": "key", "label": "edit the row in place", "key": "e" },
    { "type": "assert", "assert": "contains", "value": "EDIT TASK" },
    { "type": "text", "label": "the clear form exists only on the edit surface", "text": " =unreview " },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "status_contains", "value": "Edit Task Line: #1 Flagged task" },
    { "type": "assert", "label": "the Review lane is gone", "assert": "not_contains", "value": "Review  (" },
    { "type": "assert", "label": "the task itself survived the clear", "assert": "contains", "value": "Flagged task" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "width": 60, "height": 20 },
    { "type": "key", "label": "a batch landing in one project", "key": "a" },
    { "type": "text", "text": "First line" },
    { "type": "key", "key": "shift+enter" },
    { "type": "text", "text": "Second line " },
    { "type": "assert", "assert": "contains", "value": "2 tasks · Line 2" },
    { "type": "assert", "label": "the route row names that project", "assert": "contains", "value": "Project: Unfiled" },
    { "type": "assert", "label": "so the batch draws no destination counts", "assert": "not_contains", "value": "To: " },
    { "type": "assert", "label": "and the preview no default route", "assert": "not_contains", "value": "(default)" },
    { "type": "assert", "assert": "contains", "value": "Task     Second line" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "text", "label": "an explicit destination is the line's own answer", "text": "$today " },
    { "type": "assert", "assert": "contains", "value": "Route    " },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
