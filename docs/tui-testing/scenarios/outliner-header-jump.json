{
  "name": "outliner-header-jump",
  "fixture": "multi-project",
  "size": "100x35",
  "actions": [
    { "type": "assert", "label": "the cursor opens on the Backlog section header", "assert": "contains", "value": "s sections" },

    { "type": "key", "label": "n steps onto the first row of the first project group", "key": "n" },
    { "type": "assert", "label": "an expanded group spends no row on a heading, so the stop is a task", "assert": "not_contains", "value": "s sections" },

    { "type": "key", "label": "n walks the remaining three group starts", "key": "n" },
    { "type": "key", "key": "n" },
    { "type": "key", "key": "n" },
    { "type": "assert", "assert": "not_contains", "value": "s sections" },

    { "type": "key", "label": "n past the last group wraps to the section header", "key": "n" },
    { "type": "assert", "assert": "contains", "value": "s sections" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "folding draws each group a summary header, which is the same stop", "key": "p" },
    { "type": "key", "key": "g" },
    { "type": "key", "key": "g" },
    { "type": "key", "key": "n" },
    { "type": "assert", "assert": "contains", "value": "# project tags" },
    { "type": "assert", "assert": "not_contains", "value": "s sections" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "unfold the groups again", "key": "p" },

    { "type": "key", "label": "the first group start is the first project's first task", "key": "g" },
    { "type": "key", "key": "g" },
    { "type": "key", "key": "n" },
    { "type": "key", "key": "y" },
    { "type": "assert", "assert": "clipboard_contains", "value": "Alpha migration kickoff" },

    { "type": "key", "label": "N from the section header wraps to the last group start", "key": "g" },
    { "type": "key", "key": "g" },
    { "type": "key", "key": "N" },
    { "type": "key", "key": "y" },
    { "type": "assert", "assert": "clipboard_contains", "value": "Finish the distributed systems book" },

    { "type": "key", "label": "slash opens the query as the flat ranked list, which holds no header", "key": "/" },
    { "type": "text", "text": "Alpha" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "n" },
    { "type": "assert", "assert": "status_contains", "value": "No sections to jump between" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the ranked toggle narrows the same query back into the mode", "key": "o" },
    { "type": "key", "key": "r" },
    { "type": "assert", "label": "the narrowed mode emits its own section header again", "assert": "contains", "value": "@ Backlog" },
    { "type": "key", "label": "and n reaches it", "key": "n" },
    { "type": "assert", "assert": "not_contains", "value": "No sections to jump between" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
