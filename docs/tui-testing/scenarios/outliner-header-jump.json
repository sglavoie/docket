{
  "name": "outliner-header-jump",
  "fixture": "multi-project",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "launch folds Backlog and seats the cursor on its header, so open it", "key": "l" },
    { "type": "key", "label": "then step onto the first task, which leads its singleton project group in place of a heading", "key": "j" },
    { "type": "key", "label": "the cursor stands on the first task", "key": "y" },
    { "type": "assert", "assert": "clipboard_contains", "value": "Alpha migration kickoff" },
    { "type": "assert", "label": "the cursor stands on that task rather than on a header", "assert": "not_contains", "value": "s sections" },

    { "type": "key", "label": "n walks the remaining three project groups, each starting at its merged task row", "key": "n" },
    { "type": "key", "key": "y" },
    { "type": "assert", "assert": "clipboard_contains", "value": "Beta rollout checklist" },
    { "type": "key", "key": "n" },
    { "type": "key", "key": "y" },
    { "type": "assert", "assert": "clipboard_contains", "value": "Renew passport" },
    { "type": "key", "key": "n" },
    { "type": "key", "key": "y" },
    { "type": "assert", "assert": "clipboard_contains", "value": "Finish the distributed systems book" },

    { "type": "key", "label": "n past the last header wraps to the section header", "key": "n" },
    { "type": "assert", "assert": "contains", "value": "s sections" },

    { "type": "key", "label": "N from the first header wraps to the last group", "key": "N" },
    { "type": "assert", "assert": "not_contains", "value": "s sections" },
    { "type": "key", "label": "proved by the row above it being the third group's task", "key": "k" },
    { "type": "key", "key": "y" },
    { "type": "assert", "assert": "clipboard_contains", "value": "Renew passport" },
    { "type": "key", "key": "j" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "slash opens the query as the flat ranked list, which holds no header", "key": "/" },
    { "type": "text", "text": "Alpha" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "n" },
    { "type": "assert", "assert": "status_contains", "value": "No sections to jump between" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the ranked toggle narrows the same query back into the mode", "key": "o" },
    { "type": "key", "key": "r" },
    { "type": "assert", "label": "the narrowed mode emits its own section header again", "assert": "contains", "value": "Backlog  (" },
    { "type": "key", "label": "and n reaches it", "key": "n" },
    { "type": "assert", "assert": "not_contains", "value": "No sections to jump between" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
