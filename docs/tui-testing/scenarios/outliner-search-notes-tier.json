{
  "name": "outliner-search-notes-tier",
  "fixture": "rich",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "search the entire active scope", "key": "/" },
    { "type": "text", "label": "a sigil-free query both a task and a note answer", "text": "launch" },
    { "type": "key", "label": "accept the query so the projection settles", "key": "enter" },
    { "type": "key", "label": "the notes tier is the flat ranked list's lowest tier", "key": "o" },
    { "type": "key", "key": "r" },
    { "type": "assert", "label": "the task match is still what the Outliner is for", "assert": "contains", "value": "Launch platform" },
    { "type": "assert", "assert": "contains", "value": "Workspace launch brief" },
    { "type": "assert", "assert": "contains", "value": "Rich Project delivery plan" },
    { "type": "assert", "label": "every note row names its location", "assert": "contains", "value": "[Global]" },
    { "type": "assert", "assert": "contains", "value": "[Rich Project]" },
    { "type": "assert", "label": "the tier cue attributes both note rows", "assert": "count_contains", "value": "· note", "count": 2 },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "the mixed result list at the narrowest supported width", "width": 60, "height": 20 },
    { "type": "assert", "assert": "contains", "value": "Rich Project delivery plan" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "and back", "width": 100, "height": 35 },
    { "type": "assert", "assert": "contains", "value": "Workspace launch brief" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "one row below the top lands on the first note, so the tier sits under every task match", "key": "j" },
    { "type": "key", "label": "Enter on a note row leaves the Outliner", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Notes" },
    { "type": "assert", "assert": "contains", "value": "All Notes" },
    { "type": "assert", "label": "the manager opened positioned on the row the cursor named, not on its own first row", "assert": "contains", "value": "Shared launch context for every active" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
