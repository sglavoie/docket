{
  "name": "outliner-inline-edit-dependency-undo",
  "fixture": "multi-project",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "move below the first section header", "key": "j" },
    { "type": "key", "label": "select the Client Alpha task", "key": "j" },
    { "type": "key", "label": "edit the selected row", "key": "e" },
    { "type": "assert", "assert": "contains", "value": "EDIT TASK" },
    { "type": "text", "label": "add the first reference", "text": " ~client-beta:1" },
    { "type": "key", "key": "tab" },
    { "type": "text", "label": "and a second one", "text": " ~home-errands:1" },
    { "type": "key", "key": "tab" },
    { "type": "key", "label": "commit the edit", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "~0/2" },

    { "type": "key", "label": "reopen the same row", "key": "e" },
    { "type": "assert", "label": "the inline buffer is a delta, so the stored set is stated beside it rather than dumped into it", "assert": "contains", "value": "EDIT TASK · [client-alpha] › root · backlog · ~2" },
    { "type": "text", "label": "strike one reference by name", "text": " -~home-errands:1" },
    { "type": "key", "key": "tab" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "label": "the count follows the stored set", "assert": "contains", "value": "~0/1" },
    { "type": "assert", "assert": "not_contains", "value": "~0/2" },
    { "type": "key", "label": "and Peek names what survived", "key": "b" },
    { "type": "assert", "assert": "contains", "value": "Dependencies 0/1: Client Beta #1 Beta rollout checklist (backlog)" },
    { "type": "assert", "assert": "not_contains", "value": "Renew passport (backlog)" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the removal is one ordinary transaction", "key": "u" },
    { "type": "assert", "assert": "status_contains", "value": "Undid" },
    { "type": "assert", "assert": "contains", "value": "~0/2" },
    { "type": "key", "key": "ctrl+r" },
    { "type": "assert", "assert": "status_contains", "value": "Redo: Edit Task Line" },
    { "type": "assert", "assert": "contains", "value": "~0/1" },

    { "type": "key", "label": "the clear form drops the whole set at once", "key": "e" },
    { "type": "text", "text": " ~0" },
    { "type": "assert", "label": "the clear form is offered by the same completion that offers targets", "assert": "contains", "value": "~0 (Clear dependencies)" },
    { "type": "key", "key": "tab" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "label": "a task storing nothing carries no count", "assert": "not_contains", "value": "~0/1" },
    { "type": "key", "key": "b" },
    { "type": "assert", "assert": "not_contains", "value": "Dependencies " },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "b" },
    { "type": "key", "label": "and the clear is undoable like any other edit", "key": "u" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "~0/1" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
