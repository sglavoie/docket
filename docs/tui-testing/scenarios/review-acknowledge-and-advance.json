    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "task has no review to acknowledge" },
    { "type": "assert", "label": "and the refusal moved nothing", "assert": "contains", "value": "Backlog  (3)" },

    { "type": "key", "label": "raise it deliberately instead", "key": "=" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Review  (1)" },
    { "type": "assert", "assert": "contains", "value": "Backlog  (2)" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "onto the second untouched task, still in Backlog", "key": "home" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "label": "raise that one too", "key": "=" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Review  (2)" },
    { "type": "assert", "assert": "contains", "value": "Backlog  (1)" },
    { "type": "assert", "assert": "not_contains", "value": "Stale  (" },

    { "type": "key", "label": "onto the first flagged candidate", "key": "home" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "label": "acknowledge it", "key": "R" },
    { "type": "assert", "assert": "status_contains", "value": "Mark Reviewed" },
    { "type": "wait" },
    { "type": "assert", "label": "answering it takes it out of the lane", "assert": "contains", "value": "Review  (1)" },
    { "type": "assert", "assert": "contains", "value": "Renew untouched vendor briefing" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the pass advanced, so this answers the second candidate", "key": "R" },
    { "type": "assert", "label": "the last candidate says the pass is over", "assert": "status_contains", "value": "No further visible review candidates" },
    { "type": "wait" },
    { "type": "assert", "label": "nothing is left in the lane", "assert": "not_contains", "value": "Review  (" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the source kept the cursor, and it is no longer a candidate", "key": "R" },
    { "type": "assert", "assert": "contains", "value": "task has no review to acknowledge" },
    { "type": "assert", "assert": "contains", "value": "Revisit dormant launch checklist" },
    { "type": "assert", "assert": "contains", "value": "Renew untouched vendor briefing" },

    { "type": "key", "label": "undo takes the second acknowledgement back", "key": "u" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Review  (1)" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "widest committed size", "width": 160, "height": 55 },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "the 60x20 minimum", "width": 60, "height": 20 },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
