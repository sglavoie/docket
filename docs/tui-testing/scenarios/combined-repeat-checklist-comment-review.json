{
  "name": "combined-repeat-checklist-comment-review",
  "fixture": "checklist",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "launch folds Backlog and seats the cursor on its header, so open the lane", "key": "l" },
    { "type": "key", "label": "onto the project header", "key": "j" },
    { "type": "key", "label": "onto the first task", "key": "j" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "key", "label": "Peek is where the checklist the repeat will copy is legible", "key": "b" },
    { "type": "assert", "assert": "contains", "value": "Checklist: 1/3 done" },
    { "type": "key", "label": "close Peek", "key": "b" },

    { "type": "key", "label": "D repeats it through a fresh expanded draft", "key": "D" },
    { "type": "assert", "assert": "view", "value": "TaskComposer" },
    { "type": "assert", "assert": "contains", "value": "Repeat Task" },
    { "type": "assert", "label": "the title is seeded, so the source reads back verbatim", "assert": "contains", "value": "Draft the launch runbook" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "text", "label": "give the copy its own name so every later row check names one task", "text": " second pass" },
    { "type": "key", "label": "the expanded form saves on Ctrl+S", "key": "ctrl+s" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "contains", "value": "Draft the launch runbook second pass" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "a repeat appends at the root, so the end of the list is the copy", "key": "G" },
    { "type": "key", "label": "Peek says the checklist came across unticked", "key": "b" },
    { "type": "assert", "assert": "contains", "value": "Checklist: 0/3 done" },
    { "type": "key", "label": "close Peek", "key": "b" },
    { "type": "key", "label": "back to the source it was copied from", "key": "home" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "b" },
    { "type": "assert", "label": "which is untouched", "assert": "contains", "value": "Checklist: 1/3 done" },
    { "type": "key", "label": "close Peek", "key": "b" },
    { "type": "key", "label": "back onto the copy", "key": "G" },
    { "type": "key", "label": "C appends a comment without leaving the list", "key": "C" },
    { "type": "assert", "assert": "contains", "value": "Add Comment" },
    { "type": "assert", "label": "the popup froze the copy, not the source it was made from", "assert": "contains", "value": "Draft the launch runbook second pass" },
    { "type": "text", "text": "Carried over from the first pass" },
    { "type": "key", "key": "ctrl+s" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "key", "label": "the comment count is Peek's, not the row's", "key": "b" },
    { "type": "assert", "assert": "contains", "value": "Comments: 1" },
    { "type": "key", "label": "close Peek", "key": "b" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "c appends a fourth item to the checklist the repeat copied", "key": "c" },
    { "type": "assert", "assert": "contains", "value": "Add Checklist Item" },
    { "type": "text", "text": "Re-run the smoke pass" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "[ ] Re-run the smoke pass" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the reveal left the cursor on the new item; climb back over the four", "key": "k" },
    { "type": "key", "key": "k" },
    { "type": "key", "key": "k" },
    { "type": "key", "key": "k" },
    { "type": "key", "label": "a resume note near the stored limit is what forces the detail to page", "key": "r" },
    { "type": "text", "text": "RESUMESTART w001 w002 w003 w004 w005 w006 w007 w008 w009 w010 w011 w012 w013 w014 w015 w016 w017 w018 w019 w020 w021 w022 w023 w024 w025 w026 w027 w028 w029 w030 w031 w032 w033 w034 w035 w036 w037 w038 w039 w040 w041 w042 w043 RESUMEEND" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },

    { "type": "resize", "label": "this frame both narrows the wrap and gives the dock nine rows, so the detail outgrows its seven-row window", "width": 80, "height": 30 },
    { "type": "key", "label": "b inspects the detail every one of those writes fed", "key": "b" },
    { "type": "assert", "assert": "contains", "value": "Resume: RESUMESTART" },
    { "type": "assert", "label": "the position row says what the window has no room for", "assert": "contains", "value": "0 above · 2 below" },
    { "type": "assert", "label": "so the last of the supporting detail waits for a page turn", "assert": "not_contains", "value": "Tags: " },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "page forward to the tail", "key": "ctrl+f" },
    { "type": "key", "key": "ctrl+f" },
    { "type": "assert", "assert": "contains", "value": "2 above · 0 below" },
    { "type": "assert", "label": "the comment this pass added is named there", "assert": "contains", "value": "Comments: 1" },
    { "type": "assert", "label": "Peek names the checklist as a count, whatever the repeat copied", "assert": "contains", "value": "Checklist: 0/4 done" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "Esc dismisses Peek before Outliner navigation", "key": "esc" },
    { "type": "assert", "assert": "not_contains", "value": "RESUMESTART" },

    { "type": "key", "label": "= flags the copy for review", "key": "=" },
    { "type": "wait" },
    { "type": "assert", "label": "the flag promotes an All-mode lane", "assert": "contains", "value": "Review" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the flag moved the row to the lane it promoted, so the cursor kept sweeping the one it left", "key": "home" },
    { "type": "key", "label": "past the lane's project header", "key": "j" },
    { "type": "key", "label": "onto the flagged row", "key": "j" },
    { "type": "key", "label": "R acknowledges the one candidate the pass has", "key": "R" },
    { "type": "wait" },
    { "type": "assert", "label": "clearing the flag retires the lane it promoted", "assert": "not_contains", "value": "Review  (" },
    { "type": "key", "label": "and the acknowledgement touched nothing else the pass wrote", "key": "b" },
    { "type": "key", "key": "ctrl+f" },
    { "type": "key", "key": "ctrl+f" },
    { "type": "key", "key": "ctrl+f" },
    { "type": "assert", "assert": "contains", "value": "Comments: 1" },
    { "type": "assert", "assert": "contains", "value": "Checklist: 0/4 done" },
    { "type": "key", "label": "close Peek", "key": "esc" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "the 60x20 minimum still draws the whole combined state", "width": 60, "height": 20 },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "widest committed size", "width": 160, "height": 55 },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
