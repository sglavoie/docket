{
  "name": "defer-hour-presets",
  "fixture": "rich",
  "size": "72x20",
  "actions": [
    { "type": "command", "label": "open Backlog, which launch folds, so the scenario reads the whole workspace", "command": "Clear All Folds" },
    { "type": "key", "label": "open the go-to chord", "key": "g" },
    { "type": "key", "label": "jump straight to Inbox", "key": "i" },
    { "type": "key", "label": "step off the project group header onto the first task", "key": "j" },

    { "type": "key", "label": "open the one date picker", "key": "@" },
    { "type": "assert", "assert": "contains", "value": "Set Due, Defer, or Check-In: Triage support inbox" },
    { "type": "assert", "label": "due leads, because a deadline is the commoner answer", "assert": "contains", "value": "DUE" },
    { "type": "assert", "assert": "contains", "value": "Clear" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "step past the five due rows onto Clear defer", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "assert", "label": "the defer section scrolls into view", "assert": "contains", "value": "DEFER" },
    { "type": "assert", "assert": "contains", "value": "Clear defer" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "key": "j" },
    { "type": "key", "label": "highlight In 4 hours, two rows below Clear defer", "key": "j" },
    { "type": "assert", "label": "the instant rows a deferral alone can express", "assert": "contains", "value": "In 1 hour" },
    { "type": "assert", "assert": "contains", "value": "In 4 hours" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "commit the four-hour deferral", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "status_contains", "value": "Defer" },
    { "type": "assert", "label": "a same-day deferral hides the row now rather than at midnight", "assert": "not_contains", "value": "Triage support inbox" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "deferring also backlogs the task, so look for it in All", "key": "g" },
    { "type": "key", "key": "a" },
    { "type": "key", "label": "open the filter chord", "key": "f" },
    { "type": "key", "label": "the deferred facet is a row on the due picker", "key": "@" },
    { "type": "key", "key": "down" },
    { "type": "key", "key": "down" },
    { "type": "key", "key": "down" },
    { "type": "key", "label": "highlight Deferred only, below the four due-date rows", "key": "down" },
    { "type": "key", "label": "isolate the pending deferrals", "key": "enter" },
    { "type": "assert", "label": "the hidden task is still there, named by the facet rather than by a row marker", "assert": "contains", "value": "Triage support inbox" },
    { "type": "assert", "assert": "not_contains", "value": "Triage support inbox defer" },
    { "type": "key", "label": "onto the deferred row", "key": "end" },
    { "type": "key", "label": "Peek is where the wake time lives now", "key": "b" },
    { "type": "assert", "assert": "contains", "value": "Defer: " },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "close Peek", "key": "esc" },

    { "type": "key", "label": "reopen the filter chord", "key": "f" },
    { "type": "key", "label": "clear every facet", "key": "x" },
    { "type": "key", "label": "undo the deferral", "key": "u" },
    { "type": "wait" },
    { "type": "key", "label": "back to Inbox, where the task started", "key": "g" },
    { "type": "key", "key": "i" },
    { "type": "assert", "label": "undo restores the row to ordinary triage, which a still-deferred task could not reach", "assert": "contains", "value": "Triage support inbox" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
