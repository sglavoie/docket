    { "type": "assert", "label": "the departure sweep landed on the neighbor", "assert": "count_contains", "value": "Alpha keep", "count": 2 },
    { "type": "assert", "label": "a visible task wears no hidden marker", "assert": "not_contains", "value": "(hidden)" },
    { "type": "key", "key": "b" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "open the filter chord", "key": "f" },
    { "type": "key", "label": "narrow to hidden tasks", "key": "H" },
    { "type": "wait" },
    { "type": "assert", "label": "only the hidden task is drawn", "value": "Beta stash", "assert": "contains" },
    { "type": "assert", "value": "Alpha keep", "assert": "not_contains" },
    { "type": "key", "label": "open the query readout", "key": "Q" },
    { "type": "assert", "label": "the readout spells the canonical clause", "value": "+hidden:only", "assert": "contains" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "home" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "label": "Peek the hidden task", "key": "b" },
    { "type": "assert", "label": "Peek marks it", "value": "(hidden)", "assert": "contains" },
    { "type": "key", "label": "close Peek", "key": "b" },
    { "type": "key", "key": "w" },
    { "type": "key", "label": "unhide it under fH, which departs it too", "key": "h" },
    { "type": "wait" },
    { "type": "assert", "value": "Unhidden 1 task · u undo", "assert": "status_contains" },
    { "type": "assert", "label": "fH with nothing hidden explains itself", "value": "Nothing hidden here. Press wh on a task to hide it.", "assert": "contains" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "width": 60, "height": 20 },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "width": 80, "height": 24 },
    { "type": "key", "label": "leave fH", "key": "f" },
    { "type": "key", "key": "H" },
    { "type": "wait" },
    { "type": "assert", "label": "both tasks are back", "value": "Beta stash", "assert": "contains" },
    { "type": "assert", "value": "Alpha keep", "assert": "contains" },
    { "type": "key", "key": "home" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "w" },
    { "type": "key", "label": "hide it again", "key": "h" },
    { "type": "wait" },
    { "type": "assert", "assert": "not_contains", "value": "Beta stash" },
    { "type": "key", "label": "one u takes the hide back", "key": "u" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Beta stash" },
    { "type": "assert", "assert": "contains", "value": "workspace: inbox 2" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
