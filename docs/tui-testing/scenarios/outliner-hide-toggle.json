    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Alpha keep" },
    { "type": "assert", "assert": "contains", "value": "Beta stash" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "home" },
    { "type": "key", "key": "j" },
    { "type": "key", "label": "onto the task to hide", "key": "j" },
