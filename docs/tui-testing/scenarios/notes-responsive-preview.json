{
  "name": "notes-responsive-preview",
  "fixture": "rich",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "open All Notes wide enough for two panes", "key": "ctrl+n" },
    { "type": "assert", "assert": "view", "value": "GlobalNotes" },
    { "type": "assert", "label": "the pane opens at the top of the cursor note's body", "assert": "contains", "value": "Track the authentication" },
    { "type": "assert", "label": "Markdown is rendered, not shown: a list item is a bullet", "assert": "contains", "value": "• Checkpoint 01 confirms the staged" },
    { "type": "assert", "label": "a body taller than the pane says how much is below", "assert": "contains", "value": "↓" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "page the body down", "key": "ctrl+f" },
    { "type": "assert", "assert": "not_contains", "value": "Track the authentication" },
    { "type": "assert", "assert": "contains", "value": "↑" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "and back", "key": "ctrl+b" },
    { "type": "assert", "assert": "contains", "value": "Track the authentication" },

    { "type": "key", "label": "the pane follows the cursor", "key": "j" },
    { "type": "assert", "assert": "contains", "value": "Shared launch context for every active" },
    { "type": "assert", "assert": "not_contains", "value": "Checkpoint 01" },
    { "type": "key", "label": "coming back reopens at the top rather than at the old offset", "key": "k" },
    { "type": "assert", "assert": "contains", "value": "Track the authentication" },

    { "type": "key", "label": "search the bodies", "key": "/" },
    { "type": "text", "text": "kestrel" },
    { "type": "key", "label": "accept the persistent search", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "1 of 2 notes match \"kestrel\" in All Notes" },
    { "type": "assert", "assert": "contains", "value": "· body" },
    { "type": "assert", "label": "the pane opened on the match, not at the top", "assert": "contains", "value": "kestrel runbook" },
    { "type": "assert", "assert": "not_contains", "value": "Checkpoint 01" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "clearing the query is an anchor change, so the pane reopens at the top", "key": "esc" },
    { "type": "assert", "assert": "contains", "value": "Track the authentication" },
    { "type": "assert", "assert": "not_contains", "value": "kestrel runbook" },

    { "type": "key", "label": "paging is claimed ahead of the search input", "key": "/" },
    { "type": "text", "text": "checkpoint" },
    { "type": "key", "key": "ctrl+f" },
    { "type": "assert", "label": "the press paged the body instead of typing, accepting, or cancelling", "assert": "contains", "value": "Search: > checkpoint" },
    { "type": "assert", "assert": "contains", "value": "↑" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "cancel the draft", "key": "esc" },

    { "type": "resize", "label": "the exact width two panes need", "width": 72, "height": 35 },
    { "type": "assert", "assert": "contains", "value": "Track the authentication" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "one column below it, where the list takes the whole width", "width": 71, "height": 35 },
    { "type": "assert", "assert": "not_contains", "value": "Track the authentication" },
    { "type": "assert", "assert": "contains", "value": "Rich Project delivery plan" },
    { "type": "assert", "assert": "contains", "value": "Workspace launch brief" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "the app's own minimum, which carries no pane", "width": 60, "height": 20 },
    { "type": "assert", "assert": "not_contains", "value": "Track the authentication" },
    { "type": "assert", "assert": "contains", "value": "Rich Project delivery plan" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "help never advertises a pane this terminal has no room for", "key": "?" },
    { "type": "assert", "assert": "not_contains", "value": "Page note preview" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "?" },

    { "type": "resize", "label": "wide enough for the whole footer", "width": 160, "height": 50 },
    { "type": "assert", "label": "the hint appears only where the pane does", "assert": "contains", "value": "Ctrl+F/B preview" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "?" },
    { "type": "assert", "assert": "contains", "value": "Page note preview" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "?" },
    { "type": "assert", "assert": "view", "value": "GlobalNotes" },
    { "type": "key", "label": "close Notes", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" }
  ]
}
