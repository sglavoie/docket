{
  "name": "search-negation-and-derived",
  "fixture": "multi-project",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "launch folds Backlog and seats the cursor on its header, so open the lane", "key": "l" },
    { "type": "key", "label": "onto the Client Alpha group header", "key": "j" },
    { "type": "key", "label": "onto Client Alpha's task", "key": "j" },
    { "type": "key", "label": "edit the selected row", "key": "e" },
    { "type": "assert", "assert": "contains", "value": "EDIT TASK" },
    { "type": "text", "label": "give the row a priority and a tag to search against", "text": " !2 #urgent" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },

    { "type": "key", "label": "the threshold reads N and above, and above means more urgent", "key": "/" },
    { "type": "text", "text": "!2+" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Alpha migration kickoff" },
    { "type": "assert", "label": "an unprioritized task is not more urgent", "assert": "not_contains", "value": "Renew passport" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },

    { "type": "key", "label": "the tag negation removes exactly what the tag selects", "key": "/" },
    { "type": "text", "text": "-#urgent" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "not_contains", "value": "□ Alpha migration kickoff" },
    { "type": "assert", "assert": "contains", "value": "Renew passport" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },

    { "type": "key", "label": "and so does the state negation, over the whole population", "key": "/" },
    { "type": "text", "label": "the negation completes from its twin's vocabulary", "text": "-$back" },
    { "type": "key", "label": "accept the completed destination", "key": "tab" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "No tasks match search \"-$backlog" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },

    { "type": "key", "label": "a derived property is computed rather than stored", "key": "/" },
    { "type": "text", "text": "?leaf" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Renew passport" },
    { "type": "assert", "assert": "contains", "value": "Finish the distributed systems book" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },

    { "type": "key", "label": "nothing here has an open child", "key": "/" },
    { "type": "text", "text": "?parent" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "No tasks match search \"?parent\"" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },

    { "type": "key", "label": "a qualifier belongs to the completion question alone", "key": "/" },
    { "type": "text", "text": "?stale:90d" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "?stale takes no value" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
