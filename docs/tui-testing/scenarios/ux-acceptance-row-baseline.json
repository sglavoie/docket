    { "type": "assert", "assert": "contains", "value": "▪ 1" },
    { "type": "assert", "assert": "contains", "value": "⊕ 1" },
    { "type": "assert", "label": "the reference counter counts stored locators", "assert": "contains", "value": "~0/1" },
