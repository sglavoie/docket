    { "type": "assert", "assert": "contains", "value": "⊡ Today" },
    { "type": "assert", "assert": "contains", "value": "waiting 9d" },
    { "type": "assert", "assert": "contains", "value": "doing now" },
    { "type": "assert", "label": "context and tags are row segments today", "assert": "contains", "value": "[finance]" },
    { "type": "assert", "assert": "contains", "value": "#audit #billing" },

