    { "type": "assert", "assert": "contains", "value": "▾  @ Waiting  (2)" },

    { "type": "assert", "label": "each lane opens its own expanded project header for the same project", "assert": "count_contains", "value": "[ux-platform-delivery]", "count": 6 },
