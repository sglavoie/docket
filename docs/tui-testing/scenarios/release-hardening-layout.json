    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "narrow Finder with double-width text", "width": 60, "height": 20 },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "return to the large Outliner", "key": "esc" },
