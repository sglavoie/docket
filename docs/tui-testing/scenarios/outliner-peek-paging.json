{
  "name": "outliner-peek-paging",
  "fixture": "rich",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "land on the task whose detail will outgrow one page", "key": "home" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "assert", "label": "the cursor names the task the detail belongs to", "assert": "contains", "value": "Add password validation" },
    { "type": "key", "label": "a resume note near the stored limit is what forces the paging", "key": "r" },
    { "type": "text", "text": "RESUMESTART w001 w002 w003 w004 w005 w006 w007 w008 w009 w010 w011 w012 w013 w014 w015 w016 w017 w018 w019 w020 w021 w022 w023 w024 w025 w026 w027 w028 w029 w030 w031 w032 w033 w034 w035 w036 w037 w038 w039 w040 w041 w042 w043 RESUMEEND" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },

    { "type": "key", "label": "open Peek on the overlong detail", "key": "b" },
    { "type": "assert", "label": "the body leads with the resume note", "assert": "contains", "value": "Resume: RESUMESTART" },
    { "type": "assert", "label": "the note wraps rather than being cut at the pane", "assert": "contains", "value": "w013" },
    { "type": "assert", "label": "a paged document spends one row saying what is off screen", "assert": "contains", "value": "0 above · 5 below" },
    { "type": "assert", "label": "so the tail of the body waits for a page turn", "assert": "not_contains", "value": "Tags: #backend #security" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "page forward through the rest of the detail", "key": "ctrl+f" },
    { "type": "assert", "label": "the last row of the previous page is carried over as the overlap", "assert": "contains", "value": "Resume: RESUMESTART" },
    { "type": "assert", "label": "the counter now names rows in both directions", "assert": "contains", "value": "3 above · 2 below" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "a second page turn clamps on the document end", "key": "ctrl+f" },
    { "type": "assert", "label": "and the rows the first page had no room for are readable in full", "assert": "contains", "value": "Context: [platform]" },
    { "type": "assert", "assert": "contains", "value": "Tags: #backend #security" },
    { "type": "assert", "assert": "contains", "value": "5 above · 0 below" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "paging back returns the page it started on", "key": "ctrl+b" },
    { "type": "key", "key": "ctrl+b" },
    { "type": "assert", "assert": "contains", "value": "Resume: RESUMESTART" },
    { "type": "assert", "assert": "contains", "value": "0 above · 5 below" },

    { "type": "key", "label": "read to the end again, then change the layout under it", "key": "ctrl+f" },
    { "type": "key", "key": "ctrl+f" },
    { "type": "assert", "assert": "contains", "value": "5 above · 0 below" },
    { "type": "resize", "width": 60, "height": 20 },
    { "type": "assert", "label": "a resize resets to the first page rather than keeping a stale one", "assert": "contains", "value": "Resume: RESUMESTART" },
    { "type": "assert", "label": "and the minimum terminal draws Peek inside its own budget", "assert": "no_layout_issues" },

    { "type": "key", "label": "Esc dismisses Peek before Outliner navigation", "key": "esc" },
    { "type": "assert", "assert": "not_contains", "value": "RESUMESTART" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
