    { "type": "text", "label": "an expression the presets cannot reach", "text": "nonsense" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "label": "a parse failure keeps the input open instead of committing", "assert": "contains", "value": "Set a Specific Date" },

    { "type": "key", "label": "leave typed entry for the preset list", "key": "esc" },
    { "type": "assert", "assert": "not_contains", "value": "Set a Specific Date" },
    { "type": "assert", "assert": "contains", "value": "Set Due Date: Build login form" },

    { "type": "key", "label": "re-enter typed entry", "key": "a" },
    { "type": "text", "text": "2027-03-15" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "status_contains", "value": "Set Due Date" },
    { "type": "assert", "label": "the typed date reaches the row through the ordinary payload", "assert": "contains", "value": "Mar 15 '27" },
    { "type": "assert", "assert": "no_layout_issues" },

