    { "type": "assert", "assert": "contains", "value": "Set a Specific Date" },
    { "type": "text", "label": "a relative offset the presets do not carry", "text": "+3d" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "status_contains", "value": "Defer" },
