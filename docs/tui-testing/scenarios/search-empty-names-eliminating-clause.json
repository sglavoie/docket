{
  "name": "search-empty-names-eliminating-clause",
  "fixture": "ux-acceptance",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "open search", "key": "/" },
    { "type": "text", "label": "words one task holds, narrowed by a deadline it lacks", "text": "duplicate @overdue" },
    { "type": "assert", "assert": "not_contains", "value": "Triage the duplicate support tickets" },
    { "type": "assert", "label": "the empty result names the clause that removed the match", "assert": "contains", "value": "1 task matches \"duplicate\"; @overdue removes it." },
    { "type": "assert", "label": "the exit still comes from the search's own clause", "assert": "contains", "value": "Esc to clear." },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "the longer sentence wraps at the minimum terminal", "width": 60, "height": 20 },
    { "type": "assert", "assert": "contains", "value": "@overdue removes it." },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "width": 100, "height": 35 },

    { "type": "key", "label": "clear the query", "key": "ctrl+u" },
    { "type": "text", "label": "a tag no task carries", "text": "onboarding #nope" },
    { "type": "assert", "label": "an unknown value is named rather than loosened", "assert": "contains", "value": "No task carries #nope." },

    { "type": "key", "label": "clear the query", "key": "ctrl+u" },
    { "type": "text", "label": "a project slug nothing has", "text": "onboarding %nowhere" },
    { "type": "assert", "assert": "contains", "value": "No project matches %nowhere." },

    { "type": "key", "label": "clear the query", "key": "ctrl+u" },
    { "type": "text", "label": "two clauses, one responsible", "text": "billing #audit !3" },
    { "type": "assert", "label": "with several clauses the general form names the one to drop", "assert": "contains", "value": "1 task matches without !3." },

    { "type": "key", "label": "clear the query", "key": "ctrl+u" },
    { "type": "text", "label": "words nothing holds", "text": "zzqx #audit" },
    { "type": "assert", "label": "no single clause is responsible, so none is named", "assert": "contains", "value": "No tasks match search \"zzqx #audit\". Press Esc to clear." },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
