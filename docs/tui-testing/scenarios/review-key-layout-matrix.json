{
  "name": "review-key-layout-matrix",
  "fixture": "multi-project",
  "size": "60x20",
  "actions": [
    { "type": "assert", "label": "no review lane before anything is flagged", "assert": "not_contains", "value": "@ Review" },

    { "type": "key", "label": "step past the Backlog section header onto the first task", "key": "j" },
    { "type": "key", "label": "the root key writes the flag the =review sigil writes", "key": "=" },
    { "type": "wait" },
    { "type": "assert", "assert": "status_contains", "value": "Toggle Review" },
    { "type": "assert", "label": "the flag promotes the task into the All-mode lane", "assert": "contains", "value": "@ Review" },
    { "type": "assert", "label": "the lane claims the row rather than copying it", "assert": "count_contains", "value": "□ Alpha migration kickoff       [client-alpha]", "count": 1 },
    { "type": "assert", "label": "the lane and its strip fit the app's own minimum", "assert": "no_layout_issues" },

    { "type": "key", "label": "the same state in the light theme", "key": "T" },
    { "type": "assert", "assert": "status_contains", "value": "Theme: light" },
    { "type": "assert", "assert": "contains", "value": "@ Review" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "and at the widest committed size", "width": 160, "height": 55 },
    { "type": "assert", "assert": "contains", "value": "@ Review" },
    { "type": "assert", "assert": "count_contains", "value": "□ Alpha migration kickoff             [client-alpha]", "count": 1 },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "back to dark, still wide", "key": "T" },
    { "type": "assert", "assert": "status_contains", "value": "Theme: dark" },
    { "type": "assert", "assert": "contains", "value": "@ Review" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "width": 60, "height": 20 },
    { "type": "key", "label": "one ledger entry takes the flag back", "key": "u" },
    { "type": "wait" },
    { "type": "assert", "label": "the lane empties with it", "assert": "not_contains", "value": "@ Review" },
    { "type": "assert", "assert": "count_contains", "value": "□ Alpha migration kickoff             [client-alpha]", "count": 1 },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
