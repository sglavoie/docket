{
  "name": "search-compose-filters",
  "fixture": "rich",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "search first, then narrow the results", "key": "/" },
    { "type": "text", "text": "login" },
    { "type": "key", "label": "accept the query so the chords reach the projection", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Search: \"login\"" },
    { "type": "assert", "assert": "contains", "value": "Build login form" },
    { "type": "assert", "assert": "contains", "value": "Explore social login" },
    { "type": "assert", "assert": "not_contains", "value": "Triage support inbox" },
    { "type": "assert", "label": "slash opened the flat ranked list, which has no lanes to show", "assert": "not_contains", "value": "@ Doing" },

    { "type": "key", "label": "the ranked toggle narrows the same query back into the mode", "key": "o" },
    { "type": "key", "key": "r" },
    { "type": "assert", "assert": "status_contains", "value": "Ranked list off · results narrow the mode" },
    { "type": "assert", "label": "narrowing leaves the mode standing, so its lanes decide the rows again", "assert": "contains", "value": "@ Doing" },
    { "type": "assert", "assert": "contains", "value": "@ Someday" },
    { "type": "assert", "assert": "contains", "value": "Build login form" },
    { "type": "assert", "assert": "contains", "value": "Explore social login" },

    { "type": "key", "label": "the order axis reorders the narrowed rows in place", "key": "o" },
    { "type": "key", "key": "@" },
    { "type": "assert", "assert": "status_contains", "value": "Sorting by" },
    { "type": "assert", "assert": "contains", "value": "Sort:" },
    { "type": "assert", "assert": "contains", "value": "Build login form" },

    { "type": "key", "label": "and a row facet gates the same projection", "key": "f" },
    { "type": "key", "key": "!" },
    { "type": "key", "key": "1" },
    { "type": "assert", "assert": "status_contains", "value": "Filtering High priority" },
    { "type": "assert", "label": "both composed segments are on the title at once", "assert": "contains", "value": "Search: \"login\"" },
    { "type": "assert", "assert": "contains", "value": "!1+" },
    { "type": "assert", "assert": "contains", "value": "Sort:" },
    { "type": "assert", "label": "the facet is an AND gate over the query", "assert": "not_contains", "value": "Build login form" },
    { "type": "assert", "assert": "not_contains", "value": "Explore social login" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "three title segments must survive a narrow terminal", "width": 80, "height": 24 },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "and the 60x20 minimum", "width": 60, "height": 20 },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "width": 100, "height": 35 },

    { "type": "key", "label": "Esc restores the pre-search facets and sort wholesale", "key": "esc" },
    { "type": "assert", "assert": "not_contains", "value": "Search:" },
    { "type": "assert", "assert": "not_contains", "value": "!1+" },
    { "type": "assert", "assert": "not_contains", "value": "Sort:" },
    { "type": "assert", "assert": "contains", "value": "Build login form" },
    { "type": "assert", "assert": "contains", "value": "Triage support inbox" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
