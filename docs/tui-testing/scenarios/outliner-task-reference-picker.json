{
  "name": "outliner-task-reference-picker",
  "fixture": "multi-project",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "launch folds Backlog and seats the cursor on its header, so open the lane", "key": "l" },
    { "type": "key", "label": "onto the Client Alpha group header", "key": "j" },
    { "type": "key", "label": "onto Client Alpha's task", "key": "j" },
    { "type": "key", "label": "store one cross-project reference the typed way", "key": "e" },
    { "type": "text", "text": " ~client-beta:1" },
    { "type": "key", "key": "tab" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Alpha migration kickoff ~0/1" },

    { "type": "key", "label": "open the reference picker on the row itself", "key": "~" },
    { "type": "assert", "assert": "contains", "value": "Set Dependencies: Alpha migration kickoff" },
    { "type": "assert", "label": "the stored half is preselected, because ~ declares both ~0 and -~task", "assert": "contains", "value": "[x] Beta rollout checklist" },
    { "type": "assert", "label": "and it is the only thing checked", "assert": "count_contains", "value": "[x] ", "count": 1 },
    { "type": "assert", "label": "every loaded project's open work is addressable", "assert": "contains", "value": "[ ] Renew passport" },
    { "type": "assert", "assert": "contains", "value": "[ ] Finish the distributed systems book" },
    { "type": "assert", "label": "a row is project-qualified by the category it sits under, never by repeating the name", "assert": "contains", "value": "CLIENT BETA" },
    { "type": "assert", "assert": "contains", "value": "HOME ERRANDS" },
    { "type": "assert", "assert": "contains", "value": "READING LIST" },
    { "type": "assert", "label": "the source task owns no row, so its project heads no category", "assert": "not_contains", "value": "CLIENT ALPHA" },
    { "type": "assert", "label": "a task may not reference itself, on either half of the picker", "assert": "not_contains", "value": "[ ] Alpha migration kickoff" },
    { "type": "assert", "assert": "not_contains", "value": "[x] Alpha migration kickoff" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "the overlay still fits the app's own minimum", "width": 60, "height": 20 },
    { "type": "assert", "assert": "contains", "value": "Set Dependencies: Alpha migration kickoff" },
    { "type": "assert", "assert": "contains", "value": "[x] Beta rollout checklist" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "and back, with the checked set intact across the resize", "width": 100, "height": 35 },
    { "type": "assert", "assert": "count_contains", "value": "[x] ", "count": 1 },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "unchecking the stored row is a removal, not a no-op", "key": "space" },
    { "type": "key", "key": "down" },
    { "type": "key", "label": "check one addition", "key": "space" },
    { "type": "key", "key": "down" },
    { "type": "key", "label": "and a second, in the same pass", "key": "space" },
    { "type": "assert", "assert": "count_contains", "value": "[x] ", "count": 2 },
    { "type": "assert", "assert": "contains", "value": "[ ] Beta rollout checklist" },
    { "type": "key", "label": "commit both halves of the diff at once", "key": "enter" },
    { "type": "wait" },

    { "type": "assert", "label": "one transaction, so one status line naming the ledger action", "assert": "status_contains", "value": "Set Dependencies: #1 Alpha migration kickoff" },
    { "type": "assert", "assert": "count_contains", "value": "Set Dependencies: #1 Alpha migration kickoff", "count": 1 },
    { "type": "assert", "label": "the count is over stored locators, and it moved", "assert": "contains", "value": "Alpha migration kickoff ~0/2" },
    { "type": "assert", "assert": "not_contains", "value": "Alpha migration kickoff ~0/1" },

    { "type": "resize", "label": "wide enough for one line to name both targets", "width": 140, "height": 35 },
    { "type": "key", "label": "Peek is the only surface that names them", "key": "b" },
    { "type": "assert", "assert": "contains", "value": "Dependencies 0/2: " },
    { "type": "assert", "assert": "contains", "value": "Home Errands #1 Renew passport (backlog)" },
    { "type": "assert", "assert": "contains", "value": "Reading List #1 Finish the distributed systems book (backlog)" },
    { "type": "assert", "label": "the unchecked row left the stored set, so only its own row still names it", "assert": "count_contains", "value": "Beta rollout checklist", "count": 1 },
    { "type": "assert", "label": "the reference is one-directional", "assert": "not_contains", "value": "Dependents " },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
