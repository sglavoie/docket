    { "type": "wait" },
    { "type": "key", "key": "home" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "label": "onto the oldest task, under the parent", "key": "j" },
    { "type": "key", "label": "indent it beneath the parent", "key": "]" },
