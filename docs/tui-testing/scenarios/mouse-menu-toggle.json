{
  "name": "mouse-menu-toggle",
  "fixture": "rich",
  "size": "100x40",
  "actions": [
    { "type": "assert", "label": "a launch with no setting asks the terminal for clicks and wheel steps", "assert": "mouse_mode", "value": "cell_motion" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "click", "label": "nothing answers the pointer yet, so a click is swallowed", "on": "Triage support inbox" },
    { "type": "wheel", "label": "and so is a wheel step", "x": 10, "y": 6, "delta": 3 },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "Ctrl+M opens the bar's first menu", "key": "ctrl+m" },
    { "type": "key", "label": "l walks along to View, where chrome lives", "key": "l" },
    { "type": "assert", "label": "checked means on, the way Advisories' box reads", "assert": "contains", "value": "✓ Mouse" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "click", "label": "a click outside the open menu puts it away and does nothing more", "x": 90, "y": 30 },
    { "type": "assert", "assert": "not_contains", "value": "✓ Mouse" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },

    { "type": "command", "label": "run the keyless row the menu just listed", "command": "Toggle Mouse" },
    { "type": "assert", "assert": "contains", "value": "Mouse off" },
    { "type": "assert", "label": "the next frame asks the terminal for nothing", "assert": "mouse_mode", "value": "none" },
    { "type": "key", "key": "ctrl+m" },
    { "type": "key", "key": "l" },
    { "type": "assert", "label": "the box follows the live state", "assert": "not_contains", "value": "✓ Mouse" },
    { "type": "assert", "assert": "contains", "value": "Mouse" },
    { "type": "key", "key": "esc" },

    { "type": "wait", "label": "let the toggle's transient status expire", "duration": "10s" },
    { "type": "restart", "label": "chrome follows the terminal, so the choice is machine-local and durable" },
    { "type": "assert", "label": "a relaunch still reports nothing", "assert": "mouse_mode", "value": "none" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "command", "label": "toggling back is what a user who turned it off by accident does", "command": "Toggle Mouse" },
    { "type": "assert", "assert": "contains", "value": "Mouse on" },
    { "type": "assert", "assert": "mouse_mode", "value": "cell_motion" },
    { "type": "resize", "label": "the floor still draws the toggle's status whole", "width": 60, "height": 20 },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "width": 100, "height": 40 },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
