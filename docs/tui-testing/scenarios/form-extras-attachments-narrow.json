{
  "name": "form-extras-attachments-narrow",
  "fixture": "fresh",
  "size": "72x20",
  "actions": [
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "key", "label": "capture into Unfiled", "key": "a" },
    { "type": "assert", "assert": "view", "value": "TaskComposer" },
    { "type": "text", "text": "Wire the Extras tab" },
    { "type": "key", "label": "expand into the full task form", "key": "ctrl+f" },
    { "type": "assert", "assert": "contains", "value": "Task Composer · Expanded" },
    { "type": "assert", "label": "the fourth tab is in the bar", "assert": "contains", "value": "Extras" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "wrap backward onto Extras", "key": "shift+left" },
    { "type": "assert", "assert": "contains", "value": "Attachments (0)" },
    { "type": "key", "label": "expand the collapsed section", "key": "a" },
    { "type": "assert", "assert": "contains", "value": "No attachments. Press Ctrl+L to add one." },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "add an attachment draft", "key": "ctrl+l" },
    { "type": "assert", "assert": "contains", "value": "Edit Attachment" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "text", "text": "https://example.com/spec.pdf" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Attachments (1)" },
    { "type": "assert", "assert": "contains", "value": "https://example.com/spec.pdf" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "save the task with its attachment draft", "key": "ctrl+s" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "status_contains", "value": "Add Task: #1 Wire the Extras tab" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "key": "home" },
    { "type": "key", "label": "past the Inbox section header", "key": "j" },
    { "type": "key", "label": "past the project header onto the new row", "key": "j" },
    { "type": "key", "label": "open the Attachments panel with its sigil key", "key": "&" },
    { "type": "assert", "assert": "view", "value": "TaskAttachments" },
    { "type": "assert", "label": "the draft committed in the same transaction as the task", "assert": "contains", "value": "1 attachment(s)" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
