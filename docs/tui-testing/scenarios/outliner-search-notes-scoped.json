{
  "name": "outliner-search-notes-scoped",
  "fixture": "rich",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "scope the Outliner to one project", "key": "P" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Rich Project · All" },

    { "type": "key", "label": "the same query the unscoped tier answers with two notes", "key": "/" },
    { "type": "text", "text": "launch" },
    { "type": "key", "key": "enter" },
    { "type": "key", "label": "the notes tier is the flat ranked list's lowest tier", "key": "o" },
    { "type": "key", "key": "r" },
    { "type": "assert", "assert": "contains", "value": "Launch platform" },
    { "type": "assert", "label": "the scope owns the notes tier too", "assert": "contains", "value": "Rich Project delivery plan" },
    { "type": "assert", "assert": "not_contains", "value": "Workspace launch brief" },
    { "type": "assert", "assert": "not_contains", "value": "[Global]" },
    { "type": "assert", "assert": "count_contains", "value": "· note", "count": 1 },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the tier is seated last, so the bottom row is the note", "key": "G" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "label": "a scoped search still opens the whole manager", "assert": "contains", "value": "All Notes" },
    { "type": "assert", "assert": "contains", "value": "Track the authentication milestone" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
