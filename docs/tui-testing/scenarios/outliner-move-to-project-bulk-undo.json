{
  "name": "outliner-move-to-project-bulk-undo",
  "fixture": "multi-project",
  "size": "100x35",
  "actions": [
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },

    { "type": "key", "label": "capture the first Unfiled task", "key": "a" },
    { "type": "assert", "label": "the launch cursor lends capture no project", "assert": "contains", "value": "Project: Unfiled" },
    { "type": "text", "text": "Sort the desk drawer" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },

    { "type": "key", "label": "capture the second", "key": "a" },
    { "type": "text", "text": "Book the dentist" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },

    { "type": "key", "label": "capture the third", "key": "a" },
    { "type": "text", "text": "Draft the quarterly note" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },

    { "type": "key", "label": "capture the one that stays behind", "key": "a" },
    { "type": "text", "text": "Cancel the gym trial" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },

    { "type": "key", "label": "Inbox mode holds the four captures alone", "key": "g" },
    { "type": "key", "key": "i" },
    { "type": "assert", "assert": "contains", "value": "[unfiled] (4)" },

    { "type": "key", "label": "start from the project header", "key": "home" },
    { "type": "key", "label": "step onto the newest capture", "key": "j" },
    { "type": "key", "label": "select it and enter multi-select", "key": "v" },
    { "type": "key", "key": "j" },
    { "type": "key", "label": "select a second", "key": "v" },
    { "type": "key", "key": "j" },
    { "type": "key", "label": "select a third, leaving the last row unselected", "key": "v" },
    { "type": "assert", "assert": "contains", "value": "Multi-select: 3 selected" },

    { "type": "key", "label": "open Move to Project over the whole selection", "key": "%" },
    { "type": "assert", "label": "one picker names the selection, not a task", "assert": "contains", "value": "Move to Project: 3 selected tasks" },
    { "type": "assert", "label": "the project the whole selection already shares is withheld", "assert": "not_contains", "value": "Unfiled  [unfiled]" },
    { "type": "assert", "assert": "contains", "value": "Client Alpha  [client-alpha]" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "choose Client Alpha", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "label": "one ledger entry covers the whole selection", "assert": "status_contains", "value": "Move to Project: 3 tasks → client-alpha · u undo" },
    { "type": "assert", "assert": "contains", "value": "[client-alpha] (3)" },
    { "type": "assert", "label": "the unselected capture stayed behind, alone, so it carries its project's label in place of a header", "assert": "contains", "value": "[unfiled] Sort the desk drawer" },
    { "type": "assert", "assert": "not_contains", "value": "[unfiled] (" },
    { "type": "assert", "label": "the move invalidated every identity the selection held", "assert": "not_contains", "value": "Multi-select" },

    { "type": "key", "label": "one undo takes the whole batch back", "key": "u" },
    { "type": "assert", "assert": "status_contains", "value": "Undid: Move to Project: 3 tasks → client-alpha" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "[unfiled] (4)" },
    { "type": "assert", "assert": "not_contains", "value": "[client-alpha]" },

    { "type": "key", "label": "redo the same one transaction", "key": "ctrl+r" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "[client-alpha] (3)" },
    { "type": "assert", "assert": "contains", "value": "[unfiled] Sort the desk drawer" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
