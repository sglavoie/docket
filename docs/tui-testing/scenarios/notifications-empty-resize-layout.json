{
  "name": "notifications-empty-resize-layout",
  "fixture": "empty",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "open Notifications on an empty workspace", "key": "!" },
    { "type": "assert", "assert": "view", "value": "NotificationCenter" },
    { "type": "assert", "assert": "contains", "value": "Alert Center" },
    { "type": "assert", "assert": "contains", "value": "No alerts" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "shrink to the minimum layout", "width": 60, "height": 20 },
    { "type": "assert", "assert": "view", "value": "NotificationCenter" },
    { "type": "assert", "assert": "contains", "value": "No alerts" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "restore the standard layout", "width": 100, "height": 35 },
    { "type": "assert", "assert": "contains", "value": "No alerts" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
