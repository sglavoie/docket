{
  "name": "capture-child-adoption",
  "fixture": "rich",
  "size": "100x35",
  "actions": [
    { "type": "command", "label": "open Backlog, which launch folds, so the scenario reads the whole workspace", "command": "Clear All Folds" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "label": "a promoted child wears the bare ancestor marker", "assert": "contains", "value": "Build login form  ‹" },
    { "type": "key", "label": "Peek names the chain the row reduced to a marker", "key": "b" },
    { "type": "assert", "label": "User authentication starts under Launch platform", "assert": "contains", "value": "Parent: Launch platform › User authentication" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "close Peek", "key": "esc" },
    { "type": "key", "label": "back onto a section header row", "key": "home" },

    { "type": "key", "label": "capture from a section header row", "key": "a" },
    { "type": "assert", "assert": "view", "value": "TaskComposer" },
    { "type": "assert", "label": "no cursor lends capture its project", "assert": "contains", "value": "Project: Unfiled" },

    { "type": "text", "label": "route the line, then adopt two tasks named three ways", "text": "Consolidate follow-ups %rich-project <2 <6 <Fix" },
    { "type": "assert", "label": "children resolve in the routed project, which the route row names", "assert": "contains", "value": "Project: Rich Project" },
    { "type": "assert", "label": "the short id and the title prefix collapse to one child", "assert": "contains", "value": "Children <2 User authentication · <6 Fix redirect loop after logout" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "commit one atomic capture", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "status_contains", "value": "Add Task: #9 Consolidate follow-ups" },
    { "type": "assert", "label": "both adopted tasks now wear the marker", "assert": "contains", "value": "User authentication  ‹" },
    { "type": "assert", "assert": "contains", "value": "Fix redirect loop after logout  ‹" },
    { "type": "key", "key": "home" },
    { "type": "key", "key": "j" },
    { "type": "key", "label": "Peek on the deepest adopted descendant", "key": "b" },
    { "type": "assert", "label": "the adopted task kept its own subtree", "assert": "contains", "value": "Parent: Consolidate follow-ups › User authentication" },
    { "type": "assert", "label": "the previous parent no longer owns it", "assert": "not_contains", "value": "Parent: Launch platform" },
    { "type": "key", "label": "Peek follows the cursor to the second adopted task", "key": "end" },
    { "type": "key", "key": "k" },
    { "type": "key", "key": "k" },
    { "type": "assert", "assert": "contains", "value": "Parent: Consolidate follow-ups" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "close Peek", "key": "esc" },

    { "type": "key", "label": "undo the capture and every adoption with it", "key": "u" },
    { "type": "wait" },
    { "type": "assert", "assert": "not_contains", "value": "User authentication  ‹" },
    { "type": "assert", "assert": "not_contains", "value": "Fix redirect loop after logout  ‹" },
    { "type": "key", "key": "home" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "b" },
    { "type": "assert", "label": "the original chain is back", "assert": "contains", "value": "Parent: Launch platform › User authentication" },
    { "type": "key", "key": "esc" },

    { "type": "key", "label": "redo the same transaction", "key": "ctrl+r" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Fix redirect loop after logout  ‹" },
    { "type": "key", "key": "home" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "b" },
    { "type": "assert", "assert": "contains", "value": "Parent: Consolidate follow-ups › User authentication" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
