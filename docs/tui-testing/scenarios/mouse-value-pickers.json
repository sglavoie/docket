{
  "name": "mouse-value-pickers",
  "fixture": "rich",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "open the one date picker", "key": "@" },
    { "type": "assert", "assert": "contains", "value": "a set due date" },
    { "type": "click", "label": "a click on a row of another section moves to that section, as Tab would", "on": "In 4 hours" },
    { "type": "assert", "assert": "contains", "value": "› 4 In 4 hours" },
    { "type": "assert", "assert": "contains", "value": "a set defer date" },
    { "type": "wheel", "label": "the wheel steps the cursor a row per step", "on": "In 4 hours", "delta": 2 },
    { "type": "assert", "assert": "contains", "value": "› 9 Tomorrow morning" },
    { "type": "click", "label": "a section header is not a row", "on": "DUE", "count": 2 },
    { "type": "assert", "assert": "contains", "value": "› 9 Tomorrow morning" },
    { "type": "click", "label": "nor is the host beneath the picker", "on": "Triage support inbox", "count": 2 },
    { "type": "assert", "assert": "contains", "value": "Set Due, Defer, or Check-In: Build login form" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "click", "label": "a double-click is Enter on the row, which chooses it", "on": "Tomorrow  Wed", "count": 2 },
    { "type": "wait" },
    { "type": "assert", "assert": "not_contains", "value": "Set Due, Defer, or Check-In" },
    { "type": "assert", "assert": "contains", "value": "Build login form  ‹   ⊡ Tomorrow" },

    { "type": "key", "label": "open the tag picker", "key": "#" },
    { "type": "assert", "assert": "contains", "value": "Set Tags & Context: Build login form" },
    { "type": "click", "label": "a right-click is the multi-value picker's Space, which toggles the row", "on": "backend", "button": "right" },
    { "type": "assert", "assert": "contains", "value": "[x] backend" },
    { "type": "click", "label": "a plain click only seats the cursor", "on": "security" },
    { "type": "assert", "assert": "contains", "value": "› [ ] security" },
    { "type": "assert", "assert": "contains", "value": "[x] backend" },
    { "type": "key", "label": "apply what the picker holds", "key": "enter" },
    { "type": "wait" },
    { "type": "key", "label": "reopen it: the applied tag now leads in its own section", "key": "#" },
    { "type": "assert", "assert": "contains", "value": "APPLIED" },
    { "type": "click", "label": "a right-click on the applied row toggles it off where it stands", "on": "backend", "button": "right" },
    { "type": "assert", "assert": "contains", "value": "[ ] backend" },
    { "type": "assert", "assert": "contains", "value": "APPLIED" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "and while the search field is being typed, a click only seats", "key": "/" },
    { "type": "click", "on": "urgent", "button": "right" },
    { "type": "assert", "assert": "contains", "value": "[ ] urgent" },
    { "type": "click", "label": "the search field itself swallows a click", "on": "Search:", "count": 2 },
    { "type": "assert", "assert": "contains", "value": "Set Tags & Context: Build login form" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },

    { "type": "key", "label": "open the reference picker", "key": "~" },
    { "type": "assert", "assert": "contains", "value": "Set Dependencies: Build login form" },
    { "type": "click", "label": "a right-click toggles a reference row as Space does", "on": "Triage support inbox", "occurrence": 2, "button": "right" },
    { "type": "assert", "assert": "contains", "value": "[x] Triage support inbox" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },

    { "type": "resize", "width": 60, "height": 20 },
    { "type": "key", "key": "@" },
    { "type": "click", "label": "after a resize the picker reads its new frame, context line included", "on": "This weekend" },
    { "type": "assert", "assert": "contains", "value": "› s This weekend" },
    { "type": "wheel", "label": "the wheel carries the cursor past the window, which follows it", "on": "This weekend", "delta": 5 },
    { "type": "assert", "assert": "contains", "value": "› 1 In 1 hour" },
    { "type": "assert", "assert": "contains", "value": "↑" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
