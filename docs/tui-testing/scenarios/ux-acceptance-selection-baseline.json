{
  "name": "ux-acceptance-selection-baseline",
  "fixture": "ux-acceptance",
  "size": "100x35",
  "actions": [
    { "type": "command", "label": "open Backlog, which launch folds, so the scenario reads the whole workspace", "command": "Clear All Folds" },
    { "type": "key", "label": "G reaches the last task row through the public grammar", "key": "G" },
    { "type": "key", "key": "b" },
    { "type": "assert", "assert": "contains", "value": "b/Esc close Peek" },
    { "type": "key", "label": "entering a visual selection closes Peek", "key": "v" },
    { "type": "assert", "assert": "not_contains", "value": "close Peek" },
    { "type": "assert", "label": "and Esc now names the selection it would clear instead", "assert": "contains", "value": "Esc clear selection" },
    { "type": "assert", "assert": "contains", "value": "Multi-select: 1 selected" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "two rows up clears the project header between them", "key": "up" },
    { "type": "key", "key": "up" },
    { "type": "key", "key": "v" },
    { "type": "key", "key": "up" },
    { "type": "key", "key": "up" },
    { "type": "key", "key": "up" },
    { "type": "key", "key": "v" },
    { "type": "assert", "assert": "contains", "value": "Multi-select: 3 selected" },
    { "type": "assert", "label": "the context row is the sole persistent summary, so the counts are stated once", "assert": "count_contains", "value": "Multi-select:", "count": 1 },
    { "type": "assert", "label": "and the status channel says nothing about a selection", "assert": "not_contains", "value": "Visual selection" },
    { "type": "assert", "label": "the window opens one row inside the Pinned lane, so its first row is that lane's pinned context", "assert": "contains", "value": "▾  Pinned › [ux-platform-delivery]  (1)" },
    { "type": "assert", "label": "which costs the list its last row: the third selected task is below the window, and only the summary counts it", "assert": "count_contains", "value": "✓└──", "count": 2 },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "Ctrl+A takes every visible task in the projection", "key": "ctrl+a" },
    { "type": "assert", "assert": "contains", "value": "Multi-select: 15 selected" },
    { "type": "assert", "assert": "count_contains", "value": "Multi-select:", "count": 1 },
    { "type": "assert", "label": "every task row on screen wears the mark in its cursor column, fourteen over the two connector shapes; the fifteenth is the row the pinned context took", "assert": "count_contains", "value": "✓├──", "count": 5 },
    { "type": "assert", "assert": "count_contains", "value": "✓└──", "count": 9 },
    { "type": "assert", "label": "and the mark costs no column, so no checkbox is drawn", "assert": "not_contains", "value": "[x]" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "Esc unwinds the selection before anything else", "key": "esc" },
    { "type": "assert", "assert": "not_contains", "value": "Multi-select" },
    { "type": "assert", "assert": "not_contains", "value": "Visual selection" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · All" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
