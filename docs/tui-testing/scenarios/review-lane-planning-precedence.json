{
  "name": "review-lane-planning-precedence",
  "fixture": "multi-project",
  "size": "100x35",
  "actions": [
    { "type": "assert", "assert": "contains", "value": "Active Projects · All" },
    { "type": "assert", "label": "no review lane before anything is flagged", "assert": "not_contains", "value": "@ Review" },

    { "type": "key", "label": "edit the row in place, the sigil route to the review flag", "key": "e" },
    { "type": "assert", "assert": "contains", "value": "EDIT TASK" },
    { "type": "text", "label": "flag the task for review", "text": " =review " },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "status_contains", "value": "Edit Task Line" },
    { "type": "assert", "label": "the cursor was on the intended task", "assert": "contains", "value": "Alpha migration kickoff" },
    { "type": "assert", "assert": "contains", "value": "@ Review" },
    { "type": "assert", "label": "the review flag draws exactly one row", "assert": "count_contains", "value": "□ Alpha migration kickoff             [client-alpha]", "count": 1 },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the flag moved the row to the promoted lane and the cursor kept sweeping Backlog", "key": "home" },
    { "type": "key", "label": "onto the flagged row in the Review lane", "key": "down" },
    { "type": "key", "label": "hold the workflow prefix", "key": "w" },
    { "type": "key", "label": "plan the flagged task into Next", "key": "n" },
    { "type": "wait" },
    { "type": "assert", "label": "planning moves the row instead of copying it", "assert": "count_contains", "value": "□ Alpha migration kickoff             [client-alpha]", "count": 1 },
    { "type": "assert", "label": "Next outranks the review flag, emptying the lane", "assert": "not_contains", "value": "@ Review" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "planning moved the row again, so walk back to it", "key": "home" },
    { "type": "key", "label": "onto the planned row in the Next lane", "key": "down" },
    { "type": "key", "label": "hold the workflow prefix", "key": "w" },
    { "type": "key", "label": "leave Next again", "key": "n" },
    { "type": "wait" },
    { "type": "assert", "label": "the flag was never mutated, so Review reclaims the row", "assert": "contains", "value": "@ Review" },
    { "type": "assert", "assert": "count_contains", "value": "□ Alpha migration kickoff             [client-alpha]", "count": 1 }
  ]
}
