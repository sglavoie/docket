{
  "name": "outliner-section-zoom",
  "fixture": "busy",
  "size": "100x35",
  "actions": [
    { "type": "assert", "label": "All over Active Projects lists every state group", "assert": "contains", "value": "Untriaged inbox item 1" },
    { "type": "assert", "assert": "contains", "value": "Overdue: submit quarterly report" },
    { "type": "assert", "assert": "contains", "value": "Waiting on vendor response" },
    { "type": "key", "label": "launch opens on the first task, so climb to the section header this zoom is about", "key": "home" },
    { "type": "assert", "label": "that header offers the zoom", "assert": "contains", "value": "Enter zoom" },

    { "type": "key", "label": "zoom into the Inbox state group", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Section: Inbox" },
    { "type": "assert", "assert": "contains", "value": "Untriaged inbox item 1" },
    { "type": "assert", "assert": "not_contains", "value": "Overdue: submit quarterly report" },
    { "type": "assert", "assert": "not_contains", "value": "Waiting on vendor response" },
    { "type": "assert", "label": "the zoomed header names Esc rather than a fold it cannot write", "assert": "contains", "value": "Esc unzoom" },
    { "type": "assert", "assert": "not_contains", "value": "s sections" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "keep the zoom healthy at the minimum width", "width": 60, "height": 20 },
    { "type": "assert", "assert": "contains", "value": "Section: Inbox" },
    { "type": "assert", "assert": "contains", "value": "Untriaged inbox item 1" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "width": 100, "height": 35 },
    { "type": "assert", "assert": "contains", "value": "Section: Inbox" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "Esc restores the whole mode on the header it was pressed from", "key": "esc" },
    { "type": "assert", "assert": "not_contains", "value": "Section: Inbox" },
    { "type": "assert", "assert": "contains", "value": "Overdue: submit quarterly report" },
    { "type": "assert", "assert": "contains", "value": "Enter zoom" },

    { "type": "key", "label": "fold the Inbox lane before zooming it", "key": "h" },
    { "type": "assert", "assert": "not_contains", "value": "Untriaged inbox item 1" },
    { "type": "key", "label": "a collapsed section still zooms open", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Section: Inbox" },
    { "type": "assert", "assert": "contains", "value": "Untriaged inbox item 1" },
    { "type": "key", "label": "leaving the zoom leaves the fold exactly as it was", "key": "esc" },
    { "type": "assert", "assert": "not_contains", "value": "Untriaged inbox item 1" },
    { "type": "assert", "assert": "contains", "value": "l/Right expand" },
    { "type": "key", "key": "l" },

    { "type": "key", "label": "zoom the Inbox lane again", "key": "enter" },
    { "type": "key", "label": "step onto the zoom's first task", "key": "j" },
    { "type": "key", "label": "an expanded group spends no row on a heading, so fold the cursor's own to reach one", "key": "h" },
    { "type": "assert", "label": "a project heading keeps naming the project act", "assert": "contains", "value": "Enter open" },
    { "type": "key", "label": "scoping to that project drops the zoom rather than composing with it", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Inbox Backlog · All" },
    { "type": "assert", "assert": "not_contains", "value": "Section: Inbox" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "assert", "label": "a single-project scope zooms its own sections", "assert": "contains", "value": "Enter zoom" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Inbox Backlog · All" },
    { "type": "assert", "assert": "contains", "value": "Section: Inbox" },
    { "type": "assert", "assert": "contains", "value": "Untriaged inbox item 1" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the first Esc unwinds the scoped zoom", "key": "esc" },
    { "type": "assert", "assert": "contains", "value": "Inbox Backlog · All" },
    { "type": "assert", "assert": "not_contains", "value": "Section: Inbox" },
    { "type": "key", "label": "the second Esc pops the scope and restores the zoom it was taken from", "key": "esc" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · All" },
    { "type": "assert", "assert": "contains", "value": "Section: Inbox" },
    { "type": "assert", "assert": "not_contains", "value": "Overdue: submit quarterly report" },
    { "type": "key", "label": "the third Esc leaves the zoom", "key": "esc" },
    { "type": "assert", "assert": "not_contains", "value": "Section: Inbox" },
    { "type": "assert", "assert": "contains", "value": "Overdue: submit quarterly report" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "go to Due, whose sections are computed buckets", "key": "g" },
    { "type": "key", "key": "@" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · Due" },

    { "type": "key", "label": "the fixture's due-soon task is twelve hours out, so the clock decides its bucket", "key": "G" },
    { "type": "key", "key": "@" },
    { "type": "assert", "assert": "contains", "value": "Set Due or Defer: Due soon: renew certificate" },
    { "type": "key", "label": "type the date, because the preset the cursor opens on is the task's current one", "key": "a" },
    { "type": "assert", "assert": "contains", "value": "Set a Specific Date" },
    { "type": "text", "text": "today" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "label": "Due now holds exactly Overdue and Today at any hour; the due chip is a padded badge, so it sits behind two spaces", "assert": "contains", "value": "Due soon: renew certificate      [busy-project]  ⊡ Today" },
    { "type": "assert", "assert": "not_contains", "value": "Next Seven Days" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the picker left the cursor on the task, so restart the walk at the first header", "key": "home" },
    { "type": "key", "label": "n stops at each group start, so the Today bucket is the second jump", "key": "n" },
    { "type": "key", "key": "n" },
    { "type": "key", "label": "a computed bucket zooms like a state group", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Section: Today" },
    { "type": "assert", "assert": "contains", "value": "Due soon: renew certificate" },
    { "type": "assert", "assert": "not_contains", "value": "Overdue: submit quarterly report" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "land on the bucket's only task", "key": "j" },
    { "type": "key", "label": "complete it so the zoomed section empties", "key": "w" },
    { "type": "key", "key": "d" },
    { "type": "assert", "label": "an emptied zoom stays put instead of unwinding under the user", "assert": "contains", "value": "Section: Today" },
    { "type": "assert", "assert": "contains", "value": "No tasks are left in this section. Press Esc to unzoom." },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "Esc still leaves on demand", "key": "esc" },
    { "type": "assert", "assert": "not_contains", "value": "Section: Today" },
    { "type": "assert", "assert": "contains", "value": "Overdue: submit quarterly report" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
