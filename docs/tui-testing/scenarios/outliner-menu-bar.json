{
  "name": "outliner-menu-bar",
  "fixture": "release",
  "size": "100x20",
  "actions": [
    { "type": "assert", "label": "the bar is hidden until a machine asks for it", "assert": "not_contains", "value": "Task  View  Go  Find  Help" },
    { "type": "assert", "label": "a list that overflows, so the last drawn row is a witness to the row budget", "assert": "contains", "value": "Release acceptance item 095" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "M shows the bar", "key": "M" },
    { "type": "assert", "assert": "contains", "value": "Menu bar shown" },
    { "type": "assert", "label": "labels only: showing the bar opens no menu", "assert": "contains", "value": "Task  View  Go  Find  Help" },
    { "type": "assert", "assert": "not_contains", "value": "Capture Child" },
    { "type": "assert", "label": "the bar sits above the operational title rather than replacing it", "assert": "contains", "value": "Active Projects · All" },
    { "type": "assert", "label": "and costs exactly one list row: the last one is gone", "assert": "not_contains", "value": "Release acceptance item 095" },
    { "type": "assert", "assert": "contains", "value": "Release acceptance item 088" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "the whole bar still fits at the narrowest supported width", "width": 60, "height": 20 },
    { "type": "assert", "assert": "contains", "value": "Task  View  Go  Find  Help" },
    { "type": "assert", "assert": "contains", "value": "Active Projects" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "width": 100, "height": 20 },
    { "type": "key", "label": "M hides it again and the row comes back", "key": "M" },
    { "type": "assert", "assert": "contains", "value": "Menu bar hidden" },
    { "type": "assert", "assert": "not_contains", "value": "Task  View  Go  Find  Help" },
    { "type": "assert", "assert": "contains", "value": "Release acceptance item 095" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "wait", "label": "let the toggle's transient status expire so the footer is guidance again", "duration": "10s" },
    { "type": "key", "label": "Ctrl+M opens a menu, revealing the hidden bar in the same press", "key": "ctrl+m" },
    { "type": "assert", "assert": "contains", "value": "Task  View  Go  Find  Help" },
    { "type": "assert", "label": "the leftmost menu drops under its own label", "assert": "contains", "value": "Capture Child" },
    { "type": "assert", "assert": "contains", "value": "External Editor" },
    { "type": "assert", "label": "an entry carries the key its own accelerator is bound to", "assert": "contains", "value": "Ctrl+E" },
    { "type": "assert", "label": "the open menu's gated keymap owns the footer", "assert": "contains", "value": "Enter run" },
    { "type": "assert", "label": "and names the key that opened it as the key that closes it", "assert": "contains", "value": "Ctrl+M/Esc close" },
    { "type": "assert", "label": "an open menu is the whole frame: the list is not shrunk, it is not drawn", "assert": "not_contains", "value": "Release acceptance item 088" },
    { "type": "assert", "label": "and the operational title goes with it, so nothing below the bar shifts", "assert": "not_contains", "value": "Active Projects · All" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "l moves along the bar to View", "key": "l" },
    { "type": "assert", "assert": "not_contains", "value": "Capture Child" },
    { "type": "assert", "label": "the active mode carries its checkmark", "assert": "contains", "value": "✓ All" },
    { "type": "assert", "label": "and only the active one does", "assert": "not_contains", "value": "✓ Today" },
    { "type": "assert", "label": "a menu too tall for the budget scrolls rather than overflowing", "assert": "contains", "value": "more" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "given the room, the whole menu is drawn", "width": 100, "height": 35 },
    { "type": "assert", "assert": "contains", "value": "Query Readout" },
    { "type": "assert", "label": "the keyless entry is drawn, and the menu is the only place it exists", "assert": "contains", "value": "Clear All Folds" },
    { "type": "assert", "label": "the bar's own visibility reads back off the machine flag", "assert": "contains", "value": "✓ Menu Bar" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "the dropdown stays on screen at the narrowest supported width", "width": 60, "height": 20 },
    { "type": "assert", "assert": "contains", "value": "✓ All" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "width": 100, "height": 20 },

    { "type": "key", "label": "esc puts the menu away and leaves the bar shown", "key": "esc" },
    { "type": "assert", "assert": "not_contains", "value": "Query Readout" },
    { "type": "assert", "assert": "contains", "value": "Task  View  Go  Find  Help" },
    { "type": "assert", "label": "the title and the same rows come back where they were", "assert": "contains", "value": "Active Projects · All" },
    { "type": "assert", "assert": "contains", "value": "Release acceptance item 088" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "reopen it to press a key it does not list", "key": "ctrl+m" },
    { "type": "assert", "assert": "contains", "value": "Capture Child" },
    { "type": "key", "label": "the menu is non-modal: a closes it and captures anyway", "key": "a" },
    { "type": "assert", "assert": "view", "value": "TaskComposer" },
    { "type": "assert", "assert": "not_contains", "value": "Capture Child" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "abandon the capture the menu handed off", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "contains", "value": "Task  View  Go  Find  Help" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
