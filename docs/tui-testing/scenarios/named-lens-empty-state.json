{
  "name": "named-lens-empty-state",
  "fixture": "rich",
  "size": "60x20",
  "actions": [
    { "type": "key", "label": "open the picker at the narrowest supported width", "key": "\\" },
    { "type": "assert", "assert": "contains", "value": "Named Lenses" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "apply a lens from below the two action rows", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Lens: High Priority" },

    { "type": "key", "label": "a temporary search past every row it could reach", "key": "/" },
    { "type": "text", "text": "zzzznothing" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "label": "the empty state is the search's, since no lens owns this projection", "assert": "contains", "value": "No tasks match search" },
    { "type": "assert", "label": "and it names the exit it actually has, in the body and in the footer", "assert": "contains", "value": "or Esc to restore the" },
    { "type": "assert", "assert": "contains", "value": "Esc restore lens" },
    { "type": "assert", "assert": "not_contains", "value": "Esc clear search" },
    { "type": "assert", "assert": "not_contains", "value": "clear the search" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "one Esc puts the lens back rather than clearing anything", "key": "esc" },
    { "type": "wait" },
    { "type": "assert", "assert": "not_contains", "value": "No tasks match search" },
    { "type": "assert", "assert": "contains", "value": "Lens: High Priority" },
    { "type": "assert", "assert": "not_contains", "value": "suspended" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "narrow the standing lens past every row it held", "key": "f" },
    { "type": "key", "key": "=" },
    { "type": "wait" },
    { "type": "assert", "label": "the empty state names the lens rather than any one axis it owns", "assert": "contains", "value": "No tasks match this lens." },
    { "type": "assert", "assert": "contains", "value": "Esc restore lens" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "and that Esc does exactly what it said", "key": "esc" },
    { "type": "wait" },
    { "type": "assert", "assert": "not_contains", "value": "No tasks match this lens." },
    { "type": "assert", "assert": "not_contains", "value": "Lens:" },
    { "type": "assert", "assert": "contains", "value": "Build login form" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
