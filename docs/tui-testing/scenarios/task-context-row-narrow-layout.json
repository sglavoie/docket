{
  "name": "task-context-row-narrow-layout",
  "fixture": "rich",
  "size": "60x20",
  "actions": [
    { "type": "command", "label": "open Backlog, which launch folds, so the scenario reads the whole workspace", "command": "Clear All Folds" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "label": "context remains visible at minimum width", "assert": "contains", "value": "[platform]" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "label": "the row hangs beneath its merged lead's label, which spends a few columns of its own", "width": 64, "height": 20 },
    { "type": "assert", "label": "so a title that once lost its tail to context arrives whole just above the floor", "assert": "not_clipped", "value": "Add password validation" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "width": 60, "height": 20 },

    { "type": "key", "key": "/" },
    { "type": "text", "text": "Add password validation" },
    { "type": "key", "key": "enter" },
    { "type": "key", "label": "the search keeps the ancestry, so the deepest row is the result", "key": "end" },
    { "type": "key", "label": "open Peek beside the row context", "key": "b" },
    { "type": "key", "key": "B", "label": "open fullscreen details to read the supporting metadata" },
    { "type": "assert", "assert": "contains", "value": "Context: platform" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
