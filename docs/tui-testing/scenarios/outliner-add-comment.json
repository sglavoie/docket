{
  "name": "outliner-add-comment",
  "fixture": "checklist",
  "size": "100x35",
  "actions": [
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "key", "label": "move onto the first task row, which its group leads with", "key": "j" },

    { "type": "key", "label": "C opens the quick comment popup", "key": "C" },
    { "type": "assert", "assert": "contains", "value": "Add Comment" },
    { "type": "assert", "label": "the popup names the task it froze", "assert": "contains", "value": "Draft the launch runbook" },
    { "type": "assert", "label": "the multiline popup saves on Ctrl+S, not Enter", "assert": "contains", "value": "Ctrl+S save" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "an empty buffer closes outright, with nothing to lose", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "key", "label": "the count is Peek's, so that is where a cancelled popup proves it wrote nothing", "key": "b" },
    { "type": "assert", "assert": "not_contains", "value": "Comments:" },
    { "type": "key", "label": "close Peek", "key": "b" },

    { "type": "key", "label": "C again, this time with text in it", "key": "C" },
    { "type": "text", "text": "First line of the note" },
    { "type": "key", "label": "Enter writes a newline instead of saving", "key": "enter" },
    { "type": "text", "text": "Second line of the note" },
    { "type": "assert", "assert": "contains", "value": "First line of the note" },
    { "type": "assert", "assert": "contains", "value": "Second line of the note" },

    { "type": "key", "label": "Esc on typed text asks before discarding it", "key": "esc" },
    { "type": "assert", "assert": "contains", "value": "Discard comment?" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "n keeps the text", "key": "n" },
    { "type": "assert", "assert": "not_contains", "value": "Discard comment?" },
    { "type": "assert", "assert": "contains", "value": "Second line of the note" },

    { "type": "key", "label": "Ctrl+S commits and returns to the outline", "key": "ctrl+s" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "label": "the row stays a title; a comment is supporting detail", "assert": "not_contains", "value": "▪ 1" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "Peek is the one surface that names it", "key": "b" },
    { "type": "assert", "assert": "contains", "value": "Comments: 1" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "close Peek", "key": "b" },

    { "type": "key", "label": "a comment is an ordinary ledger entry", "key": "u" },
    { "type": "wait" },
    { "type": "key", "key": "b" },
    { "type": "assert", "assert": "not_contains", "value": "Comments:" },
    { "type": "key", "key": "b" },
    { "type": "key", "label": "and redo puts it back", "key": "ctrl+r" },
    { "type": "wait" },
    { "type": "key", "key": "b" },
    { "type": "assert", "assert": "contains", "value": "Comments: 1" },
    { "type": "key", "key": "b" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "`;` still opens the panel that owns reading and deleting", "key": ";" },
    { "type": "assert", "assert": "view", "value": "TaskComments" },
    { "type": "assert", "assert": "contains", "value": "First line of the note" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "and its own `a` add mode is unchanged", "key": "a" },
    { "type": "assert", "assert": "contains", "value": "Enter comment text..." },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" }
  ]
}
