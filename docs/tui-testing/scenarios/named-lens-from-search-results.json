{
  "name": "named-lens-from-search-results",
  "fixture": "rich",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "run an ordinary search and accept it", "key": "/" },
    { "type": "text", "text": "login" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Search: \"login\"" },
    { "type": "assert", "assert": "contains", "value": "Build login form" },
    { "type": "assert", "assert": "not_contains", "value": "Launch platform" },

    { "type": "key", "label": "the key is admitted on accepted results, not only in browse", "key": "\\" },
    { "type": "key", "label": "and the sorted rows sit below both action rows as always", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Lens: High Priority" },
    { "type": "assert", "label": "a scope-wide search cannot survive underneath a lens", "assert": "not_contains", "value": "Search: \"login\"" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "one Esc hands the whole pre-lens view back, search included", "key": "esc" },
    { "type": "wait" },
    { "type": "assert", "assert": "not_contains", "value": "Lens:" },
    { "type": "assert", "assert": "contains", "value": "Search: \"login\"" },
    { "type": "assert", "assert": "contains", "value": "Build login form" },
    { "type": "assert", "assert": "not_contains", "value": "Launch platform" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "saving from those results keeps the query the rows came from", "key": "\\" },
    { "type": "key", "key": "enter" },
    { "type": "text", "text": "Login work" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Lens: Login work" },
    { "type": "assert", "label": "the lens narrows by the accepted query it captured", "assert": "contains", "value": "Lens query: \"login\"" },
    { "type": "assert", "assert": "contains", "value": "Build login form" },
    { "type": "assert", "assert": "not_contains", "value": "Search: \"login\"" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "and Esc still hands the search back", "key": "esc" },
    { "type": "wait" },
    { "type": "assert", "assert": "not_contains", "value": "Lens:" },
    { "type": "assert", "assert": "contains", "value": "Search: \"login\"" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "find, then narrow inside the results", "key": "f" },
    { "type": "key", "key": "h" },
    { "type": "key", "label": "step past Parent and Child onto Root", "key": "down" },
    { "type": "key", "key": "down" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "status_contains", "value": "Filtering hierarchy: root" },
    { "type": "assert", "assert": "contains", "value": "hierarchy:root" },
    { "type": "assert", "label": "the facet gates the ranked rows", "assert": "not_contains", "value": "Build login form" },
    { "type": "assert", "label": "and leaves the ones it admits", "assert": "contains", "value": "Explore social login" },
    { "type": "assert", "assert": "contains", "value": "Search: \"login\"" },

    { "type": "key", "label": "then save the narrowed find as a lens", "key": "\\" },
    { "type": "key", "key": "enter" },
    { "type": "text", "text": "Narrowed login" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Lens: Narrowed login" },
    { "type": "assert", "label": "the round trip keeps the query", "assert": "contains", "value": "Lens query: \"login\"" },
    { "type": "assert", "label": "and the narrowing typed inside the search", "assert": "contains", "value": "hierarchy:root" },
    { "type": "assert", "label": "so the lens reproduces the find it was saved from", "assert": "contains", "value": "Explore social login" },
    { "type": "assert", "assert": "not_contains", "value": "Build login form" },
    { "type": "assert", "assert": "not_contains", "value": "Search: \"login\"" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "one Esc still hands the narrowed search back", "key": "esc" },
    { "type": "wait" },
    { "type": "assert", "assert": "not_contains", "value": "Lens:" },
    { "type": "assert", "assert": "contains", "value": "Search: \"login\"" },
    { "type": "assert", "assert": "contains", "value": "hierarchy:root" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
