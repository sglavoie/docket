{
  "name": "mouse-peek-wheel",
  "fixture": "rich",
  "size": "60x20",
  "actions": [
    { "type": "click", "label": "open Backlog by its glyph", "on": "▸ Backlog" },
    { "type": "click", "on": "Add password validat" },
    { "type": "key", "label": "open the dock over a detail longer than its window", "key": "b" },
    { "type": "assert", "assert": "contains", "value": "↓ 2 more" },

    { "type": "wheel", "label": "a step over the dock scrolls the detail one row", "on": "Status: ▣ Backlog", "delta": 1 },
    { "type": "assert", "assert": "contains", "value": "↑ 1 more · ↓ 1 more" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "wheel", "label": "steps past the end stay inside the dock", "on": "↑ 1 more · ↓ 1 more", "delta": 5 },
    { "type": "assert", "assert": "contains", "value": "↑ 2 more" },
    { "type": "assert", "label": "the list did not move", "assert": "contains", "value": "▾ Doing  (1)" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "wheel", "on": "↑ 2 more", "delta": -5 },
    { "type": "assert", "assert": "contains", "value": "↓ 2 more" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "width": 100, "height": 30 },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
