{
  "name": "outliner-search-history-recall",
  "fixture": "rich",
  "size": "100x35",
  "actions": [
    {"type": "key", "label": "open the slash search", "key": "/"},
    {"type": "assert", "label": "an empty ring advertises no walk", "assert": "not_contains", "value": "recall query"},
    {"type": "text", "label": "a query that matches nothing, so only its echo can appear", "text": "zzq"},
    {"type": "key", "label": "submit it", "key": "enter"},
    {"type": "assert", "assert": "contains", "value": "zzq"},
    {"type": "key", "label": "leave the search entirely", "key": "esc"},
    {"type": "assert", "label": "the query is gone from the screen", "assert": "not_contains", "value": "zzq"},
    {"type": "key", "label": "reopen the input on an empty box", "key": "/"},
    {"type": "assert", "assert": "contains", "value": "Search tasks..."},
    {"type": "assert", "assert": "not_contains", "value": "zzq"},
    {"type": "assert", "label": "now the footer names the walk", "assert": "contains", "value": "recall query"},
    {"type": "key", "label": "recall the submitted query", "key": "up"},
    {"type": "assert", "assert": "contains", "value": "Search: > zzq"},
    {"type": "assert", "assert": "no_layout_issues"},
    {"type": "key", "label": "step forward onto the draft the walk set aside", "key": "down"},
    {"type": "assert", "assert": "not_contains", "value": "zzq"},
    {"type": "assert", "assert": "contains", "value": "Search tasks..."},
    {"type": "text", "label": "start a matching prefix", "text": "zz"},
    {"type": "key", "key": "up"},
    {"type": "assert", "assert": "contains", "value": "Search: > zzq"},
    {"type": "key", "key": "down"},
    {"type": "assert", "label": "restore the exact draft", "assert": "contains", "value": "Search: > zz"},
    {"type": "assert", "assert": "not_contains", "value": "zzq"},
    {"type": "text", "text": "x"},
    {"type": "key", "key": "up"},
    {"type": "assert", "label": "no match preserves the draft", "assert": "contains", "value": "Search: > zzx"},
    {"type": "resize", "label": "the recall hint must not break a narrow footer", "width": 80, "height": 24},
    {"type": "assert", "assert": "no_layout_issues"},
    {"type": "resize", "label": "nor the 60x20 minimum", "width": 60, "height": 20},
    {"type": "assert", "assert": "no_layout_issues"},
    {"type": "resize", "width": 100, "height": 35},
    {"type": "key", "label": "close the input", "key": "esc"},
    {"type": "restart", "label": "submitted history survives relaunch; abandoned drafts do not"},
    {"type": "assert", "assert": "not_contains", "value": "zzq"},
    {"type": "key", "key": "/"},
    {"type": "key", "key": "up"},
    {"type": "assert", "assert": "contains", "value": "Search: > zzq"},
    {"type": "assert", "assert": "no_layout_issues"},
    {"type": "key", "key": "enter"},
    {"type": "command", "command": "Clear search history"},
    {"type": "assert", "label": "clearing history keeps the active query", "assert": "contains", "value": "zzq"},
    {"type": "key", "key": "esc"},
    {"type": "restart"},
    {"type": "key", "key": "/"},
    {"type": "key", "key": "up"},
    {"type": "assert", "assert": "not_contains", "value": "zzq"},
    {"type": "assert", "assert": "contains", "value": "Search tasks..."},
    {"type": "assert", "assert": "not_contains", "value": "recall query"},
    {"type": "assert", "assert": "no_layout_issues"}
  ]
}
