{
  "name": "outliner-pinned-lane-context",
  "fixture": "release",
  "size": "100x35",
  "actions": [
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "wait", "label": "the 241-task catalog finishes loading" },
    { "type": "assert", "label": "an unscrolled window still shows its lane header, so nothing is pinned", "assert": "contains", "value": "▾  Doing  (35)" },
    { "type": "assert", "assert": "not_contains", "value": "› [release-project]" },

    { "type": "key", "label": "scroll until the Doing header is above the window", "key": "ctrl+d" },
    { "type": "key", "key": "ctrl+d" },
    { "type": "assert", "label": "the first list row names the lane and the project the window opens in", "assert": "contains", "value": "▾  Doing › [release-project]  (35) ─" },
    { "type": "assert", "label": "once, and in place of the header it stands in for", "assert": "count_contains", "value": "› [release-project]", "count": 1 },
    { "type": "assert", "assert": "not_contains", "value": "▾  Doing  (35)" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "moving the cursor inside the window leaves the pinned row where it is", "key": "k" },
    { "type": "key", "key": "k" },
    { "type": "assert", "assert": "contains", "value": "▾  Doing › [release-project]  (35) ─" },

    { "type": "resize", "label": "the minimum terminal keeps it, cut to the row", "width": 60, "height": 20 },
    { "type": "assert", "assert": "contains", "value": "▾  Doing › [release-project]  (35) ─" },
    { "type": "assert", "assert": "count_contains", "value": "› [release-project]", "count": 1 },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the next lane takes the pinned row over once its own header scrolls away", "key": "G" },
    { "type": "assert", "assert": "contains", "value": "▾  Waiting › [release-project]  (34) ─" },
    { "type": "assert", "assert": "not_contains", "value": "▾  Doing › [release-project]" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "back at the top the real header is on screen and the pinned row is gone", "key": "g" },
    { "type": "key", "key": "g" },
    { "type": "assert", "assert": "contains", "value": "▾  Doing  (35)" },
    { "type": "assert", "assert": "not_contains", "value": "› [release-project]" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "width": 100, "height": 35 },
    { "type": "key", "label": "the ranked list has no lanes, so a scrolled one pins nothing", "key": "/" },
    { "type": "text", "text": "acceptance" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "ctrl+d" },
    { "type": "key", "key": "ctrl+d" },
    { "type": "assert", "assert": "contains", "value": "[release-project]" },
    { "type": "assert", "assert": "not_contains", "value": "› [release-project]" },
    { "type": "assert", "assert": "not_contains", "value": "Release acceptance item 004" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
