{
  "name": "mouse-menu-bar",
  "fixture": "release",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "M shows the bar", "key": "M" },
    { "type": "wait", "label": "let the toggle's transient status expire", "duration": "10s" },
    { "type": "click", "label": "a click on a label opens that menu", "on": "View" },
    { "type": "assert", "assert": "contains", "value": "✓ All" },
    { "type": "assert", "assert": "contains", "value": "Enter run" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "click", "label": "a click on another label moves to that menu", "on": "Task" },
    { "type": "assert", "assert": "contains", "value": "Set Status…" },
    { "type": "assert", "assert": "not_contains", "value": "✓ All" },
    { "type": "click", "label": "a click on the open label closes it, as its key does", "on": "Task" },
    { "type": "assert", "assert": "not_contains", "value": "Set Status…" },
    { "type": "assert", "assert": "contains", "value": "Task  View  Go  Find  Help" },
    { "type": "click", "label": "reopen View", "on": "View" },
    { "type": "click", "label": "a click on an enabled entry runs it, as Enter on it does", "on": "Explain Current View" },
    { "type": "assert", "assert": "not_contains", "value": "✓ All" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "assert", "label": "Explain Current View opened the query readout", "assert": "contains", "value": "Narrowing this view" },
    { "type": "key", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "click", "on": "Task" },
    { "type": "assert", "assert": "contains", "value": "Set Status…" },
    { "type": "click", "label": "a click on a disabled entry does nothing: with nothing to undo, Undo is disabled", "on": "Undo" },
    { "type": "assert", "assert": "contains", "value": "Set Status…" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "click", "label": "a click anywhere else closes the menu and does nothing more", "x": 70, "y": 20, "count": 1 },
    { "type": "assert", "assert": "not_contains", "value": "Set Status…" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "contains", "value": "Task  View  Go  Find  Help" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "M hides the bar again", "key": "M" },
    { "type": "wait", "duration": "10s" },
    { "type": "key", "label": "F10 opens a menu on the row it borrows", "key": "f10" },
    { "type": "assert", "assert": "contains", "value": "Set Status…" },
    { "type": "click", "label": "the borrowed row answers the same way", "on": "Find" },
    { "type": "assert", "assert": "not_contains", "value": "Set Status…" },
    { "type": "assert", "assert": "contains", "value": "Search" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "width": 60, "height": 20 },
    { "type": "click", "label": "after a resize the labels read the new frame", "on": "View" },
    { "type": "assert", "assert": "contains", "value": "✓ All" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "click", "label": "an outside click closes it and gives the borrowed row back", "x": 50, "y": 15 },
    { "type": "assert", "assert": "not_contains", "value": "✓ All" },
    { "type": "assert", "assert": "not_contains", "value": "Task  View  Go  Find  Help" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
