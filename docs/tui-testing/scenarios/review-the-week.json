    { "type": "assert", "assert": "contains", "value": "Week reviewed" },
    { "type": "assert", "assert": "contains", "value": "not yet reviewed" },
    { "type": "assert", "assert": "contains", "value": "Enter close" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "width": 60, "height": 20 },
    { "type": "assert", "label": "the closing card fits the smallest terminal", "assert": "no_layout_issues" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "not_contains", "value": "Week reviewed" },
    { "type": "assert", "assert": "no_layout_issues" }
