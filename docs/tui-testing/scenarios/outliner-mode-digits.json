{
  "name": "outliner-mode-digits",
  "fixture": "multi-project",
  "size": "100x35",
  "actions": [
    { "type": "command", "label": "open Backlog, which launch folds, so the scenario reads the whole workspace", "command": "Clear All Folds" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · All" },

    { "type": "key", "label": "2 reaches Today", "key": "2" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · Today" },
    { "type": "key", "label": "7 reaches Recent", "key": "7" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · Recent" },
    { "type": "key", "label": "3 reaches Inbox", "key": "3" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · Inbox" },
    { "type": "key", "label": "4 reaches Next", "key": "4" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · Next" },
    { "type": "key", "label": "5 reaches Backlog", "key": "5" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · Backlog" },
    { "type": "key", "label": "6 reaches Due", "key": "6" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · Due" },
    { "type": "key", "label": "1 reaches All", "key": "1" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · All" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "jump to the Client Alpha group header", "key": "n" },
    { "type": "key", "label": "jump to the Client Beta group header", "key": "n" },
    { "type": "key", "label": "move onto Client Beta's task", "key": "j" },
    { "type": "key", "label": "start the go-to chord", "key": "g" },
    { "type": "key", "label": "scope to the cursor task's project", "key": "p" },
    { "type": "assert", "assert": "contains", "value": "Client Beta · All" },
    { "type": "key", "label": "leave All for Backlog inside the scope", "key": "5" },
    { "type": "assert", "assert": "contains", "value": "Client Beta · Backlog" },
    { "type": "key", "label": "open the filter chord", "key": "f" },
    { "type": "key", "label": "open the priority threshold", "key": "!" },
    { "type": "key", "label": "narrow to High and above", "key": "1" },
    { "type": "assert", "assert": "status_contains", "value": "Filtering High" },

    { "type": "key", "label": "0 returns to the launch view", "key": "0" },
    { "type": "assert", "assert": "status_contains", "value": "Launch view restored" },
    { "type": "assert", "assert": "status_contains", "value": "scope" },
    { "type": "assert", "assert": "status_contains", "value": "filters" },
    { "type": "assert", "assert": "status_contains", "value": "mode" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · All" },
    { "type": "assert", "assert": "contains", "value": "Alpha migration kickoff" },
    { "type": "assert", "assert": "contains", "value": "Beta rollout checklist" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "0 again has nothing left to clear", "key": "0" },
    { "type": "assert", "assert": "status_contains", "value": "Already at the launch view" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · All" },

    { "type": "key", "label": "leave All so an inert digit is visible", "key": "2" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · Today" },
    { "type": "key", "label": "the Q readout claims input while it is open", "key": "Q" },
    { "type": "assert", "assert": "contains", "value": "Narrowing this view" },
    { "type": "key", "label": "0 is unlisted there, so it closes the readout", "key": "0" },
    { "type": "assert", "assert": "not_contains", "value": "Narrowing this view" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · Today" },
    { "type": "key", "label": "reopen the readout", "key": "Q" },
    { "type": "key", "label": "a listed digit peels its row instead of switching mode", "key": "1" },
    { "type": "assert", "assert": "contains", "value": "Peeled mode: Today" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · All" },
    { "type": "key", "label": "close the readout", "key": "esc" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "back to Today so a swallowed digit is visible", "key": "2" },
    { "type": "key", "label": "search owns input while it is open", "key": "/" },
    { "type": "text", "label": "digits typed into the query stay text", "text": "5" },
    { "type": "assert", "assert": "contains", "value": "Search: > 5" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · Today" },
    { "type": "key", "label": "drop the query", "key": "esc" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · Today" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
