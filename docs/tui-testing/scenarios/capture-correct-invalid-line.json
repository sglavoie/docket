{
  "name": "capture-correct-invalid-line",
  "fixture": "fresh",
  "size": "60x20",
  "actions": [
    { "type": "key", "key": "a" },
    { "type": "text", "text": "First captured task" },
    { "type": "key", "key": "shift+enter" },
    { "type": "key", "key": "shift+enter" },
    { "type": "text", "text": "!1 " },
    { "type": "key", "key": "shift+enter" },
    { "type": "text", "text": "Last captured task" },
    { "type": "assert", "label": "no submission diagnostics while drafting", "assert": "not_contains", "value": "Line 3:" },
    { "type": "assert", "label": "off-caret errors are counted before submission", "assert": "contains", "value": "1 line needs attention" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "view", "value": "TaskComposer" },
    { "type": "assert", "assert": "contains", "value": "Line 3: task title cannot be empty" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "text", "label": "submission has already placed the caret on the invalid line", "text": "Fixed captured task " },
    { "type": "assert", "assert": "not_contains", "value": "Line 3:" },
    { "type": "assert", "assert": "not_contains", "value": "needs attention" },
    { "type": "assert", "assert": "view", "value": "TaskComposer" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "resize", "width": 100, "height": 35 },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "contains", "value": "First captured task" },
    { "type": "assert", "assert": "contains", "value": "Fixed captured task" },
    { "type": "assert", "assert": "contains", "value": "Last captured task" },
    { "type": "key", "label": "one undo removes the complete batch", "key": "u" },
    { "type": "wait", "duration": "6s" },
    { "type": "assert", "assert": "not_contains", "value": "First captured task" },
    { "type": "assert", "assert": "not_contains", "value": "Fixed captured task" },
    { "type": "assert", "assert": "not_contains", "value": "Last captured task" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
