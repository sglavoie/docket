{
  "name": "outliner-checklist-row-actions",
  "fixture": "checklist",
  "size": "100x35",
  "actions": [
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "key", "label": "move onto the project header", "key": "j" },
    { "type": "key", "label": "move onto the checklist-only task", "key": "j" },
    { "type": "key", "label": "expand its checklist", "key": "l" },
    { "type": "key", "label": "move onto the first checklist item", "key": "j" },
    { "type": "assert", "assert": "contains", "value": "[x] Outline the rollback steps" },

    { "type": "key", "label": "x unticks the item under the cursor", "key": "x" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "[ ] Outline the rollback steps" },
    { "type": "assert", "label": "the owner badge follows the item", "assert": "contains", "value": "0/3" },
    { "type": "key", "label": "x ticks it back", "key": "x" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "[x] Outline the rollback steps" },
    { "type": "assert", "assert": "contains", "value": "1/3" },

    { "type": "key", "label": "K refuses to move the first item further up", "key": "K" },
    { "type": "assert", "assert": "contains", "value": "already first" },
    { "type": "key", "label": "J swaps it with the item below", "key": "J" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "[x] Outline the rollback steps" },
    { "type": "assert", "assert": "contains", "value": "[ ] Name the on-call owner" },

    { "type": "key", "label": "A appends a new item to this checklist", "key": "A" },
    { "type": "assert", "assert": "contains", "value": "Add Item" },
    { "type": "text", "text": "Verify the rollback drill" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "contains", "value": "[ ] Verify the rollback drill" },
    { "type": "assert", "assert": "contains", "value": "1/4" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "e rewrites the item under the cursor", "key": "e" },
    { "type": "assert", "assert": "contains", "value": "Edit Item" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "Esc leaves the text unchanged", "key": "esc" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "contains", "value": "[x] Outline the rollback steps" },

    { "type": "key", "label": "Space opens the checklist item menu", "key": "space" },
    { "type": "assert", "assert": "contains", "value": "Checklist Item" },
    { "type": "assert", "assert": "contains", "value": "Edit Item" },
    { "type": "assert", "assert": "contains", "value": "Delete Item" },
    { "type": "assert", "label": "the task menu never appears from an item", "assert": "not_contains", "value": "Move Project" },
    { "type": "assert", "assert": "not_contains", "value": "Set Parent" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "step onto the destructive row", "key": "j" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "label": "delete confirms before it mutates", "assert": "contains", "value": "y confirm" },
    { "type": "key", "key": "y" },
    { "type": "wait" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "not_contains", "value": "Outline the rollback steps" },
    { "type": "assert", "assert": "contains", "value": "[ ] Name the on-call owner" },
    { "type": "assert", "assert": "contains", "value": "[ ] Verify the rollback drill" },
    { "type": "assert", "assert": "contains", "value": "0/3" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
