{
  "name": "ux-acceptance-peek-baseline",
  "fixture": "ux-acceptance",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "reach the row by search rather than by a cursor assignment", "key": "/" },
    { "type": "text", "text": "Restore the overdue" },
    { "type": "key", "key": "enter" },
    { "type": "key", "label": "G lands on the only task row under the two headers", "key": "G" },
    { "type": "key", "key": "b" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "assert", "label": "Peek names the whole title the row had to clip", "assert": "contains", "value": "nciliation export before the audit closes" },
    { "type": "assert", "label": "the summary line names what the row abbreviates", "assert": "contains", "value": "state backlog · priority 1" },
    { "type": "assert", "label": "body order opens with the title and summary, then resume", "assert": "contains", "value": "Resume: Stopped after the ledger export; the reconciliation diff is still open." },
    { "type": "assert", "label": "the position row beneath the five body rows names the rest of the document", "assert": "contains", "value": "0 above · 6 below" },
    { "type": "assert", "label": "a Peek that cannot page back advertises neither back key", "assert": "not_contains", "value": "Ctrl+U back" },

    { "type": "key", "label": "Ctrl+F pages the Peek body four content rows", "key": "ctrl+f" },
    { "type": "assert", "label": "the checklist is a count, never its items", "assert": "contains", "value": "Checklist: 1/2 done" },
    { "type": "assert", "assert": "contains", "value": "Attachments 1: reconciliation-brief.md" },
    { "type": "assert", "assert": "contains", "value": "4 above · 2 below" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the next turn clamps on the document end", "key": "ctrl+f" },
    { "type": "assert", "assert": "contains", "value": "Comments: 1" },
    { "type": "assert", "label": "a cross-project dependent is named, never only counted", "assert": "contains", "value": "Dependents 1: UX Client Rollout" },
    { "type": "assert", "assert": "contains", "value": "Context: [finance]" },
    { "type": "assert", "label": "tags close the body order", "assert": "contains", "value": "Tags: #audit #billing" },
    { "type": "assert", "assert": "contains", "value": "6 above · 0 below" },
    { "type": "assert", "assert": "not_contains", "value": "Ctrl+F page down" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "and holds there rather than overshooting", "key": "ctrl+f" },
    { "type": "assert", "assert": "contains", "value": "6 above · 0 below" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "b closes the Peek it opened", "key": "b" },
    { "type": "assert", "assert": "not_contains", "value": "Resume: Stopped after the ledger export" },
    { "type": "assert", "assert": "contains", "value": "Esc clear search" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
