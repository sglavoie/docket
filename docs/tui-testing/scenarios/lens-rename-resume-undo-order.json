{
  "name": "lens-rename-resume-undo-order",
  "fixture": "rich",
  "size": "100x35",
  "actions": [
    { "type": "command", "label": "open Backlog, which launch folds, so the scenario reads the whole workspace", "command": "Clear All Folds" },
    { "type": "key", "label": "save a lens over the tag a rename is about to retire", "key": "/" },
    { "type": "text", "text": "#security" },
    { "type": "key", "label": "close the suggestions, keeping the query", "key": "esc" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "Q" },
    { "type": "key", "key": "s" },
    { "type": "text", "text": "Security Sweep" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Lens: Security Sweep" },
    { "type": "assert", "assert": "contains", "value": "Add password validation" },

    { "type": "key", "label": "rename the tag from inside the lens it defines", "key": "f" },
    { "type": "key", "key": "#" },
    { "type": "key", "key": "down" },
    { "type": "key", "key": "e" },
    { "type": "key", "key": "ctrl+u" },
    { "type": "text", "text": "platform-api" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "#security → #platform-api" },
    { "type": "assert", "label": "one lens is named in the singular", "assert": "contains", "value": "1 saved lens may select differently, and it is left unchanged:" },
    { "type": "assert", "assert": "contains", "value": "Security Sweep · #security" },
    { "type": "key", "key": "y" },
    { "type": "assert", "assert": "contains", "value": "Rename Tag · done" },
    { "type": "assert", "assert": "contains", "value": "1 task rewritten in 1 project" },
    { "type": "assert", "assert": "contains", "value": "1 saved lens may select differently, and it is left unchanged:" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "key": "esc" },
    { "type": "key", "key": "esc" },
    { "type": "wait" },
    { "type": "assert", "label": "the lens was left unchanged, so it now selects nothing", "assert": "contains", "value": "No tasks match this lens. Press Esc to leave the lens." },

    { "type": "key", "label": "unwind the lens and the query it restored", "key": "esc" },
    { "type": "key", "key": "esc" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Active Projects · All" },
    { "type": "assert", "label": "the row spends no column on a chip, so the vocabulary is the witness", "assert": "not_contains", "value": "#backend" },
    { "type": "key", "key": "f" },
    { "type": "key", "key": "#" },
    { "type": "assert", "assert": "contains", "value": "[ ] platform-api" },
    { "type": "assert", "assert": "not_contains", "value": "] security" },
    { "type": "key", "label": "abandon the picker without filtering", "key": "esc" },

    { "type": "key", "label": "record where the doing task was left", "key": "home" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "j" },
    { "type": "key", "key": "r" },
    { "type": "text", "text": "stopped at the OAuth callback stub" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "status_contains", "value": "Set Resume Note: #3 Build login form" },
    { "type": "wait" },

    { "type": "key", "label": "the note is searchable text, not just a row cue", "key": "/" },
    { "type": "text", "text": "callback stub" },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Search: \"callback stub\"" },
    { "type": "assert", "assert": "contains", "value": "Build login form" },
    { "type": "assert", "label": "and the row says the note is there without spending a line on it", "assert": "contains", "value": "· resume" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "key": "esc" },
    { "type": "wait" },
    { "type": "key", "label": "undo takes the two mutations back newest first", "key": "u" },
    { "type": "assert", "assert": "status_contains", "value": "Undid: Set Resume Note: #3 Build login form" },
    { "type": "wait" },
    { "type": "key", "label": "the rename is a separate entry, so the renamed value is still the live one", "key": "f" },
    { "type": "key", "key": "#" },
    { "type": "assert", "assert": "contains", "value": "[ ] platform-api" },
    { "type": "key", "key": "esc" },
    { "type": "key", "key": "u" },
    { "type": "assert", "assert": "status_contains", "value": "Undid: Rename Tag: security → platform-api (1 tasks in 1 projects)" },
    { "type": "key", "key": "f" },
    { "type": "key", "key": "#" },
    { "type": "assert", "assert": "contains", "value": "[ ] security" },
    { "type": "assert", "assert": "not_contains", "value": "] platform-api" },
    { "type": "key", "key": "esc" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "wait" },
    { "type": "key", "label": "the untouched lens selects again once the name is back", "key": "\\" },
    { "type": "key", "key": "/" },
    { "type": "text", "text": "Security Sweep" },
    { "type": "key", "key": "enter" },
    { "type": "key", "key": "1" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "Lens: Security Sweep" },
    { "type": "assert", "assert": "contains", "value": "Add password validation" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
