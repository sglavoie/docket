{
  "name": "outliner-attention-band",
  "fixture": "fresh",
  "size": "100x35",
  "actions": [
    { "type": "key", "label": "capture a high-priority Inbox task", "key": "a" },
    { "type": "text", "text": "Band task !1 " },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "key", "label": "the header cursor leaves the task's attention band visible", "key": "home" },
    { "type": "assert", "assert": "contains", "value": "Band task" },
    { "type": "assert", "assert": "contains", "value": "▐" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "the singleton task uses the next row", "key": "j" },
    { "type": "assert", "label": "the shared cell uses the left-half glyph with the attention color behind it", "assert": "contains", "value": "▌" },
    { "type": "key", "label": "selection replaces the band with a checkmark", "key": "v" },
    { "type": "key", "key": "home" },
    { "type": "assert", "assert": "contains", "value": "✓" },
    { "type": "assert", "assert": "not_contains", "value": "▐" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "leave selection", "key": "esc" },
    { "type": "key", "label": "fold the project while the section header holds the cursor", "key": "p" },
    { "type": "assert", "label": "the task row is hidden even while the capture toast names it", "assert": "not_contains", "value": "◉ Band task" },
    { "type": "assert", "label": "the folded project's band accompanies its fold arrow", "assert": "contains", "value": "▐▸" },
    { "type": "resize", "width": 60, "height": 20 },
    { "type": "assert", "assert": "contains", "value": "▐▸" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "focus the folded project without covering its attention color", "key": "j" },
    { "type": "assert", "assert": "contains", "value": "▌▸" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "expand the group again", "key": "p" },
    { "type": "assert", "assert": "contains", "value": "◉ Band task" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
