{
  "name": "date-picker-title-keeps-due-on-one-row",
  "fixture": "release",
  "size": "60x20",
  "actions": [
    {"type": "key", "label": "give the cursor's task a deadline no preset spells", "key": "e"},
    {"type": "text", "text": " @2030-01-07"},
    {"type": "key", "key": "tab"},
    {"type": "key", "key": "enter"},
    {"type": "wait"},
    {"type": "key", "label": "open the picker at the supported minimum", "key": "@"},
    {"type": "assert", "label": "the title is one row and the task name is what gives way", "assert": "contains", "value": "│ Set Due, Defer, or Check-In: 国際化"},
    {"type": "assert", "label": "the deadline being replaced is named once, on the Now line under the title", "assert": "count_contains", "value": "due Mon Jan 7 2030", "count": 1},
    {"type": "assert", "assert": "contains", "value": "Now: due Mon Jan 7 2030"},
    {"type": "assert", "label": "which matters here: no preset spells that date, so the cursor opens on Clear", "assert": "contains", "value": "› 0 Clear  remove date"},
    {"type": "assert", "assert": "no_layout_issues"},
    {"type": "resize", "label": "a wide row holds the whole title", "width": 100, "height": 30},
    {"type": "assert", "assert": "contains", "value": "│ Set Due, Defer, or Check-In: 国際化 🚀 café résumé release check"},
    {"type": "assert", "assert": "contains", "value": "Now: due Mon Jan 7 2030"},
    {"type": "assert", "assert": "no_layout_issues"},
    {"type": "key", "label": "leaving writes nothing", "key": "esc"},
    {"type": "assert", "assert": "contains", "value": "⊡ Jan 7 '30"},
    {"type": "resize", "label": "back at the minimum, a timed deadline keeps its clock", "width": 60, "height": 20},
    {"type": "key", "key": "e"},
    {"type": "text", "text": " @2030-01-17 09:30"},
    {"type": "key", "key": "tab"},
    {"type": "key", "key": "enter"},
    {"type": "wait"},
    {"type": "key", "key": "@"},
    {"type": "assert", "assert": "contains", "value": "due Thu Jan 17 2030 09:30"},
    {"type": "assert", "assert": "count_contains", "value": "due Thu Jan 17 2030 09:30", "count": 1},
    {"type": "assert", "assert": "no_layout_issues"}
  ]
}
