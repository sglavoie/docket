{
  "name": "outliner-multiselect-minimum-layout",
  "fixture": "rich",
  "size": "60x20",
  "actions": [
    { "type": "resize", "width": 60, "height": 20 },
    { "type": "command", "label": "reset to All over Active Projects", "command": "outliner root" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "label": "before a selection the cursor column is blank", "assert": "contains", "value": "   ▶   [rich-project] Build login form" },
    { "type": "key", "label": "select current task and enter multi-select mode", "key": "v" },
    { "type": "assert", "label": "the mark takes that column and the title has not moved", "assert": "contains", "value": "✓  ▶   [rich-project] Build login form" },
    { "type": "assert", "label": "an unselected row keeps its blank and its column", "assert": "contains", "value": "   ◌   [rich-project] Triage support inbox" },
    { "type": "assert", "label": "the selected row wears its mark in the cursor column", "assert": "count_contains", "value": "✓", "count": 1 },
    { "type": "assert", "label": "and no row draws a checkbox, so no title moved", "assert": "not_contains", "value": "[x]" },
    { "type": "assert", "assert": "not_contains", "value": "[ ]" },
    { "type": "assert", "label": "the context row names the selection in the sentence case its neighbors use", "assert": "contains", "value": "Multi-select: 1" },
    { "type": "assert", "assert": "not_contains", "value": "MULTI-SELECT" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "label": "open the Delete-only menu for the frozen selection", "key": "space" },
    { "type": "assert", "assert": "contains", "value": "Bulk Actions · 1 selected" },
    { "type": "assert", "assert": "contains", "value": "Delete" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
