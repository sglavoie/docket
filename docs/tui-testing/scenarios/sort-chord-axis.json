{
  "name": "sort-chord-axis",
  "fixture": "busy",
  "size": "100x35",
  "actions": [
    { "type": "assert", "label": "the mode's own order leads each group", "assert": "contains", "value": "├── □ ◉ Overdue: submit quarterly report" },
    { "type": "assert", "assert": "contains", "value": "├── ⊘ ◉ Waiting: production outage" },

    { "type": "key", "label": "hold the sort prefix", "key": "o" },
    { "type": "assert", "assert": "contains", "value": "@ due date" },
    { "type": "assert", "assert": "contains", "value": "p priority" },
    { "type": "assert", "assert": "contains", "value": "c created" },
    { "type": "assert", "assert": "contains", "value": "u updated" },
    { "type": "assert", "assert": "contains", "value": "t title" },
    { "type": "assert", "assert": "contains", "value": "x clear sort" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "install the title axis", "key": "t" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "status_contains", "value": "Sorting by title ↑" },
    { "type": "assert", "label": "the sort badge joins the title row", "assert": "contains", "value": "Sort: title ↑" },
    { "type": "assert", "assert": "contains", "value": "├── □ ● Due soon: renew certificate" },
    { "type": "assert", "assert": "contains", "value": "├── ⊘   Waiting on vendor response" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "repeat the same field to reverse it", "key": "o" },
    { "type": "key", "key": "t" },
    { "type": "assert", "assert": "status_contains", "value": "Sorting by title ↓" },
    { "type": "assert", "assert": "contains", "value": "Sort: title ↓" },
    { "type": "assert", "assert": "contains", "value": "├── ⊘ ◉ Waiting: production outage" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "switch the axis to due date", "key": "o" },
    { "type": "key", "key": "@" },
    { "type": "assert", "assert": "status_contains", "value": "Sorting by due date ↑" },
    { "type": "assert", "assert": "contains", "value": "Sort: due date ↑" },

    { "type": "key", "label": "an abandoned prefix names the path it left", "key": "o" },
    { "type": "key", "key": "q" },
    { "type": "assert", "assert": "status_contains", "value": "oq is not a sort action" },

    { "type": "key", "label": "clear the sort", "key": "o" },
    { "type": "key", "key": "x" },
    { "type": "assert", "assert": "status_contains", "value": "Sort cleared" },
    { "type": "assert", "assert": "not_contains", "value": "Sort: " },
    { "type": "assert", "label": "the mode's own order returns", "assert": "contains", "value": "├── ⊘ ◉ Waiting: production outage" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "shrink to the comfortable minimum", "width": 80, "height": 24 },
    { "type": "key", "key": "o" },
    { "type": "key", "key": "p" },
    { "type": "assert", "assert": "status_contains", "value": "Sorting by priority ↑" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "grow back to a wide terminal", "width": 140, "height": 45 },
    { "type": "assert", "assert": "contains", "value": "Sort: priority ↑" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
