{
  "name": "in-app-help",
  "fixture": "rich",
  "size": "160x55",
  "actions": [
    { "type": "key", "label": "open generated Outliner help", "key": "?" },
    { "type": "assert", "assert": "view", "value": "Help" },
    { "type": "assert", "assert": "contains", "value": "Help  Outliner" },

    { "type": "assert", "label": "sections are the categories the registry itself emits", "assert": "contains", "value": "Tasks" },
    { "type": "assert", "assert": "contains", "value": "Discovery" },
    { "type": "assert", "assert": "contains", "value": "Modes" },
    { "type": "assert", "assert": "contains", "value": "Navigation" },
    { "type": "assert", "label": "the shared sigil grammar is a section of its own", "assert": "contains", "value": "Grammar" },
    { "type": "assert", "assert": "not_contains", "value": "Capture & Edit Grammar" },

    { "type": "assert", "assert": "contains", "value": "Capture" },
    { "type": "assert", "assert": "contains", "value": "Set State" },
    { "type": "assert", "assert": "contains", "value": "Move to Backlog" },
    { "type": "assert", "assert": "contains", "value": "Toggle Next" },
    { "type": "assert", "assert": "contains", "value": "Toggle Today" },
    { "type": "assert", "label": "the one date key names all three fields it writes", "assert": "contains", "value": "Set Due, Defer, or Check-In" },
    { "type": "key", "key": "ctrl+d", "label": "scroll from everyday task groups into discovery" },
    { "type": "assert", "label": "the population chord is projected from the same descriptors", "assert": "contains", "value": "Filter Projects by Tag" },
    { "type": "assert", "label": "the Stale facet is projected from its descriptor", "assert": "contains", "value": "Filter Stale" },
    { "type": "assert", "assert": "contains", "value": "Filter by Due or Deferred" },
    { "type": "assert", "assert": "contains", "value": "Include Parked Projects" },
    { "type": "assert", "assert": "contains", "value": "Only Parked Projects" },
    { "type": "assert", "assert": "contains", "value": "Include Archived Projects" },
    { "type": "assert", "assert": "contains", "value": "Only Archived Projects" },
    { "type": "assert", "assert": "contains", "value": "Clear Project Filters" },
    { "type": "assert", "assert": "not_contains", "value": "Weekly Review" },
    { "type": "assert", "assert": "not_contains", "value": "Finder" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "the tail sections and the grammar sit at the bottom", "key": "G" },
    { "type": "assert", "assert": "contains", "value": "Select Project" },
    { "type": "assert", "assert": "contains", "value": "Toggle Theme" },
    { "type": "assert", "label": "the deferral sigil is taught here, not only in the composer", "assert": "contains", "value": "@@defer" },
    { "type": "assert", "assert": "contains", "value": "Clear deferral" },
    { "type": "assert", "label": "the search-only deferral presence split is visible, not hidden behind an alias", "assert": "contains", "value": "@@any @@none" },
    { "type": "assert", "label": "the due row shows its search-only forms, including the +Nh hour window", "assert": "contains", "value": "@+4h" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "filter help by a word no label spells", "key": "/" },
    { "type": "key", "key": "d" },
    { "type": "key", "key": "e" },
    { "type": "key", "key": "f" },
    { "type": "key", "key": "e" },
    { "type": "key", "key": "r" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "contains", "value": "Filter: \"defer\"" },
    { "type": "assert", "label": "the alias is what earned the row, so the row names it", "assert": "contains", "value": "Set Due, Defer, or Check-In · defer" },
    { "type": "assert", "assert": "contains", "value": "Filter by Due or Deferred · deferred" },
    { "type": "assert", "label": "the grammar row answers the same query", "assert": "contains", "value": "@@defer" },
    { "type": "assert", "assert": "not_contains", "value": "Toggle Pin" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "clear the filter", "key": "esc" },
    { "type": "assert", "assert": "contains", "value": "Toggle Pin" },

    { "type": "resize", "label": "every tab fits one row at 80 columns", "width": 80, "height": 24 },
    { "type": "assert", "assert": "contains", "value": " All Tasks Sorting Discovery Modes Navigation Projects Notes System Grammar " },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "resize", "label": "the same help at the minimum supported width", "width": 60, "height": 20 },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "assert", "assert": "view", "value": "Help" },

    { "type": "key", "label": "search with category counts at minimum size", "key": "/" },
    { "type": "text", "text": "defer" },
    { "type": "assert", "assert": "contains", "value": "All (" },
    { "type": "assert", "assert": "contains", "value": "Tasks (" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "enter" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "key", "key": "esc" },
    { "type": "assert", "assert": "not_contains", "value": "All (" },
    { "type": "assert", "assert": "no_layout_issues" },

    { "type": "key", "label": "close help", "key": "?" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" }
  ]
}
