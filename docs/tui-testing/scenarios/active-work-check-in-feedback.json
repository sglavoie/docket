{
  "name": "active-work-check-in-feedback",
  "fixture": "workflow",
  "size": "100x35",
  "actions": [
    { "type": "command", "label": "open Backlog, which launch folds, so the scenario reads the whole workspace", "command": "Clear All Folds" },
    { "type": "key", "key": "a" },
    { "type": "text", "text": "Offer capture $doing " },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "label": "capture into Doing without a schedule says so and opens nothing", "assert": "contains", "value": "Offer capture · No check-in · F10: Set up check-ins" },
    { "type": "assert", "label": "the route named is the keyless menu entry, never a key aimed at the cursor", "assert": "contains", "value": "F10: Set up check-ins" },
    { "type": "assert", "assert": "not_contains", "value": "Set Check-In" },
    { "type": "assert", "assert": "no_layout_issues" },
    { "type": "assert", "assert": "view", "value": "CrossProjectOutliner" },
    { "type": "assert", "assert": "contains", "value": "Offer capture" },

    { "type": "key", "label": "an inline edit that blocks the task commits quietly: the note is said once per session", "key": "e" },
    { "type": "key", "key": "ctrl+u" },
    { "type": "text", "text": "Offer capture $waiting " },
    { "type": "key", "key": "enter" },
    { "type": "wait" },
    { "type": "assert", "assert": "not_contains", "value": "No check-in" },
    { "type": "assert", "assert": "not_contains", "value": "Set Check-In" },

    { "type": "command", "label": "scheduling stays explicit and is the user's own act", "command": "Set Check-In" },
    { "type": "assert", "assert": "contains", "value": "Set Check-In" },
    { "type": "text", "text": "today" },
    { "type": "key", "key": "ctrl+s" },
    { "type": "wait" },
    { "type": "assert", "assert": "contains", "value": "review today" },
    { "type": "assert", "label": "a scheduled task is owed nothing, so the note is gone", "assert": "not_contains", "value": "No check-in" },

    { "type": "key", "label": "blocking it emptied the Doing lane, so the cursor swept into Backlog", "key": "home" },
    { "type": "key", "label": "back onto the captured task, now owed a review", "key": "j" },
    { "type": "key", "key": "w" },
    { "type": "key", "key": "g" },
    { "type": "wait" },
    { "type": "assert", "label": "already-scheduled work earns no offer, in either direction", "assert": "not_contains", "value": "No check-in" },
    { "type": "assert", "assert": "not_contains", "value": "Set Check-In" },
    { "type": "assert", "assert": "contains", "value": "review today" },

    { "type": "restart" },
    { "type": "assert", "label": "a reload is not a commit, so nothing is offered at launch", "assert": "not_contains", "value": "No check-in" },
    { "type": "assert", "assert": "not_contains", "value": "Set Check-In" },
    { "type": "assert", "assert": "contains", "value": "review today" },
    { "type": "assert", "assert": "no_layout_issues" }
  ]
}
