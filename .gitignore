.github/skills/
coverage.out
/coverage*.out
tt
.tasks.md.lock

# Editor and tooling state, kept out of a fresh clone rather than out of one
# machine's global ignore file.
.vscode/
.claude/
.codegraph/
.spec/
.venv/

# Workspace artifacts a test would write into its package directory; the
# tracked migration fixtures under testdata stay visible.
internal/**/.tt/
internal/**/projects/
internal/**/*.lock
!internal/**/testdata/**
coverage.html
/dist/

# macOS app: the vendored GhosttyKit is built by `just mac-ghosttykit`, and the
# Xcode project is generated from macos/project.yml.
macos/Vendor/
macos/.cache/
macos/build/
macos/DerivedData/
*.xcodeproj

# iOS app: the gomobile XCFramework and its fingerprint are built by
# ios/scripts/build-bridge.sh, the Xcode project is generated from
# ios/project.yml, and SwiftPM keeps its own state beside the package.
ios/.cache/
/ios-results/
ios/TTEngine/Frameworks/
ios/TTEngine/.build/
ios/TTEngine/.swiftpm/

# The Apple sync transport package (apple/TTSync) keeps SwiftPM state beside
# itself.
apple/TTSync/.build/
apple/TTSync/.swiftpm/
# The reminder scheduling package (ios/TTReminders) keeps SwiftPM state beside
# its sources.
ios/TTReminders/.build/
ios/TTReminders/.swiftpm/
# The App Group package (ios/TTShared) keeps SwiftPM state beside its sources.
ios/TTShared/.build/
ios/TTShared/.swiftpm/
