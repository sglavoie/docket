.github/skills/
coverage.out
/coverage*.out
/docket
.tasks.md.lock

# Editor and tooling state, kept out of a fresh clone rather than out of one
# machine's global ignore file.
.vscode/
.claude/
.codegraph/
.spec/
.venv/

# Workspace artifacts a test would write into its package directory; the
# tracked migration fixtures under testdata stay visible.
internal/**/.docket/
internal/**/.tt/
internal/**/projects/
internal/**/*.lock
!internal/**/testdata/**
coverage.html
/dist/
# Written by the GoReleaser before hook.
/completions/

# macOS app: the vendored GhosttyKit is built by `just mac-ghosttykit`, and the
# Xcode project is generated from macos/project.yml.
macos/Vendor/
macos/.cache/
macos/build/
macos/DerivedData/
*.xcodeproj

# iOS app: the gomobile XCFramework and its fingerprint are built by
# ios/scripts/build-bridge.sh, the Xcode project is generated from
# ios/project.yml, and SwiftPM keeps its own state beside the package.
ios/.cache/
/ios-results/
ios/DocketEngine/Frameworks/
ios/DocketEngine/.build/
ios/DocketEngine/.swiftpm/

# The Apple sync transport package (apple/DocketSync) keeps SwiftPM state beside
# itself.
apple/DocketSync/.build/
apple/DocketSync/.swiftpm/
# The reminder scheduling package (ios/DocketReminders) keeps SwiftPM state beside
# its sources.
ios/DocketReminders/.build/
ios/DocketReminders/.swiftpm/
# The App Group package (ios/DocketShared) keeps SwiftPM state beside its sources.
ios/DocketShared/.build/
ios/DocketShared/.swiftpm/
# xcodebuild run from ios/ or a package directory drops its products in build/.
ios/build/
ios/*/build/
apple/*/build/
